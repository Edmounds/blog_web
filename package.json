{
  "name": "new_blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:post-slugs": "node scripts/check-post-slugs.mjs",
    "check:content-ids": "node scripts/check-content-ids.mjs",
    "images:sync": "node --env-file-if-exists=.env scripts/sync-blog-images.mjs",
    "predev": "npm run images:sync",
    "dev": "astro dev",
    "translate": "node --env-file-if-exists=.env scripts/translate.mjs",
    "migrate:zh": "test ! -f src/i18n/.zh-migration-complete && node --env-file-if-exists=.env scripts/migrate-to-zh.mjs",
    "prebuild": "npm run images:sync && npm run translate",
    "build": "npm run check:encoding && npm run check:content-ids && astro build && npm run check:public-bundle",
    "check:public-bundle": "node scripts/check-public-bundle.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:comments:smoke": "node scripts/smoke-comments.mjs",
    "art:migrate": "node --env-file-if-exists=.env scripts/migrate-art-to-d1.mjs",
    "cf:secrets:sync": "node scripts/sync-cloudflare-secrets.mjs",
    "cf:dev": "npx wrangler dev --config dist/server/wrangler.json --persist-to $INIT_CWD/.wrangler/state",
    "deploy": "npm run build && wrangler deploy --config dist/server/wrangler.json",
    "db:migrate:local": "npx wrangler d1 execute DB --local --file=./schema/post_stats.sql && npx wrangler d1 execute DB --local --file=./schema/comments.sql && npx wrangler d1 execute DB --local --file=./schema/content_ids.sql && npx wrangler d1 execute DB --local --file=./schema/art.sql",
    "db:migrate:remote": "npx wrangler d1 execute blog_web --remote --file=./schema/post_stats.sql && npx wrangler d1 execute blog_web --remote --file=./schema/comments.sql && npx wrangler d1 execute blog_web --remote --file=./schema/content_ids.sql && npx wrangler d1 execute blog_web --remote --file=./schema/art.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "13.7.0",
    "@astrojs/mdx": "6.0.3",
    "@astrojs/react": "^5.0.4",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.2.0",
    "astro": "6.4.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.2",
    "js-yaml": "^5.2.1",
    "katex": "^0.16.47",
    "lucide-react": "^1.11.0",
    "lucide-static": "^0.562.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rehype-katex": "^7.0.1",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@cloudflare/workers-types": "^5.20260723.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.114.0"
  }
}
