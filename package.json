{
  "name": "new_blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:post-slugs": "node scripts/check-post-slugs.mjs",
    "images:sync": "node --env-file-if-exists=.env scripts/sync-blog-images.mjs",
    "predev": "npm run images:sync && node --env-file-if-exists=.env scripts/sync-art.mjs",
    "dev": "astro dev",
    "translate": "node --env-file-if-exists=.env scripts/translate.mjs",
    "migrate:zh": "test ! -f src/i18n/.zh-migration-complete && node --env-file-if-exists=.env scripts/migrate-to-zh.mjs",
    "prebuild": "npm run images:sync && node --env-file-if-exists=.env scripts/sync-art.mjs && npm run translate",
    "build": "npm run check:encoding && npm run check:post-slugs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "test:comments:smoke": "node scripts/smoke-comments.mjs",
    "cf:dev": "npx wrangler pages dev ./dist --d1 DB=38848e98-47d9-47b5-82b2-3a37acb84c7a",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=new-blog --branch=main",
    "db:migrate:local": "npx wrangler d1 execute DB --local --file=./schema/post_stats.sql && npx wrangler d1 execute DB --local --file=./schema/comments.sql",
    "db:migrate:remote": "npx wrangler d1 execute blog_web --remote --file=./schema/post_stats.sql && npx wrangler d1 execute blog_web --remote --file=./schema/comments.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/react": "^5.0.4",
    "@tailwindcss/vite": "^4.2.0",
    "astro": "^5.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gray-matter": "^4.0.3",
    "jose": "^6.2.2",
    "js-yaml": "^5.2.1",
    "lucide-react": "^1.11.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "shadcn": "^4.5.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@cloudflare/workers-types": "^4.20260527.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.59.2"
  }
}
