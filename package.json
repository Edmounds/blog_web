{
  "name": "new_blog",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "check:encoding": "node scripts/check-encoding.mjs",
    "check:post-slugs": "node scripts/check-post-slugs.mjs",
    "predev": "node --env-file-if-exists=.env scripts/sync-art.mjs",
    "dev": "astro dev",
    "prebuild": "node --env-file-if-exists=.env scripts/sync-art.mjs",
    "build": "npm run check:encoding && npm run check:post-slugs && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --test tests/*.test.mjs",
    "cf:dev": "npx wrangler pages dev ./dist",
    "deploy": "npm run build && wrangler pages deploy dist --project-name=new-blog --branch=main",
    "db:migrate:local": "npx wrangler d1 execute blog_web --local --file=./schema/post_stats.sql",
    "db:migrate:remote": "npx wrangler d1 execute blog_web --remote --file=./schema/post_stats.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.13",
    "@astrojs/react": "^5.0.4",
    "@tailwindcss/vite": "^4.2.0",
    "astro": "^5.17.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.11.0",
    "motion": "^12.38.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "shadcn": "^4.5.0",
    "stripe-gradient": "^1.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@cloudflare/workers-types": "^4.20260527.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "typescript": "^5.9.3",
    "wrangler": "^4.59.2"
  }
}
