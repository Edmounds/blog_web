# Local comments. Use a long, random value and never commit the real salt.
COMMENT_HASH_SALT=replace-with-a-long-random-secret

# Cloudflare Access application settings for /admin/comments/* and /api/admin/comments/*.
CF_ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-access-application-audience

# Translation service used during builds. Supported values: openai, deeplx.
SERVICE_TYPE=openai

# DeepLX settings, required when SERVICE_TYPE=deeplx.
DEEPLX_BASE_URL=https://your-deeplx-host.example/translate
DEEPLX_API_KEY=replace-with-your-deeplx-api-key

# OpenAI-compatible Chat Completions settings, required when SERVICE_TYPE=openai.
OPENAI_BASE_URL=https://your-openai-compatible-host.example/v1
API_KEY=replace-with-your-openai-api-key
MODEL=replace-with-your-model-name

# Optional. The translator sends this many requests at once (1-12, default 3).
TRANSLATION_CONCURRENCY=3

# If the selected service fails, the build automatically uses Google Translate.
