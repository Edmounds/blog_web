{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "new-blog",
  "compatibility_date": "2026-05-17",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog_web",
      "database_id": "38848e98-47d9-47b5-82b2-3a37acb84c7a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ART_COVERS",
      "bucket_name": "blog-images"
    }
  ],
  "services": [
    {
      "binding": "ART_COVER_FETCHER",
      "service": "blog-art-cover-fetcher"
    }
  ]
}
