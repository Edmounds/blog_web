{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "new-blog-ssr",
  "compatibility_date": "2026-05-17",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/worker.ts",
  "triggers": { "crons": ["0 20 * * *"] },
  "keep_vars": true,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.05,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 0.05
    }
  },
  "cache": {
    "enabled": true
  },
  "assets": {
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api/*",
      "/admin/*",
      "/art/*",
      "/en/art/*",
      "/ja/art/*",
      "/zh-TW/art/*",
      "/media/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "blog_web",
      "database_id": "38848e98-47d9-47b5-82b2-3a37acb84c7a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ART_COVERS",
      "bucket_name": "blog-images"
    }
  ],
  "services": [
    {
      "binding": "ART_COVER_FETCHER",
      "service": "blog-art-cover-fetcher"
    }
  ]
}
