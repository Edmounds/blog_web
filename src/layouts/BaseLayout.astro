---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";

import Footer from "../components/site/Footer.astro";
import Header from "../components/site/Header.astro";
import MarkdownEnhancements from "../components/domain/MarkdownEnhancements.astro";
import LoadingOverlay from "../components/site/LoadingOverlay.astro";
import RouteBackground from "../components/site/RouteBackground.astro";
import { getSiteSettings } from "../lib/content";
import {
  defaultLocale,
  getAlternatePaths,
  getLocaleDefinition,
  localizePath,
  type Locale,
} from "../lib/i18n";
import { getLocalizedSite } from "../lib/localized-content";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  mainClass?: string;
  showFooter?: boolean;
  locale?: Locale;
  imageUrl?: string;
  ogType?: "website" | "article";
  hasMath?: boolean;
}

const {
  title,
  description,
  currentPath = "/",
  mainClass = "",
  showFooter = true,
  locale = defaultLocale,
  imageUrl = "/images/content/about/profile-f5f8abc7eda1-social.webp",
  ogType = "website",
  hasMath = false,
} = Astro.props;
const localizedSite = await getLocalizedSite(locale);
const site =
  locale === defaultLocale
    ? { ...(await getSiteSettings()), ...localizedSite }
    : localizedSite;
const localeDefinition = getLocaleDefinition(locale);
const alternatePaths = getAlternatePaths(currentPath);
const resolvedTitle = title.trim();
const resolvedDescription = description ?? site.seo.defaultDescription;
const canonicalUrl = new URL(
  localizePath(currentPath, locale),
  "https://blog.muelsyse.us",
).toString();
const rssPath =
  locale === defaultLocale ? "/rss.xml" : `/${localeDefinition.path}/rss.xml`;
const socialImage = new URL(imageUrl, "https://blog.muelsyse.us").toString();
const buildId = import.meta.env.PUBLIC_BUILD_ID;
if (!Astro.response.headers.has("Cache-Control"))
  Astro.response.headers.set("Cache-Control", "no-cache");
---

<!doctype html>
<html
  lang={localeDefinition.htmlLang}
  dir={localeDefinition.dir}
  class="light"
  data-theme-mode="system"
  data-build-id={buildId}
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover"
    />
    <meta name="description" content={resolvedDescription} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light dark" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="icon"
      type="image/webp"
      href="/images/content/about/profile-f5f8abc7eda1-w160.webp?v=1"
    />
    <link
      rel="preload"
      href="/fonts/Biotif-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href="/images/site-signature.svg?v=1"
      as="image"
      type="image/svg+xml"
    />
    {hasMath && <link rel="stylesheet" href="/katex.min.css" />}
    <link rel="canonical" href={canonicalUrl} />
    {
      alternatePaths.map((alternate) => (
        <link
          rel="alternate"
          hreflang={alternate.htmlLang}
          href={new URL(alternate.href, "https://blog.muelsyse.us").toString()}
        />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(
        localizePath(currentPath, defaultLocale),
        "https://blog.muelsyse.us",
      ).toString()}
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="chasen RSS"
      href={new URL(rssPath, "https://blog.muelsyse.us").toString()}
    />
    <meta property="og:site_name" content="chasen" />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDescription} />
    <meta name="twitter:image" content={socialImage} />
    <title>{resolvedTitle}</title>
    <ClientRouter fallback="animate" />
    <slot name="head" />
    <script is:inline>
      (() => {
        const mode = localStorage.getItem("blog-theme");
        const prefersDark = matchMedia("(prefers-color-scheme: dark)").matches;
        const theme =
          mode === "dark" || mode === "light"
            ? mode
            : prefersDark
              ? "dark"
              : "light";
        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.classList.toggle("light", theme === "light");
        document.documentElement.dataset.theme = theme;
        document.documentElement.dataset.themeMode =
          mode === "dark" || mode === "light" ? mode : "system";
      })();
    </script>
    <script is:inline>
      (() => {
        // Gate the scroll-reveal hidden state on html.js-reveal so content is
        // fully visible without JS or with reduced motion. Re-applied on
        // astro:after-swap (pre-paint) because the router resets <html>
        // attributes during navigation.
        const applyRevealGate = () => {
          if (
            "IntersectionObserver" in window &&
            !matchMedia("(prefers-reduced-motion: reduce)").matches
          )
            document.documentElement.classList.add("js-reveal");
        };
        applyRevealGate();
        document.addEventListener("astro:after-swap", applyRevealGate);
      })();
    </script>
  </head>
  <body>
    <RouteBackground currentPath={currentPath} />
    <div class="relative z-10 flex min-h-screen flex-col">
      <Header
        currentPath={currentPath}
        locale={locale}
        languageLabel={site.copy.languageSelect}
      />
      <main transition:name="page-content" class={`flex-1 ${mainClass}`.trim()}>
        <slot />
      </main>
      {
        showFooter && (
          <Footer brand="Last4ev3r" copyright={site.copy.copyright} />
        )
      }
    </div>
    <MarkdownEnhancements locale={locale} />
    <LoadingOverlay />

    <script>
      const REVEAL_STAGGER_MS = 50;
      const REVEAL_MAX_DELAY_MS = 400;

      let revealObserver: IntersectionObserver | undefined;

      const onReveal: IntersectionObserverCallback = (entries) => {
        const groupCounts = new Map<Element | null, number>();
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          revealObserver?.unobserve(entry.target);
          const group = entry.target.closest("[data-reveal-group]");
          const index = groupCounts.get(group) ?? 0;
          groupCounts.set(group, index + 1);
          const delay = group
            ? Math.min(index * REVEAL_STAGGER_MS, REVEAL_MAX_DELAY_MS)
            : 0;
          if (delay > 0 && entry.target instanceof HTMLElement)
            entry.target.style.setProperty("--reveal-delay", `${delay}ms`);
          entry.target.classList.add("is-revealed");
        }
      };

      const scanReveals = () => {
        if (!document.documentElement.classList.contains("js-reveal")) return;
        revealObserver ??= new IntersectionObserver(onReveal, {
          threshold: 0.05,
          rootMargin: "0px 0px -32px 0px",
        });
        revealObserver.disconnect();
        document
          .querySelectorAll("[data-reveal]:not(.is-revealed)")
          .forEach((element) => revealObserver?.observe(element));
      };

      scanReveals();
      document.addEventListener("astro:page-load", scanReveals);
      window.addEventListener("spa:nav-sync", scanReveals);
    </script>

    <script>
      import { stripLocaleFromPath } from "../lib/i18n";

      const PRIMARY_ROUTES = [
        "/",
        "/blog/",
        "/project/",
        "/note/",
        "/links/",
        "/about/",
      ];
      const routeIndex = (path: string) =>
        PRIMARY_ROUTES.indexOf(stripLocaleFromPath(path).pathname);
      document.addEventListener("astro:before-preparation", (event) => {
        const from = routeIndex(event.from.pathname);
        const to = routeIndex(event.to.pathname);
        if (from >= 0 && to >= 0)
          // The router mirrors event.direction onto html[data-astro-transition],
          // which the page-content view-transition CSS consumes.
          event.direction = to < from ? "back" : "forward";
      });

      if (
        import.meta.env.PROD &&
        !window.location.pathname.startsWith("/admin/")
      ) {
        const DEPLOYMENT_CHECK_INTERVAL_MS = 60_000;
        const DEPLOYMENT_REFRESH_KEY = "blog-deployment-refresh";
        const browserWindow = window as typeof window & {
          __deploymentRefreshCleanup?: () => void;
        };
        const currentBuildId = document.documentElement.dataset.buildId;
        let checkInFlight = false;

        browserWindow.__deploymentRefreshCleanup?.();
        if (sessionStorage.getItem(DEPLOYMENT_REFRESH_KEY) === currentBuildId) {
          sessionStorage.removeItem(DEPLOYMENT_REFRESH_KEY);
        }

        const checkForDeployment = async () => {
          if (document.visibilityState !== "visible" || checkInFlight) return;
          checkInFlight = true;
          try {
            const response = await fetch(`/version.json?t=${Date.now()}`, {
              cache: "no-store",
            });
            const deployment = response.ok
              ? ((await response.json()) as { buildId?: string })
              : {};
            if (
              deployment.buildId &&
              deployment.buildId !== currentBuildId &&
              sessionStorage.getItem(DEPLOYMENT_REFRESH_KEY) !==
                deployment.buildId
            ) {
              sessionStorage.setItem(
                DEPLOYMENT_REFRESH_KEY,
                deployment.buildId,
              );
              window.location.reload();
            }
          } catch {
          } finally {
            checkInFlight = false;
          }
        };
        const onVisibilityChange = () => {
          if (document.visibilityState === "visible") void checkForDeployment();
        };
        const onFocus = () => void checkForDeployment();
        const intervalId = window.setInterval(
          () => void checkForDeployment(),
          DEPLOYMENT_CHECK_INTERVAL_MS,
        );

        document.addEventListener("visibilitychange", onVisibilityChange);
        window.addEventListener("focus", onFocus);
        browserWindow.__deploymentRefreshCleanup = () => {
          window.clearInterval(intervalId);
          document.removeEventListener("visibilitychange", onVisibilityChange);
          window.removeEventListener("focus", onFocus);
        };
        void checkForDeployment();
      }
    </script>
  </body>
</html>
