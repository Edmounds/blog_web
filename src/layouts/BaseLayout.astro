---
import "../styles/global.css";
import Footer from "../components/site/Footer.astro";
import Header from "../components/site/Header.astro";
import { getSiteSettings } from "../lib/content";

interface Props {
  title: string;
  description?: string;
  currentPath?: string;
  mainClass?: string;
  showFooter?: boolean;
}

const { title, description, currentPath = "/", mainClass = "", showFooter = true } = Astro.props;
const site = await getSiteSettings();
const normalizedTitle = title.trim();
const hasBrand = normalizedTitle.toLowerCase().includes(site.brand.toLowerCase());
const resolvedTitle = normalizedTitle
  ? hasBrand
    ? normalizedTitle
    : `${normalizedTitle}${site.seo.titleSeparator}${site.brand}`
  : site.brand;
const resolvedDescription = description ?? site.seo.defaultDescription;
---

<!doctype html>
<html lang={site.htmlLang} class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={resolvedDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="stylesheet" href="/anthropic-fonts.css" />
    <meta name="generator" content={Astro.generator} />
    <title>{resolvedTitle}</title>
    <script is:inline>
      (() => {
        const key = "blog-theme";
        const stored = localStorage.getItem(key);
        const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
        const theme = stored === "dark" || stored === "light" ? stored : prefersDark ? "dark" : "light";
        document.documentElement.classList.toggle("dark", theme === "dark");
        document.documentElement.classList.toggle("light", theme === "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="site-grain min-h-screen antialiased selection:bg-[var(--accent-soft)]">
    <div class="relative z-10 flex min-h-screen flex-col">
      <Header currentPath={currentPath} brand={site.brand} navItems={site.nav} />
      <main class={`flex-1 ${mainClass}`.trim()}>
        <slot />
      </main>
      {showFooter && <Footer brand={site.brand} links={site.footerLinks} />}
    </div>
  </body>
</html>
