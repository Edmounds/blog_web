---
import BaseLayout from "./BaseLayout.astro";
import HomeSection from "../components/sections/HomeSection.astro";
import BlogsSection from "../components/sections/BlogsSection.astro";
import ProjectsSection from "../components/sections/ProjectsSection.astro";
import AboutSection from "../components/sections/AboutSection.astro";

interface Props {
  initialPath?: string;
  title: string;
  description: string;
}

const { initialPath = "/", title, description } = Astro.props;

// Determine initial index
let initialIndex = 0;
if (initialPath.startsWith("/blogs")) initialIndex = 1;
else if (initialPath.startsWith("/projects")) initialIndex = 2;
else if (initialPath.startsWith("/about")) initialIndex = 3;
---

<BaseLayout title={title} description={description} currentPath={initialPath}>
  <div class="spa-root" data-spa-root data-active-index={initialIndex}>
    <div class="spa-viewport relative w-full">
      {/* Horizontal track */}
      <div class="spa-track flex w-[400vw]" data-track style={`transform: translate3d(-${initialIndex * 25}%, 0, 0);`}>
        
        <section class="w-[100vw]" data-slide-index="0" data-path="/">
          <HomeSection />
        </section>

        <section class="w-[100vw]" data-slide-index="1" data-path="/blogs/">
          <BlogsSection />
        </section>

        <section class="w-[100vw]" data-slide-index="2" data-path="/projects/">
          <ProjectsSection />
        </section>

        <section class="w-[100vw]" data-slide-index="3" data-path="/about/">
          <AboutSection />
        </section>

      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .spa-root {
    width: 100%;
    position: relative;
    isolation: isolate;
  }

  .spa-viewport {
    position: relative;
    width: 100%;
    overflow-x: hidden;
    overflow-y: visible;
    background: var(--bg-base);
  }

  .spa-track {
    display: flex;
    width: 400vw;
    will-change: transform;
    /* Match showcase timing for silky smooth slide */
    transition: transform 0.8s cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* When slides are not active, they can be styled differently or hidden from screen readers */
  .spa-track > section {
    flex: 0 0 100vw;
    width: 100vw;
    position: relative;
    transition: opacity 0.8s cubic-bezier(0.65, 0, 0.35, 1);
  }

  /* When NOT transitioning, collapse inactive slides so they don't add to page height/scroll */
  .spa-root:not([data-transitioning="true"]) .spa-track > section:not([data-active="true"]) {
    height: 0;
    overflow: hidden;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
  }

  /* When transitioning, keep inactive slides at normal height but visually fade out/in if desired */
  .spa-root[data-transitioning="true"] .spa-track > section:not([data-active="true"]) {
    pointer-events: none;
    opacity: 0.5;
  }
</style>

<script>
  function initSpa() {
    const root = document.querySelector<HTMLElement>('[data-spa-root]');
    if (!root) return;
    
    const track = root.querySelector<HTMLElement>('[data-track]');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide-index]'));
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('a[data-page-transition-link], a[data-nav-link]');

    if (!track) return;

    let activeIndex = parseInt(root.getAttribute('data-active-index') || '0', 10);

    // Initialize state
    root.setAttribute('data-transitioning', 'false');

    // Handle transition end to toggle height collapse on inactive slides
    track.addEventListener('transitionend', (e) => {
      if (e.target === track && e.propertyName === 'transform') {
        root.setAttribute('data-transitioning', 'false');
      }
    });

    // Helper to get index from path
    function getIndexFromPath(path: string) {
      const normalized = path.replace(/\/$/, '') || '/';
      if (normalized === '/') return 0;
      if (normalized.startsWith('/blogs')) return 1;
      if (normalized.startsWith('/projects')) return 2;
      if (normalized.startsWith('/about')) return 3;
      return -1;
    }

    function setActive(targetIndex: number, newPath: string, pushState = true) {
      if (!root) return;

      root.setAttribute('data-transitioning', 'true');

      const direction =
          targetIndex === activeIndex ? "none"
            : targetIndex > activeIndex ? "forward"
            : "backward";

      // 1. Update State
      if (pushState) {
        window.history.pushState({}, '', newPath);
      }

      // 2. Slide the track smoothly
      if (track) {
        track.style.transform = `translate3d(${-targetIndex * 100}vw, 0, 0)`;
      }

      // 3. Reset scroll position to top instantly for clean page transition
      window.scrollTo({ top: 0, behavior: 'instant' });

      // 4. Mark active slide
      slides.forEach((slide, i) => {
        const isActive = i === targetIndex;
        slide.dataset.active = isActive ? "true" : "false";
        slide.setAttribute("aria-hidden", isActive ? "false" : "true");
      });

      // 5. Update Nav links (ARIA and Classes)
      navLinks.forEach(link => {
        const url = new URL(link.href);
        const isTarget = getIndexFromPath(url.pathname) === targetIndex;
        
        if (isTarget) {
          link.setAttribute('aria-current', 'page');
          // Update colors based on NavSwitcher classes
          link.classList.remove('text-[var(--text-muted)]', 'hover:text-[var(--text-main)]');
          link.classList.add('text-[var(--text-main)]');
        } else {
          link.removeAttribute('aria-current');
          link.classList.remove('text-[var(--text-main)]');
          link.classList.add('text-[var(--text-muted)]', 'hover:text-[var(--text-main)]');
        }
      });

      // Dispatch event to trigger NavMotionController update
      window.dispatchEvent(new Event('spa:nav-sync'));

      activeIndex = targetIndex;
      root.setAttribute('data-active-index', String(targetIndex));
    }

    // Hijack header links
    navLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const url = new URL(link.href);
        if (url.origin !== window.location.origin) return;

        const targetIndex = getIndexFromPath(url.pathname);
        if (targetIndex !== -1) {
          e.preventDefault();
          if (targetIndex !== activeIndex) {
            setActive(targetIndex, url.pathname);
          }
        }
      });
    });

    // Handle browser back/forward within SPA
    window.addEventListener('popstate', () => {
      const targetIndex = getIndexFromPath(window.location.pathname);
      if (targetIndex !== -1 && targetIndex !== activeIndex) {
        setActive(targetIndex, window.location.pathname, false);
      }
    });

    // Init active slide accessibility
    slides.forEach((slide, i) => {
      const isActive = i === activeIndex;
      slide.dataset.active = isActive ? "true" : "false";
      slide.setAttribute("aria-hidden", isActive ? "false" : "true");
    });
  }

  // Use astro:page-load to ensure it works nicely with ClientRouter
  document.addEventListener('astro:page-load', initSpa);
</script>
