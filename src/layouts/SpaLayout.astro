---
import BaseLayout from "./BaseLayout.astro";
import HomeSection from "../components/sections/HomeSection.astro";
import type { Locale } from "../lib/i18n";
import { localizePath, stripLocaleFromPath } from "../lib/i18n";

interface Props {
  initialPath?: string;
  title: string;
  description: string;
  locale?: Locale;
}

const { initialPath = "/", title, description, locale = "zh-CN" } = Astro.props;
const routes = ["/", "/about/", "/blog/", "/note/", "/project/"];
const routePath = stripLocaleFromPath(initialPath).pathname;
const initialIndex = Math.max(0, routes.indexOf(routePath));
const sectionLabels = ["Home", "About", "Blog", "Note", "Project"];
const sections = [null, null, null, null, null] as Array<typeof HomeSection | null>;
if (initialIndex === 1) sections[1] = (await import("../components/sections/AboutSection.astro")).default;
if (initialIndex === 2) sections[2] = (await import("../components/sections/BlogsSection.astro")).default;
if (initialIndex === 3) sections[3] = (await import("../components/sections/NotesSection.astro")).default;
if (initialIndex === 4) sections[4] = (await import("../components/sections/ProjectsSection.astro")).default;
---

<BaseLayout
  title={title}
  description={description}
  currentPath={initialPath}
  locale={locale}
  showFooter={false}
>
  <div class="spa-root" data-spa-root data-active-index={initialIndex}>
    <div class="spa-viewport">
      <div
        class="spa-track"
        data-track
        style={`transform: translate3d(-${initialIndex * 100}vw, 0, 0);`}
      >
        <section data-slide-index="0" data-path="/">
          <HomeSection locale={locale} />
        </section>
        {routes.slice(1).map((path, offset) => {
          const index = offset + 1;
          const Section = sections[index];
          return (
          <section
            data-slide-index={index}
            data-path={path}
            data-section-url={localizePath(path, locale)}
            data-load-state={Section ? "loaded" : "idle"}
          >
            {Section ? <Section locale={locale} /> : (
              <div class="spa-section-loading" role="status">
                <span aria-hidden="true"></span>
                <span class="sr-only">正在加载 {sectionLabels[index]}</span>
              </div>
            )}
          </section>
          );
        })}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .spa-root {
    position: relative;
    width: 100%;
    isolation: isolate;
  }
  .spa-viewport {
    width: 100%;
    overflow-x: clip;
  }
  .spa-track {
    display: flex;
    width: 500vw;
    will-change: transform;
    transition: transform 680ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  .spa-track > section {
    position: relative;
    flex: 0 0 100vw;
    width: 100vw;
    transition: opacity 240ms ease;
  }
  .spa-section-loading {
    display: grid;
    min-height: calc(100vh - 4.5rem);
    place-items: center;
  }
  .spa-section-loading > span:first-child {
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid color-mix(in srgb, var(--foreground) 22%, transparent);
    border-top-color: var(--foreground);
    border-radius: 50%;
    animation: spa-section-spin 800ms linear infinite;
  }
  .spa-section-error {
    display: grid;
    min-height: calc(100vh - 4.5rem);
    place-items: center;
    padding: 2rem;
    color: var(--text-muted);
    text-align: center;
  }
  @keyframes spa-section-spin {
    to { transform: rotate(360deg); }
  }
  .spa-root:not([data-transitioning="true"])
    .spa-track
    > section:not([data-active="true"]) {
    height: 0;
    overflow: hidden;
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .spa-track,
    .spa-track > section {
      transition: none;
    }
    .spa-section-loading > span:first-child {
      animation: none;
    }
  }
</style>

<script
  is:inline
  define:vars={{
    localizedRoutes: routes.map((route) => localizePath(route, locale)),
  }}
>
  const PRIMARY_ROUTES = ["/", "/about/", "/blog/", "/note/", "/project/"];

  function initSpa() {
    const browserWindow = window;
    browserWindow.__spaCleanup?.();
    const root = document.querySelector("[data-spa-root]");
    if (!(root instanceof HTMLElement)) return;
    const track = root.querySelector("[data-track]");
    const slides = Array.from(root.querySelectorAll("[data-slide-index]"));
    if (!(track instanceof HTMLElement)) return;

    const controller = new AbortController();
    const { signal } = controller;
    let activeIndex = Number(root.dataset.activeIndex ?? 0);
    let pointerStartX = 0;
    let pointerStartY = 0;
    let wheelDelta = 0;
    let wheelTimer;
    let wheelLocked = false;
    let idleHandle;
    let backgroundTimer;
    let backgroundQueue = [];

    const copySectionContent = (slide, sourceDocument) => {
      const source = sourceDocument.querySelector(
        `[data-spa-root] [data-slide-index="${slide.dataset.slideIndex}"]`,
      );
      if (!(source instanceof HTMLElement))
        throw new Error(`Missing SPA section ${slide.dataset.slideIndex}`);
      slide.replaceChildren(...Array.from(source.childNodes).map((node) => node.cloneNode(true)));
      slide.querySelectorAll("script").forEach((script) => {
        const executable = document.createElement("script");
        for (const attribute of script.attributes)
          executable.setAttribute(attribute.name, attribute.value);
        executable.textContent = script.textContent;
        script.replaceWith(executable);
      });
      slide.dataset.loadState = "loaded";
    };
    const loadSlide = async (index) => {
      const slide = slides[index];
      if (!(slide instanceof HTMLElement) || index === 0) return;
      if (slide.dataset.loadState === "loaded") return;
      if (slide.__loadPromise) return slide.__loadPromise;
      slide.dataset.loadState = "loading";
      const url = slide.dataset.sectionUrl;
      if (!url) return;
      slide.__loadPromise = fetch(url, {
        headers: { "X-Spa-Fragment": "1" },
      })
        .then((response) => {
          if (!response.ok) throw new Error(`Section request failed: ${response.status}`);
          return response.text();
        })
        .then((html) => {
          copySectionContent(slide, new DOMParser().parseFromString(html, "text/html"));
        })
        .catch((error) => {
          slide.dataset.loadState = "error";
          slide.innerHTML = '<div class="spa-section-error" role="alert">页面加载失败，请刷新后重试。</div>';
          throw error;
        });
      return slide.__loadPromise;
    };
    const runWhenIdle = (callback, timeout) => {
      if ("requestIdleCallback" in window)
        idleHandle = window.requestIdleCallback(callback, { timeout });
      else idleHandle = window.setTimeout(callback, Math.min(timeout, 240));
    };
    const neighborIndexes = (index) => [index - 1, index + 1]
      .filter((candidate) => candidate > 0 && candidate < slides.length);
    const distanceIndexes = (index) => slides
      .map((_, candidate) => candidate)
      .filter((candidate) => candidate > 0 && candidate !== index)
      .sort((left, right) => Math.abs(left - index) - Math.abs(right - index));
    const scheduleAdjacentSlides = () => {
      runWhenIdle(() => {
        for (const index of neighborIndexes(activeIndex)) void loadSlide(index).catch(() => {});
      }, 800);
    };
    const scheduleRemainingSlides = () => {
      backgroundQueue = distanceIndexes(activeIndex).filter((index) => !neighborIndexes(activeIndex).includes(index));
      const loadNext = () => {
        if (document.visibilityState !== "visible") return;
        while (backgroundQueue.length > 0) {
          const index = backgroundQueue.shift();
          const slide = slides[index];
          if (slide instanceof HTMLElement && slide.dataset.loadState !== "loaded") {
            void loadSlide(index).catch(() => {});
            break;
          }
        }
        if (backgroundQueue.length > 0) runWhenIdle(loadNext, 1800);
      };
      backgroundTimer = window.setTimeout(() => runWhenIdle(loadNext, 1800), 3_000);
    };

    const stripLocale = (pathname) => {
      const parts = pathname.split("/").filter(Boolean);
      if (["en", "ja", "zh-TW"].includes(parts[0])) parts.shift();
      const path = `/${parts.join("/")}/`.replace("//", "/");
      return path === "//" ? "/" : path;
    };
    const indexForPath = (pathname) =>
      PRIMARY_ROUTES.indexOf(stripLocale(pathname));
    const syncDocument = (index) => {
      const label =
        index === 0
          ? "cqcの网站"
          : `${PRIMARY_ROUTES[index].split("/")[1][0].toUpperCase()}${PRIMARY_ROUTES[index].split("/")[1].slice(1)}`;
      document.title = label;
      document.querySelectorAll("a[data-primary-route]").forEach((link) => {
        if (!(link instanceof HTMLAnchorElement)) return;
        const active = indexForPath(new URL(link.href).pathname) === index;
        if (active && index !== 0) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });
      window.dispatchEvent(new Event("spa:nav-sync"));
    };
    const setActive = async (index, path, push = true) => {
      if (index < 0 || index >= slides.length) return;
      if (index > 0) {
        try {
          await loadSlide(index);
        } catch {
          return;
        }
      }
      root.dataset.transitioning = "true";
      root.dataset.activeIndex = String(index);
      track.style.transform = `translate3d(${-index * 100}vw, 0, 0)`;
      slides.forEach((slide, slideIndex) => {
        const active = slideIndex === index;
        slide.dataset.active = String(active);
        slide.setAttribute("aria-hidden", String(!active));
      });
      if (push && window.location.pathname !== path)
        history.pushState({}, "", path);
      activeIndex = index;
      window.scrollTo({ top: 0, behavior: "instant" });
      syncDocument(index);
      const reducedMotion = matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;
      if (reducedMotion) root.dataset.transitioning = "false";
      else
        window.setTimeout(() => {
          root.dataset.transitioning = "false";
        }, 760);
    };

    track.addEventListener("transitionend", (event) => {
      if (event.target === track && event.propertyName === "transform")
        root.dataset.transitioning = "false";
    }, { signal });
    document.querySelectorAll("a[data-primary-route]").forEach((link) => {
      const preloadFromLink = () => {
        if (!(link instanceof HTMLAnchorElement)) return;
        const index = indexForPath(new URL(link.href).pathname);
        if (index > 0) void loadSlide(index).catch(() => {});
      };
      link.addEventListener("pointerenter", preloadFromLink, { signal });
      link.addEventListener("focusin", preloadFromLink, { signal });
      link.addEventListener("touchstart", preloadFromLink, { passive: true, signal });
      link.addEventListener("click", (event) => {
        if (!(link instanceof HTMLAnchorElement)) return;
        const url = new URL(link.href);
        const index = indexForPath(url.pathname);
        if (url.origin !== location.origin || index < 0) return;
        event.preventDefault();
        void setActive(index, url.pathname);
      }, { signal });
    });
    window.addEventListener("popstate", () => {
      void setActive(indexForPath(location.pathname), location.pathname, false);
    }, { signal });
    root.addEventListener("pointerdown", (event) => {
      pointerStartX = event.clientX;
      pointerStartY = event.clientY;
    }, { signal });
    root.addEventListener("pointerup", (event) => {
      const dx = event.clientX - pointerStartX;
      const dy = event.clientY - pointerStartY;
      if (Math.abs(dx) < 60 || Math.abs(dx) < Math.abs(dy) * 1.2) return;
      const next = Math.min(
        slides.length - 1,
        Math.max(0, activeIndex + (dx < 0 ? 1 : -1)),
      );
      if (next !== activeIndex) void setActive(next, localizedRoutes[next]);
    }, { signal });
    root.addEventListener(
      "wheel",
      (event) => {
        if (Math.abs(event.deltaX) <= Math.abs(event.deltaY) || wheelLocked)
          return;
        wheelDelta += event.deltaX;
        clearTimeout(wheelTimer);
        wheelTimer = setTimeout(() => {
          if (Math.abs(wheelDelta) > 80) {
            const next = Math.min(
              slides.length - 1,
              Math.max(0, activeIndex + (wheelDelta > 0 ? 1 : -1)),
            );
            if (next !== activeIndex) {
              wheelLocked = true;
              void setActive(next, localizedRoutes[next]);
              window.setTimeout(() => {
                wheelLocked = false;
              }, 700);
            }
          }
          wheelDelta = 0;
        }, 90);
      },
      { passive: true, signal },
    );
    document.addEventListener("visibilitychange", () => {
      if (document.visibilityState === "visible" && backgroundQueue.length > 0) {
        clearTimeout(backgroundTimer);
        scheduleRemainingSlides();
      }
    }, { signal });

    browserWindow.__spaCleanup = () => {
      controller.abort();
      clearTimeout(wheelTimer);
      clearTimeout(backgroundTimer);
      if ("cancelIdleCallback" in window && idleHandle)
        window.cancelIdleCallback(idleHandle);
      else if (idleHandle) window.clearTimeout(idleHandle);
    };
    document.addEventListener("astro:before-swap", browserWindow.__spaCleanup, {
      once: true,
      signal,
    });

    const activateInitial = async () => {
      await setActive(activeIndex, location.pathname, false);
      scheduleAdjacentSlides();
      scheduleRemainingSlides();
    };
    void activateInitial();
  }

  initSpa();
  document.addEventListener("astro:page-load", initSpa);
</script>
