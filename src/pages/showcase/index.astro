---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAboutProfile, getHomeBlogPosts, getHomeProjects, getSiteSettings } from "../../lib/content";
import { routes } from "../../lib/routes";

const site = await getSiteSettings();
const homeBlogPosts = (await getHomeBlogPosts()).slice(0, 5);
const homeProjects = (await getHomeProjects()).slice(0, 4);
const { homeFeatured } = await getAboutProfile();

const sections = [
  { id: "intro",    index: "00", label: "INDEX" },
  { id: "writing",  index: "01", label: "WRITING" },
  { id: "making",   index: "02", label: "MAKING" },
  { id: "about",    index: "03", label: "ABOUT" },
  { id: "more",     index: "04", label: "MORE" },
] as const;
---

<BaseLayout title="Showcase" description={`Single-page showcase of ${site.brand}.`} showFooter={false}>
  <div class="showcase-root bg-background text-foreground" data-showcase-root data-active-index="0">

    {/* --- 左侧序号导航 --- */}
    <nav class="showcase-nav" aria-label="Sections">
      <ul>
        {sections.map((s, i) => (
          <li>
            <a
              href={`#${s.id}`}
              class="showcase-nav-link"
              data-nav={s.id}
              data-nav-index={i}
            >
              <span class="showcase-nav-index">{s.index}</span>
              <span class="showcase-nav-label">{s.label}</span>
              <span class="showcase-nav-bar" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    {/* --- 右下角 progress --- */}
    <div class="showcase-progress" aria-hidden="true">
      <span class="showcase-progress-current" data-progress-current>00</span>
      <span class="showcase-progress-divider">/</span>
      <span class="showcase-progress-total">{String(sections.length - 1).padStart(2, "0")}</span>
    </div>

    {/* --- 横向 viewport(裁切超出部分) --- */}
    <div class="showcase-viewport">

      {/* --- 方向性扫描线 —— 由 JS 在切换时驱动 --- */}
      <div class="showcase-scan" data-scan aria-hidden="true"></div>

      {/* --- 横向轨道:5 个 section 一字排开 --- */}
      <div class="showcase-track" data-track>

        {/* --- 00 INDEX --- */}
        <section class="showcase-slide" data-section="intro" data-slide-index="0">
          <div class="showcase-slide-inner showcase-intro">
            <p class="showcase-eyebrow" data-anim="eyebrow">{homeFeatured.badge}</p>
            <h1 class="showcase-title" data-anim="title">{homeFeatured.title}</h1>
            <p class="showcase-subtitle" data-anim="subtitle">{homeFeatured.name}</p>
            <p class="showcase-body" data-anim="body">{homeFeatured.description}</p>
            <a class="showcase-cta" data-anim="cta" href={routes.about}>
              <span>Open full profile</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </section>

        {/* --- 01 WRITING --- */}
        <section class="showcase-slide" data-section="writing" data-slide-index="1">
          <div class="showcase-slide-inner showcase-writing">
            <p class="showcase-eyebrow" data-anim="eyebrow">01 — WRITING</p>
            <h2 class="showcase-pane-title" data-anim="title">{site.copy.homeRecentBlogsTitle}</h2>
            <ul class="showcase-post-list" data-anim="body">
              {homeBlogPosts.map((post, i) => (
                <li class="showcase-post-item" style={`--row-index: ${i}`}>
                  <a href={`${routes.blogs}${post.slug}/`} class="showcase-post-link">
                    <span class="showcase-post-num">{String(i + 1).padStart(2, "0")}</span>
                    <span class="showcase-post-body">
                      <span class="showcase-post-cat">{post.category}</span>
                      <span class="showcase-post-title">{post.title}</span>
                      <span class="showcase-post-meta">
                        <span>{post.dateLabel}</span>
                        <span>·</span>
                        <span>{post.readingTime}</span>
                      </span>
                    </span>
                    <span class="showcase-post-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>

        {/* --- 02 MAKING --- */}
        <section class="showcase-slide" data-section="making" data-slide-index="2">
          <div class="showcase-slide-inner showcase-making">
            <p class="showcase-eyebrow" data-anim="eyebrow">02 — MAKING</p>
            <h2 class="showcase-pane-title" data-anim="title">{site.copy.homeRecentProjectsTitle}</h2>
            <div class="showcase-project-grid" data-anim="body">
              {homeProjects.map((project, i) => (
                <a
                  href={project.href ?? `${routes.projects}${project.slug}/`}
                  class="showcase-project-card"
                  style={`--row-index: ${i}`}
                >
                  <span class="showcase-project-type">{project.type}</span>
                  <span class="showcase-project-title">{project.title}</span>
                  <span class="showcase-project-summary">{project.summary}</span>
                  <span class="showcase-project-cta">{project.cta} →</span>
                </a>
              ))}
            </div>
          </div>
        </section>

        {/* --- 03 ABOUT --- */}
        <section class="showcase-slide" data-section="about" data-slide-index="3">
          <div class="showcase-slide-inner showcase-about">
            <div class="showcase-about-grid">
              <div class="showcase-about-left">
                <p class="showcase-eyebrow" data-anim="eyebrow">03 — ABOUT</p>
                <h2 class="showcase-pane-title" data-anim="title">{homeFeatured.name}</h2>
              </div>
              <div class="showcase-about-right" data-anim="body">
                <p>{homeFeatured.description}</p>
                <p class="showcase-about-location">{homeFeatured.location}</p>
                <a href={routes.about} class="showcase-cta">
                  <span>Read full bio</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          </div>
        </section>

        {/* --- 04 MORE --- */}
        <section class="showcase-slide" data-section="more" data-slide-index="4">
          <div class="showcase-slide-inner showcase-more">
            <p class="showcase-eyebrow" data-anim="eyebrow">04 — MORE</p>
            <h2 class="showcase-pane-title" data-anim="title">Wherever you go next.</h2>
            <ul class="showcase-more-list" data-anim="body">
              <li style="--row-index: 0"><a href={routes.blogs}>All writing →</a></li>
              <li style="--row-index: 1"><a href={routes.projects}>All projects →</a></li>
              <li style="--row-index: 2"><a href={routes.about}>About the author →</a></li>
              <li style="--row-index: 3"><a href={routes.series}>Series →</a></li>
            </ul>
          </div>
        </section>

      </div>
    </div>
  </div>

  <script>
    const root = document.querySelector<HTMLElement>("[data-showcase-root]");
    if (root) {
      const track = root.querySelector<HTMLElement>("[data-track]");
      const scan  = root.querySelector<HTMLElement>("[data-scan]");
      const slides = Array.from(root.querySelectorAll<HTMLElement>("[data-section]"));
      const navLinks = Array.from(root.querySelectorAll<HTMLElement>("[data-nav]"));
      const progressEl = root.querySelector<HTMLElement>("[data-progress-current]");

      const sectionIds = slides.map((s) => s.dataset.section || "");
      const defaultId  = sectionIds[0] || "intro";
      let currentIndex = 0;
      let scanResetTimer: number | null = null;

      const indexOfId = (id: string) => {
        const i = sectionIds.indexOf(id);
        return i === -1 ? 0 : i;
      };

      const setActive = (targetId: string): void => {
        const targetIndex = indexOfId(sectionIds.includes(targetId) ? targetId : defaultId);
        const direction =
          targetIndex === currentIndex ? "none"
            : targetIndex > currentIndex ? "forward"
            : "backward";

        // 1. 让轨道平移
        if (track) {
          track.style.transform = `translate3d(${-targetIndex * 100}%, 0, 0)`;
        }

        // 2. 标记 active slide(让内部内容启动 stagger 入场)
        slides.forEach((slide, i) => {
          const isActive = i === targetIndex;
          slide.dataset.active = isActive ? "true" : "false";
          slide.setAttribute("aria-hidden", isActive ? "false" : "true");
        });

        // 3. 同步导航高亮 + progress
        navLinks.forEach((link) => {
          const isActive = link.dataset.nav === sectionIds[targetIndex];
          link.setAttribute("aria-current", isActive ? "page" : "false");
        });
        if (progressEl) progressEl.textContent = String(targetIndex).padStart(2, "0");

        // 4. 触发扫描线
        if (scan && direction !== "none") {
          // 强制 reflow,确保上一次的动画状态被清除
          scan.dataset.scanning = "none";
          void scan.offsetWidth;
          scan.dataset.scanning = direction;

          if (scanResetTimer !== null) window.clearTimeout(scanResetTimer);
          scanResetTimer = window.setTimeout(() => {
            if (scan) scan.dataset.scanning = "none";
          }, 2000);
        }

        currentIndex = targetIndex;
        root.dataset.activeIndex = String(targetIndex);
      };

      const sync = (): void => {
        const id = (window.location.hash || `#${defaultId}`).slice(1);
        setActive(id);
      };

      // 首次同步放到下一帧,保证浏览器先画出"未激活"的初始状态。
      requestAnimationFrame(sync);

      window.addEventListener("hashchange", sync);

      // SPA 离开时清理监听器(BaseLayout 用了 ClientRouter,window 一直活着)
      const cleanup = (event: Event) => {
        const navEvent = event as CustomEvent<{ to: URL }>;
        if (navEvent.detail?.to?.pathname.startsWith("/showcase")) return;
        window.removeEventListener("hashchange", sync);
        document.removeEventListener("astro:before-preparation", cleanup);
      };
      document.addEventListener("astro:before-preparation", cleanup);
    }
  </script>

  <style is:global>
    /* =========================================================
       结构层:
       - showcase-root   外壳,沿用主题色
       - showcase-viewport  裁切窗(只有它有 overflow:hidden)
       - showcase-track   横向轨道,5 个 slide 一字排开,translateX 切换
       - showcase-slide   单个 section,宽 100%(等于 viewport 宽)
       ========================================================= */

    .showcase-root {
      position: relative;
      width: 100%;
      height: calc(100vh - 4rem);
      min-height: 36rem;
      isolation: isolate;
    }

    .showcase-viewport {
      position: absolute;
      inset: 0;
      overflow: hidden;
      z-index: 1;
    }

    .showcase-track {
      display: flex;
      width: 100%;
      height: 100%;
      will-change: transform;
      transform: translate3d(0, 0, 0);
      /* 慢一点、稳一点,用 ease-in-out 类曲线让滑动更"稳"而非"弹" */
      transition: transform 1.6s cubic-bezier(0.65, 0, 0.35, 1);
    }

    .showcase-slide {
      flex: 0 0 100%;
      width: 100%;
      height: 100%;
      position: relative;
      overflow: hidden;
    }

    .showcase-slide-inner {
      position: relative;
      width: 100%;
      height: 100%;
      padding: clamp(2rem, 5vw, 5rem) clamp(2rem, 7vw, 8rem) clamp(2rem, 5vw, 5rem) clamp(6rem, 12vw, 14rem);
      display: flex;
      flex-direction: column;
      justify-content: center;
      max-width: 90rem;
    }

    /* =========================================================
       内部内容入场:slide 变 active 时,子元素错落出现。
       关键:duration 都 >= 1.2s,delay 阶梯 0.15s,让你"看得见"。
       Leave 时(active 移除)瞬间归位,不抢戏。
       ========================================================= */

    [data-anim] {
      transition: opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: 0s; /* leave 无延迟 */
    }

    [data-anim="eyebrow"] {
      opacity: 0;
      transform: translateY(-1.25rem);
    }
    [data-anim="title"] {
      opacity: 0;
      transform: translateY(2.5rem);
    }
    [data-anim="subtitle"] {
      opacity: 0;
      transform: translateY(2rem);
    }
    [data-anim="body"] {
      opacity: 0;
      transform: translateY(1.5rem);
    }
    [data-anim="cta"] {
      opacity: 0;
      transform: translateX(2rem);
    }

    .showcase-slide[data-active="true"] [data-anim="eyebrow"] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.6s;
    }
    .showcase-slide[data-active="true"] [data-anim="title"] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 0.85s;
    }
    .showcase-slide[data-active="true"] [data-anim="subtitle"] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 1.1s;
    }
    .showcase-slide[data-active="true"] [data-anim="body"] {
      opacity: 1;
      transform: translateY(0);
      transition-delay: 1.35s;
    }
    .showcase-slide[data-active="true"] [data-anim="cta"] {
      opacity: 1;
      transform: translateX(0);
      transition-delay: 1.6s;
    }

    /* 列表内项目二级 stagger,基于 --row-index */
    .showcase-post-item,
    .showcase-project-card,
    .showcase-more-list li {
      opacity: 0;
      transform: translateY(1.25rem);
      transition: opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
                  transform 1.1s cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: 0s;
    }
    .showcase-slide[data-active="true"] .showcase-post-item,
    .showcase-slide[data-active="true"] .showcase-project-card,
    .showcase-slide[data-active="true"] .showcase-more-list li {
      opacity: 1;
      transform: translateY(0);
      transition-delay: calc(1.5s + var(--row-index, 0) * 0.12s);
    }

    /* =========================================================
       方向性扫描线:
       一条竖线从切换方向扫过 viewport。
       - data-scanning="forward":从右往左扫(去更靠后的 section)
       - data-scanning="backward":从左往右扫(回到更靠前的 section)
       ========================================================= */
    .showcase-scan {
      position: absolute;
      top: 0;
      bottom: 0;
      width: 2px;
      z-index: 5;
      pointer-events: none;
      background: linear-gradient(
        180deg,
        transparent 0%,
        var(--color-action) 20%,
        var(--color-action) 80%,
        transparent 100%
      );
      box-shadow:
        0 0 12px 2px color-mix(in srgb, var(--color-action) 60%, transparent),
        0 0 32px 4px color-mix(in srgb, var(--color-action) 20%, transparent);
      opacity: 0;
      left: 50%;
    }
    .showcase-scan[data-scanning="forward"] {
      animation: showcase-scan-forward 2s cubic-bezier(0.65, 0, 0.35, 1) forwards;
    }
    .showcase-scan[data-scanning="backward"] {
      animation: showcase-scan-backward 2s cubic-bezier(0.65, 0, 0.35, 1) forwards;
    }
    @keyframes showcase-scan-forward {
      0%   { left: 100%; opacity: 0; }
      15%  { opacity: 1; }
      85%  { opacity: 1; }
      100% { left: 0;    opacity: 0; }
    }
    @keyframes showcase-scan-backward {
      0%   { left: 0;    opacity: 0; }
      15%  { opacity: 1; }
      85%  { opacity: 1; }
      100% { left: 100%; opacity: 0; }
    }

    /* =========================================================
       视觉样式(主题色 = shadcn vars,跟着 dark/light 走)
       ========================================================= */

    /* 侧边导航 */
    .showcase-nav {
      position: absolute;
      top: 50%;
      left: clamp(1.5rem, 3vw, 3rem);
      transform: translateY(-50%);
      z-index: 6;
    }
    .showcase-nav ul {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .showcase-nav-link {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      text-decoration: none;
      color: var(--muted-foreground);
      font-family: ui-monospace, "JetBrains Mono", monospace;
      font-size: 0.75rem;
      letter-spacing: 0.12em;
      transition: color 0.4s ease;
    }
    .showcase-nav-link:hover { color: var(--foreground); }
    .showcase-nav-link[aria-current="page"] { color: var(--color-action); }
    .showcase-nav-index { font-weight: 600; min-width: 1.5rem; }
    .showcase-nav-label {
      opacity: 0;
      transform: translateX(-0.5rem);
      transition: opacity 0.4s ease, transform 0.4s ease;
    }
    .showcase-nav-link:hover .showcase-nav-label,
    .showcase-nav-link[aria-current="page"] .showcase-nav-label {
      opacity: 1;
      transform: translateX(0);
    }
    .showcase-nav-bar {
      width: 1.5rem;
      height: 1px;
      background: currentColor;
      opacity: 0.4;
      transition: width 0.4s ease, opacity 0.4s ease;
    }
    .showcase-nav-link[aria-current="page"] .showcase-nav-bar {
      width: 2.5rem;
      opacity: 1;
    }

    /* 右下角 progress */
    .showcase-progress {
      position: absolute;
      right: clamp(2rem, 4vw, 4rem);
      bottom: clamp(1.5rem, 3vw, 3rem);
      z-index: 6;
      font-family: ui-monospace, "JetBrains Mono", monospace;
      font-size: 0.75rem;
      letter-spacing: 0.16em;
      color: var(--muted-foreground);
      display: flex;
      align-items: baseline;
      gap: 0.4rem;
    }
    .showcase-progress-current {
      font-size: 1.5rem;
      color: var(--foreground);
      font-weight: 600;
    }

    /* 内容字体 */
    .showcase-eyebrow {
      font-family: ui-monospace, "JetBrains Mono", monospace;
      font-size: 0.75rem;
      letter-spacing: 0.18em;
      color: var(--color-action);
      margin: 0 0 1.5rem;
      text-transform: uppercase;
    }
    .showcase-title {
      font-family: var(--font-serif, serif);
      font-size: clamp(2.5rem, 6vw, 5.5rem);
      line-height: 1.05;
      margin: 0 0 1.5rem;
      max-width: 24ch;
      color: var(--foreground);
    }
    .showcase-subtitle {
      font-size: clamp(1.25rem, 2vw, 1.75rem);
      color: var(--foreground);
      margin: 0 0 1.5rem;
    }
    .showcase-body {
      font-size: 1.0625rem;
      line-height: 1.65;
      color: var(--muted-foreground);
      max-width: 38rem;
      margin: 0 0 2rem;
    }
    .showcase-cta {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      color: var(--color-action);
      text-decoration: none;
      font-size: 0.875rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      padding: 0.75rem 0;
      border-bottom: 1px solid currentColor;
      width: fit-content;
      transition: gap 0.3s ease;
    }
    .showcase-cta:hover { gap: 0.875rem; }

    .showcase-pane-title {
      font-family: var(--font-serif, serif);
      font-size: clamp(2rem, 4vw, 3.5rem);
      line-height: 1.1;
      margin: 0 0 2.5rem;
      color: var(--foreground);
    }

    /* writing 列表 */
    .showcase-post-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      max-width: 56rem;
      border-top: 1px solid var(--border);
    }
    .showcase-post-link {
      display: grid;
      grid-template-columns: 3rem 1fr auto;
      align-items: center;
      gap: 1.5rem;
      padding: 1.25rem 0;
      border-bottom: 1px solid var(--border);
      text-decoration: none;
      color: inherit;
      transition: padding-left 0.3s ease, color 0.3s ease;
    }
    .showcase-post-link:hover {
      padding-left: 1rem;
      color: var(--color-action);
    }
    .showcase-post-num {
      font-family: ui-monospace, "JetBrains Mono", monospace;
      font-size: 0.75rem;
      color: var(--muted-foreground);
    }
    .showcase-post-body { display: flex; flex-direction: column; gap: 0.25rem; }
    .showcase-post-cat {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--muted-foreground);
    }
    .showcase-post-title {
      font-size: 1.125rem;
      font-weight: 500;
      color: var(--foreground);
    }
    .showcase-post-meta {
      display: flex;
      gap: 0.5rem;
      font-size: 0.8rem;
      color: var(--muted-foreground);
    }
    .showcase-post-arrow {
      color: var(--muted-foreground);
      transition: transform 0.3s ease, color 0.3s ease;
    }
    .showcase-post-link:hover .showcase-post-arrow {
      transform: translateX(0.4rem);
      color: var(--color-action);
    }

    /* making 网格 */
    .showcase-project-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
      gap: 1.25rem;
      max-width: 64rem;
    }
    .showcase-project-card {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding: 1.5rem;
      background: var(--card);
      color: var(--card-foreground);
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      text-decoration: none;
      transition: transform 0.3s ease, border-color 0.3s ease;
    }
    .showcase-project-card:hover {
      transform: translateY(-2px);
      border-color: var(--color-action);
    }
    .showcase-project-type {
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      color: var(--muted-foreground);
    }
    .showcase-project-title {
      font-size: 1.25rem;
      font-weight: 500;
      color: var(--foreground);
    }
    .showcase-project-summary {
      font-size: 0.9375rem;
      color: var(--muted-foreground);
      line-height: 1.55;
    }
    .showcase-project-cta {
      margin-top: auto;
      font-size: 0.8rem;
      color: var(--color-action);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    /* about 双栏 */
    .showcase-about-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 4rem;
      align-items: start;
    }
    @media (max-width: 768px) {
      .showcase-about-grid { grid-template-columns: 1fr; gap: 2rem; }
    }
    .showcase-about-right {
      font-size: 1.0625rem;
      line-height: 1.7;
      color: var(--muted-foreground);
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    .showcase-about-location { color: var(--muted-foreground); font-size: 0.875rem; }

    /* more 列表 */
    .showcase-more-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
