---
import CommentsAdmin from "../../../components/domain/CommentsAdmin";
import AdminNav from "../../../components/domain/AdminNav.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getAllPublishedContent } from "../../../lib/content";

export const prerender = false;

const posts = (await getAllPublishedContent())
  .map((post) => ({ contentId: post.contentId, title: `${post.section}: ${post.title}` }));
posts.push({ contentId: "about/profile", title: "about: profile" });
---

<BaseLayout title="评论管理" description="管理内容评论" currentPath="/admin/comments/" showFooter={false}>
  <div class="app-container py-12 md:py-16">
    <div class="mx-auto max-w-5xl">
      <AdminNav current="comments" />
      <header class="mb-10 space-y-3">
        <p class="ui-kicker text-[var(--color-action)]">ADMIN</p>
        <h1 class="text-4xl font-semibold text-[var(--text-main)] md:text-5xl">评论管理</h1>
      </header>
      <CommentsAdmin posts={posts} client:load />
    </div>
  </div>
</BaseLayout>
