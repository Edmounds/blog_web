---
import SpaLayout from "../../../layouts/SpaLayout.astro";
import { defaultLocale, localeDefinitions, localizePath, type Locale } from "../../../lib/i18n";

export const prerender = true;
export function getStaticPaths() {
  return localeDefinitions
    .filter((item) => item.code !== defaultLocale)
    .map((item) => ({ params: { locale: item.path } }));
}

const locale = Astro.params.locale as Locale;
---
<SpaLayout initialPath={localizePath("/blog/", locale)} title="Blog | chasen" description="Essays and longer-form writing." locale={locale} />
