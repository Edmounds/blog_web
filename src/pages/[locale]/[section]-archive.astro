---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedContent, type ContentSection } from "../../lib/content";
import { localeDefinitions, defaultLocale, localizePath, type Locale } from "../../lib/i18n";

export const prerender = true;

export async function getStaticPaths() {
  const paths = [];
  for (const definition of localeDefinitions.filter((item) => item.code !== defaultLocale)) {
    for (const section of ["blog", "note"] as const) {
      paths.push({ params: { locale: definition.path, section }, props: { locale: definition.code, section } });
    }
  }
  return paths;
}

const { locale, section } = Astro.props as { locale: Locale; section: ContentSection };
const items = await getPublishedContent(section, locale);
const categories = [...new Set(items.map((item) => item.category))].sort((a, b) => a.localeCompare(b, locale));
const currentPath = localizePath(`/${section}-archive/`, locale);
---

<BaseLayout title={`${section} archive`} currentPath={currentPath} description={`${section} categories`} locale={locale}>
  <div class="app-container py-20">
    <h1 class="ui-page-title">{section[0].toUpperCase() + section.slice(1)} Archive</h1>
    {categories.length === 0 ? <p class="mt-8 text-[var(--text-muted)]">No categories yet.</p> : (
      <ul class="mt-10 grid gap-3 border-t border-[var(--border-soft)] py-5">
        {categories.map((category) => <li><a class="text-[var(--foreground)]" href={localizePath(`/${section}-archive/${encodeURIComponent(category)}/`, locale)}>{category}</a></li>)}
      </ul>
    )}
  </div>
</BaseLayout>
