---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import LinksSection from "../../../components/sections/LinksSection.astro";
import { defaultLocale, localeDefinitions, type Locale } from "../../../lib/i18n";

export const prerender = true;
export function getStaticPaths() {
  return localeDefinitions.filter((item) => item.code !== defaultLocale).map((item) => ({ params: { locale: item.path } }));
}
const locale = Astro.params.locale as Locale;
---
<BaseLayout title="Links" description="Friends, collaborators, and sites worth visiting." currentPath={`/${Astro.params.locale}/links/`} locale={locale}>
  <LinksSection locale={locale} />
</BaseLayout>
