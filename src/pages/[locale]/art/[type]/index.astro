---
import ArtSection from "../../../../components/sections/ArtSection.astro";
import GameSection from "../../../../components/sections/GameSection.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { getPublicArtItems, type ArtType } from "../../../../lib/art";
import { getPublicGameItems } from "../../../../lib/games";
import { type Locale } from "../../../../lib/i18n";
import { getLocalizedSite } from "../../../../lib/localized-content";
import { getRuntimeEnv } from "../../../../lib/runtime";
import { listNeteaseRanking } from "../../../../../functions/_shared/netease-music.js";

export const prerender = false;
const locale = Astro.params.locale as Locale;
const type = Astro.params.type as "music" | "book" | "screen" | "game";
if (!["zh-TW", "en", "ja"].includes(locale) || !["music", "book", "screen", "game"].includes(type)) {
  return Astro.redirect("/", 302);
}
const site = await getLocalizedSite(locale);
const title = site.labels[type];
const description = site.page[`${type}Description`];
const types: ArtType[] = type === "screen" ? ["movie", "series", "anime"] : type === "game" ? [] : [type];
const db = getRuntimeEnv().DB;
const gameItems = type === "game" ? await getPublicGameItems(db) : [];
const [artItems, weekly, total] = type === "game"
  ? [[], [], []]
  : await Promise.all([
      getPublicArtItems(db, locale, types),
      type === "music" ? listNeteaseRanking(db, "weekly") : Promise.resolve([]),
      type === "music" ? listNeteaseRanking(db, "total") : Promise.resolve([]),
    ]);
const ranking = { weekly, total };
Astro.response.headers.set("Cache-Control", "public, max-age=0, s-maxage=0, must-revalidate");
---
<BaseLayout title={title} description={description} currentPath={`/${Astro.params.locale}/art/${type}/`} locale={locale}>
  {type === "game" ? <GameSection items={gameItems} locale={locale} /> : <ArtSection type={type} items={artItems} ranking={ranking} locale={locale} />}
</BaseLayout>
