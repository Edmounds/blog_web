---
import { routes } from "../../data/static/home";
import { timelineProjects } from "../../data/static/projects";
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>Projects Gallery - Claude-inspired Dark Theme</title>
    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <script id="tailwind-config" is:inline>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#D0D0D0",
              "background-main": "#1A1A1A",
              "surface-dark": "#242424",
              "text-main": "#E0E0E0",
              "text-muted": "#A0A0A0",
              "border-color": "#333333",
              "accent-line": "#4A4A4A",
            },
            fontFamily: {
              display: ["Inter", "sans-serif"],
              serif: ["Georgia", "Times New Roman", "serif"],
            },
            borderRadius: { DEFAULT: "0.25rem", lg: "0.5rem", xl: "0.75rem", full: "9999px" },
          },
        },
      };
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <style>
      body {
        font-family: 'Inter', sans-serif;
        background-color: #1A1A1A;
      }
      .serif-font {
        font-family: 'Georgia', serif;
      }
      img {
        filter: grayscale(100%) brightness(0.9) contrast(0.95);
        transition: filter 0.5s ease;
      }
      .group:hover img {
        filter: grayscale(0%) brightness(0.6) contrast(1.1);
      }
      .timeline-line {
        width: 1px;
        background-color: #4A4A4A;
      }
      .timeline-branch {
        height: 1px;
        background-color: #4A4A4A;
      }
    </style>
  </head>
  <body class="bg-background-main text-text-main font-display selection:bg-white/20 selection:text-white min-h-screen flex flex-col antialiased">
    <nav class="sticky top-0 z-50 w-full bg-background-main/90 backdrop-blur-md border-b border-border-color">
      <div class="max-w-5xl mx-auto px-6 h-20 flex items-center justify-between">
        <a class="text-xl font-medium tracking-tight text-white hover:text-text-muted transition-colors duration-200" href={routes.home}>
          Alex Chen
        </a>
        <div class="hidden md:flex items-center space-x-8">
          <a class="text-sm text-text-muted hover:text-white transition-colors" href={routes.home}>Home</a>
          <a class="text-sm text-text-muted hover:text-white transition-colors" href={routes.blogs}>Blogs</a>
          <a class="text-sm text-white font-medium" href={routes.projects}>Projects</a>
          <a class="text-sm text-text-muted hover:text-white transition-colors" href={routes.about}>About me</a>
        </div>
        <button class="md:hidden text-text-muted hover:text-white" type="button">
          <span class="material-symbols-outlined">menu</span>
        </button>
      </div>
    </nav>

    <main class="max-w-6xl mx-auto px-6 py-12 md:py-16 flex-grow">
      <header class="mb-16 max-w-2xl mx-auto text-center">
        <h1 class="serif-font text-5xl md:text-6xl text-white mb-4 leading-tight">Selected Projects</h1>
        <p class="text-lg text-text-muted font-light leading-relaxed">
          A chronological exploration of digital experiences, interface experiments, and visual journeys.
        </p>
      </header>

      <div class="relative max-w-5xl mx-auto">
        <div class="absolute left-1/2 transform -translate-x-1/2 h-full timeline-line hidden md:block"></div>

        {timelineProjects.map((project) => (
          <article class={`relative md:w-1/2 group mb-12 md:mb-16 ${project.side === "left" ? "md:pr-12 md:ml-0" : "md:ml-auto md:pl-12"}`}>
            {project.side === "left" ? (
              <>
                <div class="hidden md:block absolute top-6 right-0 w-12 timeline-branch"></div>
                <div class="hidden md:block absolute top-6 -right-[3px] transform -translate-y-1/2 w-1.5 h-1.5 rounded-full bg-accent-line"></div>
              </>
            ) : (
              <>
                <div class="hidden md:block absolute top-6 left-0 w-12 timeline-branch"></div>
                <div class="hidden md:block absolute top-6 -left-[3px] transform -translate-y-1/2 w-1.5 h-1.5 rounded-full bg-accent-line"></div>
              </>
            )}

            <div class={`flex flex-col ${project.side === "left" ? "items-end text-right md:items-end" : "items-start text-left"}`}>
              <div class={`mb-3 w-full flex flex-col ${project.side === "left" ? "items-end" : "items-start"}`}>
                <h2 class="serif-font text-2xl md:text-3xl text-white font-bold group-hover:text-primary transition-colors duration-300 tracking-tight leading-none mb-1">
                  {project.title}
                </h2>
                <span class="text-xs text-text-muted font-mono tracking-widest uppercase">{project.year}</span>
              </div>

              <a href={routes.projects} class="aspect-[16/9] w-full overflow-hidden rounded-sm bg-surface-dark border border-border-color mb-4 relative shadow-2xl shadow-black/20 group-hover:shadow-white/5 transition-shadow duration-500">
                <div class="absolute inset-0 bg-black/0 group-hover:bg-black/30 transition-colors duration-500 z-10 flex items-center justify-center">
                  <div class="opacity-0 group-hover:opacity-100 transform translate-y-4 group-hover:translate-y-0 transition-all duration-500 flex items-center gap-2 text-white border border-white/30 bg-black/20 backdrop-blur-sm px-6 py-3 rounded-full">
                    <span class="text-sm font-medium tracking-wide">View Case Study</span>
                    <span class="material-symbols-outlined text-sm">arrow_outward</span>
                  </div>
                </div>
                <img alt={project.title} class="h-full w-full object-cover transition-all duration-700 ease-out transform group-hover:scale-105" src={project.cover} />
              </a>

              <p class="text-sm text-text-muted leading-relaxed font-light max-w-md">
                {project.summary}
                <span class="block mt-1 text-[10px] text-zinc-500 uppercase tracking-wider">{project.category}</span>
              </p>
            </div>
          </article>
        ))}
      </div>

      <div class="mt-16 flex justify-center">
        <button class="px-8 py-3 rounded-full border border-border-color text-text-muted hover:text-white hover:border-white transition-all duration-300 text-sm tracking-wide" type="button">
          Load More Projects
        </button>
      </div>
    </main>

    <footer class="border-t border-border-color bg-surface-dark/30 mt-12">
      <div class="max-w-5xl mx-auto px-6 py-12 flex flex-col md:flex-row justify-between items-center gap-6">
        <div class="text-sm text-zinc-500">&copy; 2024 Alex Chen. All rights reserved.</div>
        <div class="flex space-x-6">
          <a class="text-zinc-500 hover:text-white transition-colors" href={routes.blogs}>
            <span class="sr-only">Blogs</span>
            <svg aria-hidden="true" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path></svg>
          </a>
          <a class="text-zinc-500 hover:text-white transition-colors" href={routes.home}>
            <span class="sr-only">Home</span>
            <svg aria-hidden="true" class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" fill-rule="evenodd"></path></svg>
          </a>
        </div>
      </div>
    </footer>
  </body>
</html>

