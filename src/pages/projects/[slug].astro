---
import Reveal from "../../components/animation/Reveal";
import ArticleMeta from "../../components/domain/ArticleMeta.astro";
import PageContainer from "../../components/foundation/PageContainer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getNextProject, getProjectStaticPaths } from "../../lib/content";
import { routes } from "../../lib/routes";
import TableOfContents from "../../components/domain/TableOfContents";

export const prerender = true;

export async function getStaticPaths() {
  return getProjectStaticPaths();
}

const { project } = Astro.props;
const { Content, headings } = await project.render();
const nextProject = await getNextProject(project.slug);
const metaItems = [
  { label: "Category", value: project.data.category },
  { label: "Year", value: String(project.data.year) },
  project.data.type ? { label: "Type", value: project.data.type } : undefined,
].filter((item): item is { label: string; value: string } => Boolean(item));
---

<BaseLayout title={project.data.title} description={project.data.summary} currentPath={routes.projects}>
  <PageContainer class="py-12 md:py-16">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-12">
      <aside class="hidden lg:col-span-3 lg:block">
        <div class="sticky top-28 space-y-5">
          <Reveal delay={0.08} y={10} client:visible>
            <TableOfContents headings={headings} client:load />
          </Reveal>
        </div>
      </aside>

      <article class="flex flex-col gap-8 lg:col-span-7">
        <Reveal client:visible>
          <header class="flex flex-col gap-6">
            <div class="flex flex-col gap-5">
              <p class="ui-kicker text-[var(--color-action)]">{project.data.category}</p>
              <h1 class="ui-page-title text-[var(--text-main)]">{project.data.title}</h1>
              <p class="ui-lead max-w-3xl">{project.data.summary}</p>
            </div>
            <ArticleMeta items={metaItems} variant="grid" />
          </header>
        </Reveal>

        <section class="ui-prose">
          <Content />
        </section>

        <Reveal y={12} client:visible>
          <section class="border-t border-[var(--border-soft)] bg-[var(--surface-parchment)] px-5 py-6">
            <div class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
              <div class="flex max-w-2xl flex-col gap-3">
                <p class="ui-kicker">Next project</p>
                <h2 class="text-3xl font-semibold leading-tight text-[var(--text-main)] md:text-4xl">{nextProject.title}</h2>
              </div>
              <a href={routes.project(nextProject.slug)} class="ui-link ui-link-accent shrink-0 text-sm" aria-label={`Read next project: ${nextProject.title}`}>
                Read next -&gt;
              </a>
            </div>
          </section>
        </Reveal>
      </article>

      <div class="hidden lg:col-span-2 lg:block"></div>
    </div>
  </PageContainer>
</BaseLayout>
