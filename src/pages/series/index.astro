---
import Reveal from "../../components/animation/Reveal";
import PageContainer from "../../components/foundation/PageContainer.astro";
import SurfacePanel from "../../components/foundation/SurfacePanel.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSeriesSummaries, getSiteSettings } from "../../lib/content";
import { routes } from "../../lib/routes";
import { toSeriesSummaryModel } from "../../lib/view-models";

export const prerender = true;

const site = await getSiteSettings();
const seriesItems = (await getSeriesSummaries()).map(toSeriesSummaryModel);
---

<BaseLayout title={site.copy.seriesTitle} description={site.copy.seriesDescription} currentPath={routes.series}>
  <PageContainer class="flex flex-col gap-10 py-12 md:py-16">
    <Reveal client:visible>
      <header class="mx-auto flex max-w-3xl flex-col gap-4 text-center">
        <p class="ui-kicker">Topics</p>
        <h1 class="ui-page-title text-[var(--text-main)]">{site.copy.seriesTitle}</h1>
        <p class="ui-lead">{site.copy.seriesDescription}</p>
      </header>
    </Reveal>

    <Reveal y={12} client:visible>
      <section class="mx-auto grid max-w-5xl grid-cols-1 gap-5 md:grid-cols-2">
        {seriesItems.map((series) => (
          <SurfacePanel class="bg-[var(--surface-parchment)] p-6">
            <article class="flex h-full min-h-48 flex-col gap-6">
              <div class="flex flex-col gap-3">
                <p class="ui-kicker">{series.count} posts</p>
                <h2 class="text-3xl font-semibold leading-tight text-[var(--text-main)]">{series.title}</h2>
              </div>
              <a href={series.href} class="ui-link ui-link-accent mt-auto text-sm">
                {site.copy.seriesAllPostsCta} -&gt;
              </a>
            </article>
          </SurfacePanel>
        ))}
      </section>
    </Reveal>
  </PageContainer>
</BaseLayout>
