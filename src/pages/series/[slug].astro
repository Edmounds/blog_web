---
import Reveal from "../../components/animation/Reveal";
import ArchivePostsView from "../../components/domain/ArchivePostsView.astro";
import PageContainer from "../../components/foundation/PageContainer.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getSeriesBlogSections, getSeriesStaticPaths, getSeriesSummaries, getSiteSettings } from "../../lib/content";
import { routes } from "../../lib/routes";
import { toArchivePostSections } from "../../lib/view-models";

export const prerender = true;

export async function getStaticPaths() {
  return getSeriesStaticPaths();
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error("Missing series slug.");
}

const site = await getSiteSettings();
const seriesSummaries = await getSeriesSummaries();
const activeSeries = seriesSummaries.find((series) => series.slug === slug);

if (!activeSeries) {
  throw new Error(`Unknown series slug: ${slug}`);
}

const cardCopy = {
  publishedLabel: site.copy.blogMetaPublished,
  readLabel: site.copy.blogMetaRead,
  readArticleLabel: site.copy.blogReadArticle,
};
const archiveBlogSections = await getSeriesBlogSections(slug);
const sections = toArchivePostSections(archiveBlogSections, cardCopy);
---

<BaseLayout title={activeSeries.title} description={site.copy.seriesDescription} currentPath={routes.series}>
  <PageContainer class="py-12 md:py-16">
    <Reveal client:visible>
      <section class="mb-10 flex max-w-3xl flex-col gap-3">
        <p class="ui-kicker">Series</p>
        <h1 class="ui-page-title text-[var(--text-main)]">{activeSeries.title}</h1>
        <p class="ui-lead">{site.copy.seriesDescription}</p>
      </section>
    </Reveal>

    <ArchivePostsView sections={sections} hideYearHeader={true} />
  </PageContainer>
</BaseLayout>
