---
import Reveal from "../components/animation/Reveal";
import Stagger from "../components/animation/Stagger";
import Divider from "../components/foundation/Divider.astro";
import PageContainer from "../components/foundation/PageContainer.astro";
import ContentCard from "../components/domain/ContentCard.astro";
import HomeHero from "../components/sections/HomeHero.astro";
import SectionHeading from "../components/site/SectionHeading.astro";
import { getAboutProfile, getHomeBlogPosts, getHomeProjects, getSiteSettings } from "../lib/content";
import { routes } from "../lib/routes";
import BaseLayout from "../layouts/BaseLayout.astro";
import { toBlogCardModel, toProjectCardModel } from "../lib/view-models";

const site = await getSiteSettings();
const homeBlogPosts = await getHomeBlogPosts();
const homeProjects = await getHomeProjects();
const { homeFeatured } = await getAboutProfile();
const blogCardCopy = {
  publishedLabel: site.copy.blogMetaPublished,
  readLabel: site.copy.blogMetaRead,
  readArticleLabel: site.copy.blogReadArticle,
};
const blogCards = homeBlogPosts.map((post) => toBlogCardModel(post, blogCardCopy));
const projectCards = homeProjects.map(toProjectCardModel);
const compactBlogCards = blogCards.map((card) => ({ ...card, meta: [], summary: "", footerText: undefined }));
const compactProjectCards = projectCards.map((card) => ({ ...card, meta: [], summary: "", footerText: undefined }));
---

<BaseLayout title="Home" description="Design notes, essays, and selected projects." currentPath={routes.home}>
  <PageContainer class="home-page-shell py-12 md:py-20">
    <div class="home-page-grid">
      <aside class="home-feature-rail">
        <HomeHero
          badge={homeFeatured.badge}
          title={homeFeatured.title}
          name={homeFeatured.name}
          description={homeFeatured.description}
          location={homeFeatured.location}
          href={routes.about}
        />
      </aside>

      <div class="home-feed space-y-16">
        <Reveal client:visible>
          <Divider />
        </Reveal>

        <section>
          <Reveal client:visible>
            <SectionHeading title={site.copy.homeRecentBlogsTitle} cta={{ label: site.copy.homeRecentBlogsCta, href: routes.blogs }} />
          </Reveal>
          <Stagger className="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3" delay={0.08} stagger={0.06} client:visible>
            {compactBlogCards.map((card) => (
              <ContentCard {...card} />
            ))}
          </Stagger>
        </section>

        <Reveal client:visible>
          <Divider />
        </Reveal>

        <section>
          <Reveal client:visible>
            <SectionHeading
              title={site.copy.homeRecentProjectsTitle}
              cta={{ label: site.copy.homeRecentProjectsCta, href: routes.projects }}
            />
          </Reveal>
          <Stagger className="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3" delay={0.08} stagger={0.06} client:visible>
            {compactProjectCards.map((card) => (
              <ContentCard {...card} />
            ))}
          </Stagger>
        </section>
      </div>
    </div>
  </PageContainer>
</BaseLayout>

<style>
  .home-page-shell {
    max-width: 104rem;
    padding-inline: clamp(1.25rem, 2.2vw, 2.25rem);
  }

  .home-page-grid {
    display: grid;
    gap: clamp(2.5rem, 4vw, 4.25rem);
  }

  .home-feature-rail {
    align-self: start;
    width: 100%;
  }

  .home-feed {
    width: 100%;
  }

  @media (min-width: 1024px) {
    .home-page-shell {
      padding-left: clamp(2rem, 4.5vw, 4.5rem);
      padding-right: clamp(1.5rem, 3vw, 3rem);
    }

    .home-page-grid {
      grid-template-columns: minmax(12rem, 14.5rem) minmax(0, 70rem);
      column-gap: clamp(4rem, 6.5vw, 7.5rem);
      align-items: start;
      justify-content: center;
    }

    .home-feature-rail {
      position: sticky;
      top: 50vh;
      transform: translateY(-50%);
      width: min(14.5rem, 100%);
    }

    .home-feed {
      max-width: 70rem;
      margin-left: 0;
    }
  }
</style>
