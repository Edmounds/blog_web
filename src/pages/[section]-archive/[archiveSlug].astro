---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedContent } from "../../lib/content";

export const prerender = true;
export async function getStaticPaths() {
  const paths = [];
  for (const section of ["blog", "note"] as const) {
    const items = await getPublishedContent(section);
    for (const category of new Set(items.map((item) => item.category))) {
      paths.push({ params: { section, archiveSlug: category }, props: { section, category, items: items.filter((item) => item.category === category) } });
    }
  }
  return paths;
}
const { section, category, items } = Astro.props;
---
<BaseLayout title={`${category} | ${section}`} currentPath={`/${section}-archive/${category}/`} description={`${category} ${section} archive`}>
  <div class="app-container py-20">
    <p class="ui-kicker">{section}</p>
    <h1 class="ui-page-title mt-2">{category}</h1>
    <ol class="mt-10 border-t border-[var(--border-soft)]">
      {items.map((item) => <li class="border-b border-[var(--border-soft)] py-5"><a class="text-[var(--foreground)] no-underline" href={`/${section}/${item.slug}/`}>{item.title}</a></li>)}
    </ol>
  </div>
</BaseLayout>
