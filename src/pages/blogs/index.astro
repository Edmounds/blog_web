---
import Reveal from "../../components/animation/Reveal";
import PageContainer from "../../components/foundation/PageContainer.astro";
import ArchiveSidebar from "../../components/domain/ArchiveSidebar.astro";
import ArchivePostsView from "../../components/domain/ArchivePostsView.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArchiveBlogSections, getArchiveCategorySummaries, getSiteSettings } from "../../lib/content";
import { routes } from "../../lib/routes";
import { toArchiveFilters, toBlogCardModel } from "../../lib/view-models";

const site = await getSiteSettings();
const archiveBlogSections = await getArchiveBlogSections();
const archiveCategorySummaries = await getArchiveCategorySummaries();
const filters = toArchiveFilters(archiveCategorySummaries, site.copy.archiveAllCategories);
const cardCopy = {
  publishedLabel: site.copy.blogMetaPublished,
  readLabel: site.copy.blogMetaRead,
  readArticleLabel: site.copy.blogReadArticle,
};
const sections = archiveBlogSections.map((section) => ({
  year: section.year,
  cards: section.posts.map((post) => toBlogCardModel(post, cardCopy)),
  posts: section.posts.map((post) => ({
    slug: post.slug,
    title: post.title,
    summary: post.summary,
    category: post.category,
    dateLabel: post.dateLabel,
    readingTime: post.readingTime,
    tags: post.archiveTags,
  })),
}));
---

<BaseLayout title="Blogs" description="Writing archive and notes." currentPath={routes.blogs}>
  <PageContainer class="py-12 md:py-16">
    <Reveal client:visible>
      <section class="mb-10 max-w-2xl space-y-3">
        <p class="ui-kicker">Archive</p>
        <h1 class="font-serif text-5xl text-[var(--text-main)] md:text-6xl">Writing Archive</h1>
        <p class="text-[var(--text-muted)]">
          Essays on design systems, product thinking, and working with AI interfaces.
        </p>
      </section>
    </Reveal>

    <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
      <aside class="lg:col-span-4 xl:col-span-3">
        <ArchiveSidebar filters={filters} title={site.copy.archiveSidebarTitle} />
      </aside>

      <section class="lg:col-span-8 xl:col-span-9">
        <ArchivePostsView sections={sections} />
      </section>
    </div>
  </PageContainer>
</BaseLayout>
