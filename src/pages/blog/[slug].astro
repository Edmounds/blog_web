---
import ContentDetail from "../../components/domain/ContentDetail.astro";
import { getContentStaticPaths, getNextContent } from "../../lib/content";
export const prerender = true;
export function getStaticPaths() { return getContentStaticPaths("blog"); }
const { item } = Astro.props;
const next = await getNextContent("blog", item.slug);
---
<ContentDetail item={item} next={next} />
