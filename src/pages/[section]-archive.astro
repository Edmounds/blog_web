---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getPublishedContent, type ContentSection } from "../lib/content";

export const prerender = true;
export function getStaticPaths() {
  return ["blog", "note"].map((section) => ({ params: { section }, props: { section } }));
}
const section = Astro.props.section as ContentSection;
const items = await getPublishedContent(section);
const categories = [...new Set(items.map((item) => item.category))].sort();
---
<BaseLayout title={`${section} archive`} currentPath={`/${section}-archive/`} description={`${section} categories`}>
  <div class="app-container py-20">
    <h1 class="ui-page-title">{section[0].toUpperCase() + section.slice(1)} Archive</h1>
    {categories.length === 0 ? <p class="mt-8 text-[var(--text-muted)]">No categories yet.</p> : (
      <ul class="mt-10 grid gap-3 border-t border-[var(--border-soft)] py-5">
        {categories.map((category) => <li><a class="text-[var(--foreground)]" href={`/${section}-archive/${encodeURIComponent(category)}/`}>{category}</a></li>)}
      </ul>
    )}
  </div>
</BaseLayout>
