---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import ArtSection from "../../../components/sections/ArtSection.astro";
import { getLocalizedSite } from "../../../lib/localized-content";

export const prerender = true;
const site = await getLocalizedSite("zh-CN");
---
<BaseLayout title={site.labels.book} description={site.page.bookDescription} currentPath="/art/book/">
  <ArtSection type="book" />
</BaseLayout>
