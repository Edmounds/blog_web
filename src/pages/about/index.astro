---
import { aboutExperience, aboutFocusCards, aboutMeta, aboutProfile, aboutStory } from "../../data/static/about";
import { routes } from "../../data/static/home";
---

<!DOCTYPE html>
<html class="dark" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <title>About Me - Minimalist Portfolio</title>
    <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&family=Noto+Sans:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <script id="tailwind-config" is:inline>
      tailwind.config = {
        darkMode: "class",
        theme: {
          extend: {
            colors: {
              primary: "#D4D4D4",
              "background-light": "#f6f6f8",
              "background-dark": "#1A1A1A",
              charcoal: "#1A1A1A",
              "off-white": "#E0E0E0",
              "subtle-gray": "#A0A0A0",
              "border-color": "#333333",
            },
            fontFamily: {
              display: ["Newsreader", "serif"],
              sans: ["Noto Sans", "sans-serif"],
            },
            borderRadius: {
              DEFAULT: "0.25rem",
              lg: "0.5rem",
              xl: "0.75rem",
              "2xl": "1rem",
              "3xl": "1.5rem",
              full: "9999px",
            },
            typography: {
              DEFAULT: {
                css: {
                  color: "#E0E0E0",
                  a: {
                    color: "#E0E0E0",
                    "&:hover": {
                      color: "#FFFFFF",
                    },
                  },
                },
              },
            },
          },
        },
      };
    </script>
    <style>
      ::-webkit-scrollbar {
        width: 8px;
      }
      ::-webkit-scrollbar-track {
        background: #1A1A1A;
      }
      ::-webkit-scrollbar-thumb {
        background: #333333;
        border-radius: 4px;
      }
      ::-webkit-scrollbar-thumb:hover {
        background: #4a4a4a;
      }
      .grain-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 50;
        opacity: 0.04;
        background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
      }
    </style>
  </head>
  <body class="bg-background-light dark:bg-background-dark font-sans text-off-white antialiased selection:bg-white/20 selection:text-white">
    <div class="grain-overlay"></div>
    <div class="relative flex min-h-screen w-full flex-col overflow-x-hidden">
      <header class="flex w-full items-center justify-between px-6 py-8 md:px-12 lg:px-20 max-w-7xl mx-auto z-10">
        <div class="flex items-center gap-3">
          <a class="font-display font-medium text-xl text-white tracking-tight hover:opacity-80 transition-opacity" href={routes.home}>
            {aboutProfile.brand}
          </a>
        </div>
        <nav class="hidden md:flex items-center gap-10">
          <a class="text-sm font-sans text-subtle-gray hover:text-white transition-colors duration-300" href={routes.home}>Home</a>
          <a class="text-sm font-sans text-white font-medium transition-colors duration-300" href={routes.about}>About</a>
          <a class="text-sm font-sans text-subtle-gray hover:text-white transition-colors duration-300" href={routes.blogs}>Articles</a>
          <a class="text-sm font-sans text-subtle-gray hover:text-white transition-colors duration-300" href={routes.projects}>Notes</a>
        </nav>
        <a class="group flex items-center gap-2 border-b border-white/20 pb-0.5 text-sm font-sans font-medium text-white transition-all hover:border-white" href={routes.about}>
          <span>Get in Touch</span>
          <span class="material-symbols-outlined text-[16px] group-hover:translate-x-0.5 transition-transform">arrow_outward</span>
        </a>
      </header>

      <main class="flex-1 w-full px-6 md:px-12 lg:px-20 py-12 md:py-20 max-w-7xl mx-auto z-10">
        <section class="grid grid-cols-1 lg:grid-cols-12 gap-12 mb-32 items-start border-b border-white/10 pb-20">
          <div class="lg:col-span-8 space-y-10">
            <div class="space-y-6">
              <h1 class="font-display text-6xl md:text-8xl lg:text-9xl font-light tracking-tight text-white leading-[0.9]">
                {aboutProfile.titleLeading} <br />
                <span class="italic font-normal text-subtle-gray">{aboutProfile.titleName}</span>
              </h1>
              <p class="text-xl md:text-2xl text-subtle-gray leading-relaxed max-w-2xl font-light font-display">
                {aboutProfile.subtitle}
              </p>
            </div>
            <div class="flex items-center gap-8 pt-4">
              <button class="group flex items-center gap-3 text-white transition-colors" type="button">
                <div class="flex items-center justify-center h-10 w-10 rounded-full border border-white/20 group-hover:bg-white group-hover:text-background-dark transition-all">
                  <span class="material-symbols-outlined text-[18px]">download</span>
                </div>
                <span class="font-sans text-sm tracking-wide">Resume</span>
              </button>
              <button class="group flex items-center gap-3 text-white transition-colors" type="button">
                <div class="flex items-center justify-center h-10 w-10 rounded-full border border-white/20 group-hover:bg-white group-hover:text-background-dark transition-all">
                  <span class="material-symbols-outlined text-[18px]">mail</span>
                </div>
                <span class="font-sans text-sm tracking-wide">Email Me</span>
              </button>
            </div>
          </div>
          <div class="lg:col-span-4 flex flex-col items-start lg:items-end space-y-8">
            <div class="w-full max-w-[280px] aspect-square rounded-3xl overflow-hidden bg-neutral-800 relative group">
              <div class="absolute inset-0 bg-neutral-900/10 z-10 group-hover:bg-transparent transition-all duration-500"></div>
              <img alt="Monochromatic portrait of a man looking thoughtfully to the side" class="h-full w-full object-cover grayscale transition-all duration-700 group-hover:grayscale-0 group-hover:scale-105" src={aboutProfile.portrait} />
            </div>
            <div class="w-full max-w-[280px] space-y-6 font-sans text-sm">
              {aboutMeta.map((item) => (
                <div class="flex flex-col gap-1 border-t border-white/10 pt-4">
                  <span class="text-subtle-gray uppercase tracking-wider text-xs">{item.label}</span>
                  <span class="text-white font-medium">{item.value}</span>
                </div>
              ))}
              <div class="flex flex-col gap-1 border-t border-white/10 pt-4">
                <span class="text-subtle-gray uppercase tracking-wider text-xs">Availability</span>
                <div class="flex items-center gap-2">
                  <span class="relative flex h-2 w-2">
                    <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                    <span class="relative inline-flex rounded-full h-2 w-2 bg-green-500"></span>
                  </span>
                  <span class="text-white font-medium">Open to opportunities</span>
                </div>
              </div>
            </div>
          </div>
        </section>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
          <div class="lg:col-span-8 space-y-32">
            <section>
              <h2 class="font-display text-4xl font-normal text-white mb-10">The Story</h2>
              <div class="space-y-8 text-lg md:text-xl leading-relaxed text-subtle-gray font-light font-display">
                {aboutStory.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </section>

            <section>
              <h2 class="font-display text-4xl font-normal text-white mb-10">Current Focus</h2>
              <div class="grid gap-8">
                {aboutFocusCards.map((card) => (
                  <div class="group border border-white/5 bg-white/[0.02] p-8 rounded-2xl hover:border-white/10 transition-colors">
                    <div class="flex items-start justify-between mb-4">
                      <h3 class="text-xl font-display font-medium text-white">{card.title}</h3>
                      <span class="material-symbols-outlined text-subtle-gray">{card.icon}</span>
                    </div>
                    <p class="text-subtle-gray leading-relaxed font-light">{card.text}</p>
                  </div>
                ))}
              </div>
            </section>

            <section class="mb-20">
              <h2 class="font-display text-4xl font-normal text-white mb-10">Selected Experience</h2>
              <div class="space-y-0">
                {aboutExperience.map((job, index) => (
                  <div class={`group flex flex-col md:flex-row gap-4 md:gap-10 py-8 border-t border-white/10 ${index === aboutExperience.length - 1 ? "border-b" : ""}`}>
                    <div class="w-full md:w-32 shrink-0 pt-1">
                      <span class="font-sans text-sm text-subtle-gray">{job.years}</span>
                    </div>
                    <div class="flex-1">
                      <h3 class="text-xl text-white font-display font-medium mb-1 group-hover:text-off-white transition-colors">{job.role}</h3>
                      <div class="text-sm text-subtle-gray uppercase tracking-wider mb-4">{job.company}</div>
                      <p class="text-subtle-gray font-light text-base leading-relaxed max-w-xl">{job.text}</p>
                    </div>
                  </div>
                ))}
              </div>
            </section>
          </div>
          <div class="hidden lg:block lg:col-span-4"></div>
        </div>

        <footer class="mt-32 border-t border-white/10 pt-12 flex flex-col md:flex-row justify-between items-start md:items-center gap-6">
          <div>
            <h2 class="text-2xl font-display italic text-white mb-2">Let's build something quiet.</h2>
            <p class="text-subtle-gray text-sm font-sans">&copy; 2023 Alex Design. All rights reserved.</p>
          </div>
          <div class="flex gap-4">
            <a class="h-10 w-10 flex items-center justify-center rounded-full border border-white/10 text-white hover:bg-white hover:text-background-dark transition-all duration-300" href={routes.home}>
              <svg aria-hidden="true" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84"></path></svg>
            </a>
            <a class="h-10 w-10 flex items-center justify-center rounded-full border border-white/10 text-white hover:bg-white hover:text-background-dark transition-all duration-300" href={routes.projects}>
              <svg aria-hidden="true" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" fill-rule="evenodd"></path></svg>
            </a>
            <a class="h-10 w-10 flex items-center justify-center rounded-full border border-white/10 text-white hover:bg-white hover:text-background-dark transition-all duration-300" href={routes.blogs}>
              <svg aria-hidden="true" class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path clip-rule="evenodd" d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" fill-rule="evenodd"></path></svg>
            </a>
          </div>
        </footer>
      </main>
    </div>
  </body>
</html>

