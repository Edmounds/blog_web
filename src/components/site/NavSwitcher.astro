---
import { routes } from "../../lib/routes";
import type { NavItem } from "../../types/ui";

interface Props {
  currentPath: string;
  navItems: NavItem[];
  variant?: "desktop" | "mobile";
}

const { currentPath, navItems, variant = "desktop" } = Astro.props;
const isMobile = variant === "mobile";

const isActive = (item: NavItem) => {
  if (item.match === "prefix") {
    if (item.href === routes.blogs) {
      return currentPath.startsWith(routes.blogs) || currentPath.startsWith("/blog/");
    }
    return currentPath.startsWith(item.href);
  }
  return currentPath === item.href;
};
---

<nav
  class:list={[
    "nav-switcher relative flex min-w-0 items-center rounded-full p-0.5",
    isMobile ? "bg-black/5 dark:bg-white/10 text-sm" : "text-base",
  ]}
  data-nav-switcher
>
  {navItems.map((item) => (
    <a
      href={item.href}
      data-nav-link
      aria-current={isActive(item) ? "page" : undefined}
      class:list={[
        "relative z-10 rounded-full leading-none transition duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-action)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-base)]",
        isMobile ? "px-3 py-2.5" : "px-4 py-2.5",
        isActive(item) ? "text-[var(--text-main)]" : "text-[var(--text-muted)] hover:text-[var(--text-main)]",
      ]}
    >
      {item.label}
    </a>
  ))}
  <span class="nav-switcher-indicator" data-nav-indicator aria-hidden="true"></span>
</nav>

<style>
  .nav-switcher-indicator {
    --x: 0px;
    --w: 0px;
    position: absolute;
    left: 0;
    top: 0.25rem;
    bottom: 0.25rem;
    width: var(--w);
    border-radius: 999px;
    background: var(--surface-canvas);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-soft);
    transform: translateX(var(--x));
    opacity: 0;
  }

  .nav-switcher[data-ready="true"] .nav-switcher-indicator {
    opacity: 1;
  }
</style>
