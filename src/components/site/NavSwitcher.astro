---
import { ChevronDown } from "lucide-react";

import type { NavItem } from "../../types/ui";
import { localizePath, stripLocaleFromPath } from "../../lib/i18n";

interface Props {
  currentPath: string;
  navItems: NavItem[];
  variant?: "desktop" | "mobile";
}

const { currentPath, navItems, variant = "desktop" } = Astro.props;
const isMobile = variant === "mobile";
const { locale, pathname: routePath } = stripLocaleFromPath(currentPath);

const isActive = (item: NavItem): boolean => {
  if (item.children?.length) return item.children.some(isActive);

  if (item.match === "prefix") {
    const normalizedPath = routePath.replace(/\/$/, "");
    const normalizedItemHref = item.href.replace(/\/$/, "");
    if (normalizedItemHref === "/blogs") {
      return routePath.startsWith("/blogs") || routePath.startsWith("/blog/");
    }
    return normalizedPath.startsWith(normalizedItemHref);
  }

  return routePath.replace(/\/$/, "") === item.href.replace(/\/$/, "");
};
---

<nav
  class:list={[
    "nav-switcher relative flex items-center rounded-full p-0.5",
    isMobile ? "w-max min-w-max bg-black/5 text-sm dark:bg-white/10" : "min-w-0 text-base",
  ]}
  data-nav-switcher
>
  {navItems.map((item) => {
    const hasChildren = Boolean(item.children?.length);
    const active = isActive(item);

    if (!hasChildren) {
      return (
        <a
          href={localizePath(item.href, locale)}
          data-nav-link
          aria-current={active ? "page" : undefined}
          class:list={[
            "relative z-10 shrink-0 whitespace-nowrap rounded-full leading-none transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-action)]",
            isMobile ? "px-3 py-2.5" : "px-4 py-2.5",
            active ? "text-[var(--text-main)]" : "text-[var(--text-muted)] hover:text-[var(--text-main)]",
          ]}
        >
          {item.label}
        </a>
      );
    }

    return (
      <div class="relative shrink-0" data-nav-dropdown>
        <button
          type="button"
          data-nav-dropdown-trigger
          aria-haspopup="menu"
          aria-expanded="false"
          class:list={[
            "relative z-10 inline-flex items-center gap-1 whitespace-nowrap rounded-full leading-none transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-action)]",
            isMobile ? "px-3 py-2.5" : "px-4 py-2.5",
            active ? "text-[var(--text-main)]" : "text-[var(--text-muted)] hover:text-[var(--text-main)]",
          ]}
        >
          <span>{item.label}</span>
          <ChevronDown className="size-3.5 transition-transform duration-200" data-nav-dropdown-icon aria-hidden="true" />
        </button>

        <div
          class:list={[
            "fixed z-[70] hidden w-36 rounded-md border border-[var(--border-strong)] bg-[var(--surface-canvas)] p-1 shadow-lg",
            !isMobile && "md:absolute md:left-1/2 md:top-full md:mt-2 md:-translate-x-1/2",
          ]}
          role="menu"
          data-nav-dropdown-menu
        >
          {item.children!.map((child) => (
            <a
              href={localizePath(child.href, locale)}
              data-nav-link
              role="menuitem"
              aria-current={isActive(child) ? "page" : undefined}
              class:list={[
                "flex min-h-10 items-center rounded px-3 py-2 text-sm transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-action)]",
                isActive(child)
                  ? "bg-[var(--bg-subtle)] text-[var(--text-main)]"
                  : "text-[var(--text-muted)] hover:bg-[var(--bg-subtle)] hover:text-[var(--text-main)]",
              ]}
            >
              {child.label}
            </a>
          ))}
        </div>
      </div>
    );
  })}
  <span class="nav-switcher-indicator" data-nav-indicator aria-hidden="true"></span>
</nav>

<script>
  function bindNavDropdowns() {
    document.querySelectorAll<HTMLElement>("[data-nav-dropdown]").forEach((root) => {
      if (root.dataset.bound === "true") return;
      root.dataset.bound = "true";

      const trigger = root.querySelector<HTMLButtonElement>("[data-nav-dropdown-trigger]");
      const menu = root.querySelector<HTMLElement>("[data-nav-dropdown-menu]");
      const icon = root.querySelector<HTMLElement>("[data-nav-dropdown-icon]");
      if (!trigger || !menu) return;

      const position = () => {
        if (window.matchMedia("(min-width: 768px)").matches) {
          menu.style.removeProperty("left");
          menu.style.removeProperty("top");
          return;
        }
        const rect = trigger.getBoundingClientRect();
        const left = Math.min(window.innerWidth - menu.offsetWidth - 12, Math.max(12, rect.right - menu.offsetWidth));
        menu.style.left = `${left}px`;
        menu.style.top = `${rect.bottom + 8}px`;
      };

      const close = (restoreFocus = false) => {
        menu.classList.add("hidden");
        trigger.setAttribute("aria-expanded", "false");
        icon?.classList.remove("rotate-180");
        if (restoreFocus) trigger.focus();
      };

      const open = () => {
        menu.classList.remove("hidden");
        trigger.setAttribute("aria-expanded", "true");
        icon?.classList.add("rotate-180");
        position();
      };

      trigger.addEventListener("click", () => menu.classList.contains("hidden") ? open() : close());
      root.addEventListener("keydown", (event) => {
        if (event.key === "Escape") close(true);
      });
      root.querySelectorAll<HTMLAnchorElement>("[role='menuitem']").forEach((link) => {
        link.addEventListener("click", () => close());
      });
      document.addEventListener("pointerdown", (event) => {
        if (!root.contains(event.target as Node)) close();
      });
      window.addEventListener("resize", () => {
        if (!menu.classList.contains("hidden")) position();
      });
    });
  }

  bindNavDropdowns();
  document.addEventListener("astro:page-load", bindNavDropdowns);
</script>

<style>
  .nav-switcher-indicator {
    --x: 0px;
    --w: 0px;
    position: absolute;
    left: 0;
    top: 0.25rem;
    bottom: 0.25rem;
    width: var(--w);
    border-radius: 999px;
    background: var(--surface-canvas);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-soft);
    transform: translateX(var(--x));
    opacity: 0;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), width 0.25s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-switcher[data-ready="true"] .nav-switcher-indicator { opacity: 1; }

  @media (prefers-reduced-motion: reduce) {
    .nav-switcher-indicator { transition: none !important; }
  }
</style>
