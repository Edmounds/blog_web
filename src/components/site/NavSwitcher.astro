---
import type { NavItem } from "../../types/ui";

interface Props {
  currentPath: string;
  navItems: NavItem[];
  variant?: "desktop" | "mobile";
}

const { currentPath, navItems, variant = "desktop" } = Astro.props;
const isMobile = variant === "mobile";

const isActive = (item: NavItem): boolean => {
  if (item.children && item.children.length > 0) {
    return item.children.some(child => isActive(child));
  }
  
  if (item.match === "prefix") {
    const normalizedPath = currentPath.replace(/\/$/, "");
    const normalizedItemHref = item.href.replace(/\/$/, "");

    if (normalizedItemHref === "/blogs") {
      return currentPath.startsWith("/blogs") || currentPath.startsWith("/blog/");
    }
    if (normalizedItemHref === "/projects") {
      return currentPath.startsWith("/projects");
    }
    if (normalizedItemHref.startsWith("/art/")) {
      return currentPath.startsWith("/art/");
    }
    return currentPath.startsWith(item.href) || normalizedPath.startsWith(normalizedItemHref);
  }
  return currentPath === item.href || currentPath.replace(/\/$/, "") === item.href.replace(/\/$/, "");
};

const isContentActive = currentPath.startsWith("/blogs") || currentPath.startsWith("/blog") || currentPath.startsWith("/projects");
const isArtActive = currentPath.startsWith("/art");
const activeGroup = isContentActive ? "content" : isArtActive ? "art" : "none";
---

<nav
  class:list={[
    "nav-switcher relative flex min-w-0 items-center rounded-full p-0.5",
    isMobile ? "bg-black/5 dark:bg-white/10 text-sm" : "text-base",
  ]}
  data-nav-switcher
  data-active-group={activeGroup}
>
  {navItems.map((item) => {
    const hasChildren = item.children && item.children.length > 0;
    const groupKey = item.label.toLowerCase();
    
    return (
      <>
        {/* Parent Link */}
        <a
          href={item.href}
          data-nav-link
          data-nav-item={hasChildren ? `${groupKey}-parent` : groupKey}
          aria-current={isActive(item) && !hasChildren ? "page" : undefined}
          class:list={[
            "relative z-10 rounded-full leading-none transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-action)] shrink-0 whitespace-nowrap",
            isMobile ? "px-3 py-2.5" : "px-4 py-2.5",
            isActive(item) ? "text-[var(--text-main)]" : "text-[var(--text-muted)] hover:text-[var(--text-main)]",
          ]}
        >
          {item.label}
        </a>

        {/* Children Links */}
        {hasChildren && item.children!.map((child) => (
          <a
            href={child.href}
            data-nav-link
            data-nav-item={`${groupKey}-child`}
            data-parent={groupKey}
            aria-current={isActive(child) ? "page" : undefined}
            class:list={[
              "relative z-10 rounded-full leading-none transition-all duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-action)] shrink-0 whitespace-nowrap",
              isMobile ? "px-3 py-2.5" : "px-4 py-2.5",
              isActive(child) ? "text-[var(--text-main)]" : "text-[var(--text-muted)] hover:text-[var(--text-main)]",
            ]}
          >
            {child.label}
          </a>
        ))}
      </>
    );
  })}
  <span class="nav-switcher-indicator" data-nav-indicator aria-hidden="true"></span>
</nav>

<style>
  /* By default, hide all children links in the switcher */
  [data-nav-item$="-child"] {
    display: none;
  }

  /* When Content group is active: hide Content parent, show Blog & Projects children */
  [data-active-group="content"] [data-nav-item="content-parent"] {
    display: none;
  }
  [data-active-group="content"] [data-nav-item="content-child"] {
    display: inline-flex;
  }

  /* When Art group is active: hide Art parent, show Music, Book & Movie children */
  [data-active-group="art"] [data-nav-item="art-parent"] {
    display: none;
  }
  [data-active-group="art"] [data-nav-item="art-child"] {
    display: inline-flex;
  }

  .nav-switcher-indicator {
    --x: 0px;
    --w: 0px;
    position: absolute;
    left: 0;
    top: 0.25rem;
    bottom: 0.25rem;
    width: var(--w);
    border-radius: 999px;
    background: var(--surface-canvas);
    border: 1px solid var(--border-strong);
    box-shadow: var(--shadow-soft);
    transform: translateX(var(--x));
    opacity: 0;
    transition: 
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      width 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .nav-switcher[data-ready="true"] .nav-switcher-indicator {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-switcher-indicator {
      transition: none !important;
    }
  }
</style>
