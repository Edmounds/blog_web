---
interface Props {
  currentPath?: string;
}

const { currentPath = "/" } = Astro.props;
const particles = Array.from({ length: 44 }, (_, index) => ({
  left: (index * 37 + 11) % 100,
  top: (index * 53 + 7) % 100,
  size: 2 + (index % 4),
  duration: 16 + ((index * 7) % 29),
  delay: -((index * 11) % 31),
}));
const keywords = [
  "Fate",
  "烧肉",
  "烧鹅",
  "肠粉",
  "C++",
  "ROS2",
  "KISS",
  "ubuntu",
  "Linux",
  "天文",
  "AI",
  "Python",
  "音乐",
  "Music",
  "美剧",
  "steam",
  "重庆大学",
  "重庆",
  "CQU",
  "水瓶座",
  "INFP",
];
const drops = Array.from({ length: 60 }, (_, index) => ({
  word: keywords[index % keywords.length],
  left: (index * 43 + 5) % 100,
  size: 12 + ((index * 5) % 11),
  duration: 14 + ((index * 9) % 21),
  delay: -((index * 13) % 34),
  opacity: index % 13 === 0 ? 0.14 : 0.03 + (index % 6) * 0.01,
}));
---

<div
  class="route-background"
  data-route-background
  data-path={currentPath}
  data-nosnippet
  aria-hidden="true"
>
  <div
    class="route-background__layer route-background__particles"
    data-background-kind="particles"
  >
    {
      particles.map((particle) => (
        <span
          style={`--x:${particle.left}%;--y:${particle.top}%;--size:${particle.size}px;--duration:${particle.duration}s;--delay:${particle.delay}s`}
        />
      ))
    }
  </div>

  <div
    class="route-background__layer route-background__grid"
    data-background-kind="grid"
  >
  </div>

  <div
    class="route-background__layer route-background__rain"
    data-background-kind="rain"
  >
    {
      drops.map((drop) => (
        <span
          style={`--word:"${drop.word}";--x:${drop.left}%;--size:${drop.size}px;--duration:${drop.duration}s;--delay:${drop.delay}s;--opacity:${drop.opacity}`}
        />
      ))
    }
  </div>

  <canvas
    class="route-background__layer route-background__constellation"
    data-background-kind="constellation"
    data-density="1"
    data-max-distance="140"
    data-speed="0.22"></canvas>
</div>

<script is:inline define:vars={{ currentPath }}>
  (() => {
    const root = document.currentScript?.previousElementSibling;
    if (!root) return;
    const segments = currentPath.split("/").filter(Boolean);
    if (["en", "ja", "zh-TW"].includes(segments[0])) segments.shift();
    const path =
      `/${segments.join("/")}${currentPath.endsWith("/") && segments.length ? "/" : ""}` ||
      "/";
    const kind = path.startsWith("/admin")
      ? "plain"
      : path === "/links/" || path === "/links"
        ? "constellation"
      : path === "/about/" || path === "/about"
        ? "rain"
        : path === "/art" ||
            path.startsWith("/art/")
          ? "constellation"
          : path === "/blog/" ||
              path === "/blog" ||
              path === "/note/" ||
              path === "/note" ||
              path === "/project/" ||
              path === "/project"
            ? "grid"
            : "particles";
    root.setAttribute("data-active-kind", kind);
  })();
</script>

<script>
  type ConstellationParticle = {
    x: number;
    y: number;
    vx: number;
    vy: number;
    r: number;
    tw: number;
  };

  type RouteBackgroundWindow = Window & {
    __routeBackgroundConstellationCleanup?: () => void;
  };

  const localeSegments = new Set(["en", "ja", "zh-TW"]);
  const reducedMotionQuery = "(prefers-reduced-motion: reduce)";
  const clamp = (value: number, min: number, max: number) =>
    Math.max(min, Math.min(max, value));

  function stripLocale(pathname: string) {
    const segments = pathname.split("/").filter(Boolean);
    if (localeSegments.has(segments[0])) segments.shift();
    return (
      `/${segments.join("/")}${pathname.endsWith("/") && segments.length ? "/" : ""}` ||
      "/"
    );
  }

  function getBackgroundKind(pathname: string) {
    const path = stripLocale(pathname);
    if (path.startsWith("/admin")) return "plain";
    if (path === "/links/" || path === "/links") return "constellation";
    if (path === "/about/" || path === "/about") return "rain";
    if (path === "/art" || path.startsWith("/art/"))
      return "constellation";
    if (
      path === "/blog/" ||
      path === "/blog" ||
      path === "/note/" ||
      path === "/note" ||
      path === "/project/" ||
      path === "/project"
    )
      return "grid";
    return "particles";
  }

  function parseColor(value: string) {
    const normalized = value.trim();
    const rgbMatch = normalized.match(/^rgba?\(([^)]+)\)$/);
    if (rgbMatch) {
      const parts = rgbMatch[1]
        .split(",")
        .map((part) => Number.parseFloat(part.trim()));
      if (parts.length >= 3 && parts.every(Number.isFinite))
        return { r: parts[0], g: parts[1], b: parts[2] };
    }
    if (!normalized.startsWith("#")) return null;
    const hex = normalized.slice(1);
    if (hex.length === 3) {
      return {
        r: Number.parseInt(hex[0] + hex[0], 16),
        g: Number.parseInt(hex[1] + hex[1], 16),
        b: Number.parseInt(hex[2] + hex[2], 16),
      };
    }
    if (hex.length !== 6) return null;
    return {
      r: Number.parseInt(hex.slice(0, 2), 16),
      g: Number.parseInt(hex.slice(2, 4), 16),
      b: Number.parseInt(hex.slice(4, 6), 16),
    };
  }

  function resolveConstellationColor() {
    return (
      parseColor(
        getComputedStyle(document.documentElement).getPropertyValue(
          "--foreground",
        ),
      ) ?? { r: 17, g: 17, b: 17 }
    );
  }

  function initConstellation(root: HTMLElement) {
    const browserWindow = window as RouteBackgroundWindow;
    browserWindow.__routeBackgroundConstellationCleanup?.();

    const canvas = root.querySelector<HTMLCanvasElement>(
      '[data-background-kind="constellation"]',
    );
    const context = canvas?.getContext("2d", { alpha: true });
    if (!canvas || !context) return;

    const controller = new AbortController();
    const reducedMotion = matchMedia(reducedMotionQuery).matches;
    const density = Number(canvas.dataset.density ?? "1");
    const maxDistance = Number(canvas.dataset.maxDistance ?? "140");
    const speed = Number(canvas.dataset.speed ?? "0.22");
    const state = {
      width: 0,
      height: 0,
      particles: [] as ConstellationParticle[],
      frame: 0,
      time: 0,
      ink: resolveConstellationColor(),
      pointer: { x: -1, y: -1, active: false },
    };

    const makeParticle = (): ConstellationParticle => {
      const angle = Math.random() * Math.PI * 2;
      const velocity = (0.35 + Math.random() * 0.75) * speed;
      return {
        x: Math.random() * state.width,
        y: Math.random() * state.height,
        vx: Math.cos(angle) * velocity,
        vy: Math.sin(angle) * velocity,
        r: 0.9 + Math.random() * 1.4,
        tw: Math.random() * Math.PI * 2,
      };
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      const scale = Math.min(2, window.devicePixelRatio || 1);
      state.width = Math.max(1, Math.floor(rect.width));
      state.height = Math.max(1, Math.floor(rect.height));
      canvas.width = Math.floor(state.width * scale);
      canvas.height = Math.floor(state.height * scale);
      context.setTransform(scale, 0, 0, scale, 0, 0);
      const count = clamp(
        Math.floor((state.width * state.height * density) / 16000),
        40,
        140,
      );
      while (state.particles.length < count)
        state.particles.push(makeParticle());
      while (state.particles.length > count) state.particles.pop();
    };

    const draw = (advance = true) => {
      if (advance) state.time += 1;
      context.clearRect(0, 0, state.width, state.height);
      const maxDistanceSquared = maxDistance * maxDistance;

      if (advance) {
        for (const particle of state.particles) {
          particle.x += particle.vx;
          particle.y += particle.vy;
          if (particle.x < 0 || particle.x > state.width) {
            particle.x = clamp(particle.x, 0, state.width);
            particle.vx *= -1;
          }
          if (particle.y < 0 || particle.y > state.height) {
            particle.y = clamp(particle.y, 0, state.height);
            particle.vy *= -1;
          }
        }

        if (state.pointer.active) {
          for (const particle of state.particles) {
            const dx = state.pointer.x - particle.x;
            const dy = state.pointer.y - particle.y;
            const distanceSquared = dx * dx + dy * dy;
            if (distanceSquared > maxDistanceSquared) continue;
            const force =
              (1 - Math.sqrt(distanceSquared) / maxDistance) * 0.018;
            particle.vx += dx * force * 0.0009;
            particle.vy += dy * force * 0.0009;
          }
        }
      }

      context.lineWidth = 1;
      for (let index = 0; index < state.particles.length; index += 1) {
        const first = state.particles[index];
        for (
          let nextIndex = index + 1;
          nextIndex < state.particles.length;
          nextIndex += 1
        ) {
          const second = state.particles[nextIndex];
          const dx = first.x - second.x;
          const dy = first.y - second.y;
          const distanceSquared = dx * dx + dy * dy;
          if (distanceSquared > maxDistanceSquared) continue;
          const alpha = (1 - Math.sqrt(distanceSquared) / maxDistance) * 0.35;
          context.strokeStyle = `rgba(${state.ink.r}, ${state.ink.g}, ${state.ink.b}, ${alpha})`;
          context.beginPath();
          context.moveTo(first.x, first.y);
          context.lineTo(second.x, second.y);
          context.stroke();
        }
      }

      for (const particle of state.particles) {
        const twinkle = (Math.sin(state.time * 0.02 + particle.tw) + 1) / 2;
        const radius = particle.r * (0.75 + twinkle * 0.7);
        const alpha = 0.22 + twinkle * 0.35;
        context.fillStyle = `rgba(${state.ink.r}, ${state.ink.g}, ${state.ink.b}, ${alpha})`;
        context.beginPath();
        context.arc(particle.x, particle.y, radius, 0, Math.PI * 2);
        context.fill();
      }
    };

    const isActive = () =>
      root.dataset.activeKind === "constellation" &&
      document.visibilityState !== "hidden";
    const stop = () => {
      cancelAnimationFrame(state.frame);
      state.frame = 0;
    };
    const tick = () => {
      if (!isActive() || reducedMotion) {
        stop();
        return;
      }
      draw();
      state.frame = requestAnimationFrame(tick);
    };
    const refreshAnimation = () => {
      if (!isActive()) {
        stop();
        return;
      }
      if (reducedMotion) draw(false);
      else if (!state.frame) tick();
    };

    const routeObserver = new MutationObserver(refreshAnimation);
    routeObserver.observe(root, {
      attributes: true,
      attributeFilter: ["data-active-kind"],
    });
    const themeObserver = new MutationObserver(() => {
      state.ink = resolveConstellationColor();
      if (reducedMotion || !state.frame) draw(false);
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class", "data-theme"],
    });

    window.addEventListener(
      "resize",
      () => {
        resize();
        if (reducedMotion || !state.frame) draw(false);
      },
      { passive: true, signal: controller.signal },
    );
    window.addEventListener(
      "pointermove",
      (event) => {
        const rect = canvas.getBoundingClientRect();
        state.pointer.x = event.clientX - rect.left;
        state.pointer.y = event.clientY - rect.top;
        state.pointer.active = true;
      },
      { passive: true, signal: controller.signal },
    );
    window.addEventListener(
      "pointerleave",
      () => {
        state.pointer.active = false;
      },
      { passive: true, signal: controller.signal },
    );
    document.addEventListener("visibilitychange", refreshAnimation, {
      signal: controller.signal,
    });

    resize();
    refreshAnimation();
    browserWindow.__routeBackgroundConstellationCleanup = () => {
      stop();
      routeObserver.disconnect();
      themeObserver.disconnect();
      controller.abort();
    };
  }

  function syncRouteBackground() {
    const root = document.querySelector<HTMLElement>("[data-route-background]");
    if (!root) return;
    root.dataset.path = window.location.pathname;
    root.dataset.activeKind = getBackgroundKind(window.location.pathname);
    return root;
  }

  function initRouteBackground() {
    const root = syncRouteBackground();
    if (root) initConstellation(root);
  }

  initRouteBackground();
  document.addEventListener("astro:page-load", initRouteBackground);
  window.addEventListener("spa:nav-sync", syncRouteBackground);
  window.addEventListener("popstate", syncRouteBackground);
</script>

<style>
  .route-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    color: var(--foreground);
  }

  .route-background__layer {
    position: absolute;
    inset: 0;
    visibility: hidden;
    opacity: 0;
    transition: opacity 240ms ease;
  }

  .route-background[data-active-kind="particles"]
    [data-background-kind="particles"],
  .route-background[data-active-kind="grid"] [data-background-kind="grid"],
  .route-background[data-active-kind="rain"] [data-background-kind="rain"],
  .route-background[data-active-kind="constellation"]
    [data-background-kind="constellation"] {
    visibility: visible;
    opacity: 1;
  }

  .route-background__particles span {
    position: absolute;
    top: var(--y);
    left: var(--x);
    width: var(--size);
    height: var(--size);
    background: color-mix(in srgb, var(--foreground) 24%, transparent);
    border-radius: 50%;
    animation: particle-drift var(--duration) linear var(--delay) infinite;
  }

  html.light .route-background__particles span {
    background: color-mix(in srgb, #7d7d7d 38%, transparent);
  }

  .route-background__grid {
    --grid-size: 24px;
    --grid-major-size: 120px;
    background-color: color-mix(
      in srgb,
      var(--canvas) 98%,
      var(--foreground) 2%
    );
    background-image:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--foreground) 9.5%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--foreground) 9.5%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to right,
        color-mix(in srgb, var(--foreground) 16%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--foreground) 16%, transparent) 1px,
        transparent 1px
      );
    background-size:
      var(--grid-size) var(--grid-size),
      var(--grid-size) var(--grid-size),
      var(--grid-major-size) var(--grid-major-size),
      var(--grid-major-size) var(--grid-major-size);
  }

  html.dark .route-background__grid {
    background-color: #030303;
  }

  .route-background__rain span {
    position: absolute;
    top: -12vh;
    left: var(--x);
    color: var(--foreground);
    font-family: var(--font-mono);
    font-size: var(--size);
    line-height: 1;
    white-space: nowrap;
    opacity: var(--opacity);
    animation: code-rain var(--duration) linear var(--delay) infinite;
  }

  .route-background__rain span::before {
    content: var(--word);
  }

  .route-background__constellation {
    width: 100%;
    height: 100%;
    display: block;
  }

  @keyframes particle-drift {
    from {
      transform: translate3d(0, -10vh, 0);
    }
    to {
      transform: translate3d(1.4rem, 110vh, 0);
    }
  }

  @keyframes code-rain {
    from {
      transform: translate3d(0, -10vh, 0);
    }
    to {
      transform: translate3d(0.6rem, 125vh, 0);
    }
  }

  @media (max-width: 48rem) {
    .route-background__grid {
      --grid-size: 20px;
      --grid-major-size: 100px;
    }

    .route-background__particles span:nth-child(2n),
    .route-background__rain span:nth-child(2n) {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .route-background__particles span,
    .route-background__rain span {
      animation: none;
    }

    .route-background__particles span {
      transform: none;
    }

    .route-background__rain span {
      display: none;
    }
  }

  @media (forced-colors: active) {
    .route-background {
      display: none;
    }
  }
</style>
