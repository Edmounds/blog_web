---
import type { FooterLink } from "../../types/ui";

interface Props {
  brand?: string;
  links?: FooterLink[];
}

const { brand = "Site", links = [] } = Astro.props;

const year = new Date().getFullYear();
---

<footer class="mt-16 border-t border-[var(--border-strong)] bg-[color:color-mix(in_srgb,var(--bg-subtle)_70%,transparent)]">
  <div class="app-container flex flex-col gap-4 py-10 text-sm text-[var(--text-muted)] md:flex-row md:items-center md:justify-between">
    <p>Copyright {year} {brand}. All rights reserved.</p>
    <div class="flex items-center gap-6">
      {links.map((link) => (
        <a href={link.href} class="ui-link ui-link-accent text-sm">
          {link.label}
        </a>
      ))}
    </div>
  </div>
</footer>
