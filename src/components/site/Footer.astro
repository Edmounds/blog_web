---
interface Props {
  brand?: string;
  copyright?: string;
}

const { brand = "Site", copyright = "版权所有。" } = Astro.props;

const year = new Date().getFullYear();
---

<footer class="mt-auto border-t border-[var(--border-soft)] bg-transparent">
  <div class="app-container footer-reveal flex flex-col items-center justify-between gap-3 py-6 text-center text-[var(--type-xs)] text-[var(--foreground-soft)] sm:flex-row sm:text-left">
    <p>@{year} {brand} | {copyright}</p>
    <div class="flex items-center gap-3 text-[var(--text-muted)]">
      <a href="/rss.xml" class="transition-colors hover:text-[var(--foreground)]" aria-label="RSS Feed">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27Zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93Z"/>
        </svg>
      </a>
      <a href="https://github.com/Edmounds" target="_blank" rel="noreferrer" class="transition-colors hover:text-[var(--foreground)]" aria-label="GitHub">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
          <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2Z"/>
        </svg>
      </a>
    </div>
  </div>
</footer>
