---
interface Props {
  brand?: string;
  copyright?: string;
}

const { brand = "Site", copyright = "版权所有。" } = Astro.props;

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-[var(--border-soft)] bg-transparent">
  <div class="app-container footer-reveal flex flex-col items-center justify-center py-7 text-center text-[var(--type-xs)] text-[var(--foreground-soft)] md:items-start md:text-left">
    <p>Copyright {year} {brand}. {copyright}</p>
  </div>
</footer>
