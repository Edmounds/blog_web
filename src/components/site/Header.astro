---
import { routes } from "../../lib/routes";
import type { NavItem } from "../../types/ui";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  currentPath?: string;
  brand?: string;
  navItems?: NavItem[];
}

const { currentPath = "/", brand = "Site", navItems = [] } = Astro.props;

const isActive = (item: NavItem) => {
  if (item.match === "prefix") {
    if (item.href === routes.blogs) {
      return currentPath.startsWith(routes.blogs) || currentPath.startsWith("/blog/");
    }
    return currentPath.startsWith(item.href);
  }
  return currentPath === item.href;
};
---

<header class="sticky top-0 z-50 border-b border-border/80 bg-background/85 backdrop-blur supports-[backdrop-filter]:bg-background/70">
  <div class="app-container flex h-16 items-center justify-between gap-6 md:h-20">
    <a
      href={routes.home}
      class="inline-flex items-center rounded-md font-serif text-xl font-semibold tracking-tight text-foreground transition hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background md:text-2xl"
    >
      {brand}
    </a>

    <div class="hidden items-center gap-3 md:flex">
      <nav class="nav-switcher relative flex items-center rounded-full border border-border bg-card/70 p-1 text-sm shadow-sm" data-nav-switcher>
        {navItems.map((item) => (
          <a
            href={item.href}
            data-nav-link
            aria-current={isActive(item) ? "page" : undefined}
            class:list={[
              "relative z-10 rounded-full px-3 py-1.5 font-medium transition duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background",
              isActive(item) ? "text-primary" : "text-muted-foreground hover:text-foreground",
            ]}
          >
            {item.label}
          </a>
        ))}
        <span class="nav-switcher-indicator" data-nav-indicator aria-hidden="true"></span>
      </nav>
      <ThemeToggle />
    </div>
  </div>

  <div class="app-container flex items-center justify-between gap-4 pb-4 md:hidden">
    <nav class="nav-switcher relative flex items-center rounded-full border border-border bg-card/70 p-1 text-xs font-medium uppercase tracking-wider shadow-sm" data-nav-switcher>
      {navItems.map((item) => (
        <a
          href={item.href}
          data-nav-link
          aria-current={isActive(item) ? "page" : undefined}
          class:list={[
            "relative z-10 rounded-full px-2.5 py-1.5 transition duration-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background",
            isActive(item) ? "text-primary" : "text-muted-foreground hover:text-foreground",
          ]}
        >
          {item.label}
        </a>
      ))}
      <span class="nav-switcher-indicator" data-nav-indicator aria-hidden="true"></span>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .nav-switcher-indicator {
    --x: 0px;
    --w: 0px;
    position: absolute;
    left: 0;
    top: 0.25rem;
    bottom: 0.25rem;
    width: var(--w);
    border-radius: 999px;
    background: var(--muted);
    transform: translateX(var(--x));
    transition:
      transform 320ms cubic-bezier(0.22, 1, 0.36, 1),
      width 320ms cubic-bezier(0.22, 1, 0.36, 1),
      opacity 220ms ease;
    opacity: 0;
    box-shadow: inset 0 0 0 1px var(--border);
  }

  .nav-switcher[data-ready="true"] .nav-switcher-indicator {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-switcher-indicator {
      transition: none;
    }
  }
</style>

<script>
  const navSwitchers = Array.from(document.querySelectorAll<HTMLElement>("[data-nav-switcher]"));

  const bindSwitcher = (switcher: HTMLElement) => {
    const links = Array.from(switcher.querySelectorAll<HTMLElement>("[data-nav-link]"));
    const indicator = switcher.querySelector<HTMLElement>("[data-nav-indicator]");
    if (!links.length || !indicator) return;

    const active = () => links.find((link) => link.getAttribute("aria-current") === "page") ?? links[0];

    const moveTo = (link: HTMLElement) => {
      indicator.style.setProperty("--x", `${link.offsetLeft}px`);
      indicator.style.setProperty("--w", `${link.offsetWidth}px`);
      switcher.setAttribute("data-ready", "true");
    };

    const reset = () => moveTo(active());

    reset();
    window.addEventListener("resize", reset, { passive: true });

    links.forEach((link) => {
      link.addEventListener("pointerenter", () => moveTo(link));
      link.addEventListener("focus", () => moveTo(link));
    });

    switcher.addEventListener("pointerleave", reset);
    switcher.addEventListener("focusout", () => {
      requestAnimationFrame(() => {
        if (!switcher.contains(document.activeElement)) reset();
      });
    });
  };

  navSwitchers.forEach((switcher) => bindSwitcher(switcher));
</script>
