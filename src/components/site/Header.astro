---
import { routes } from "../../lib/routes";
import type { NavItem } from "../../types/ui";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  currentPath?: string;
  brand?: string;
  navItems?: NavItem[];
}

const { currentPath = "/", brand = "Site", navItems = [] } = Astro.props;

const isActive = (item: NavItem) => {
  if (item.match === "prefix") {
    if (item.href === routes.blogs) {
      return currentPath.startsWith(routes.blogs) || currentPath.startsWith("/blog/");
    }
    return currentPath.startsWith(item.href);
  }
  return currentPath === item.href;
};
---

<header class="sticky top-0 z-50 border-b border-[var(--border-strong)] bg-[color:color-mix(in_srgb,var(--bg-base)_90%,transparent)] backdrop-blur-md">
  <div class="app-container flex h-20 items-center justify-between gap-6">
    <a href={routes.home} class="font-serif text-2xl tracking-tight text-[var(--text-main)] transition hover:text-[var(--accent)]">
      {brand}
    </a>

    <div class="hidden items-center gap-8 md:flex">
      <nav class="flex items-center gap-7 text-sm">
        {navItems.map((item) => (
          <a
            href={item.href}
            class:list={[
              "transition",
              isActive(item) ? "text-[var(--text-main)]" : "text-[var(--text-muted)] hover:text-[var(--text-main)]",
            ]}
          >
            {item.label}
          </a>
        ))}
      </nav>
      <ThemeToggle />
    </div>
  </div>

  <div class="app-container flex items-center justify-between gap-4 pb-4 md:hidden">
    <nav class="flex items-center gap-4 text-xs uppercase tracking-wider">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            "transition",
            isActive(item) ? "text-[var(--text-main)]" : "text-[var(--text-muted)]",
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <ThemeToggle />
  </div>
</header>
