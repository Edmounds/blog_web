<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[color:color-mix(in_srgb,var(--bg)_85%,transparent)] backdrop-blur">
  <div class="mx-auto flex h-18 w-full max-w-6xl items-center justify-between px-6">
    <a href="/" class="font-serif text-2xl tracking-tight text-[var(--text)] transition hover:text-[var(--accent)]">
      Alex 的博客
    </a>
    <nav class="hidden items-center gap-7 text-sm text-[var(--muted)] md:flex">
      <a href="/" class="transition hover:text-[var(--text)]">首页</a>
      <a href="/blogs/" class="transition hover:text-[var(--text)]">博客</a>
      <a href="/projects/" class="transition hover:text-[var(--text)]">项目</a>
      <a href="/about/" class="transition hover:text-[var(--text)]">关于我</a>
    </nav>
    <button
      id="theme-toggle"
      class="panel rounded-full px-4 py-2 text-xs tracking-wide text-[var(--text)] transition hover:border-[var(--accent)]"
      type="button"
      aria-label="切换主题"
    >
      切换主题
    </button>
  </div>
</header>

<script>
  import { readTheme, toggleTheme } from "../../lib/theme";

  const btn = document.getElementById("theme-toggle");
  const render = () => {
    const isDark = document.documentElement.classList.contains("dark");
    if (btn) btn.textContent = isDark ? "浅色模式" : "深色模式";
  };

  render();
  window.addEventListener("storage", render);
  btn?.addEventListener("click", () => {
    toggleTheme();
    render();
  });

  const current = readTheme();
  document.documentElement.classList.toggle("dark", current === "dark");
</script>
