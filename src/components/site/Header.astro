---
import { Menu, X } from "lucide-static";

import { localizePath, stripLocaleFromPath, type Locale } from "../../lib/i18n";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSelector from "./LanguageSelector.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  currentPath?: string;
  locale?: Locale;
  languageLabel?: string;
}

const { currentPath = "/", locale = "zh-CN", languageLabel = "Select language" } = Astro.props;
const routePath = stripLocaleFromPath(currentPath).pathname;
const primary = [
  { label: "About", href: "/about/" },
  { label: "Blog", href: "/blog/" },
  { label: "Note", href: "/note/" },
  { label: "Project", href: "/project/" },
];
const life = [
  { label: "Books", href: "/art/book/" },
  { label: "Music", href: "/art/music/" },
  { label: "Screen", href: "/art/screen/" },
  { label: "Game", href: "/art/game/" },
];
const isActive = (href: string) => routePath === href || routePath.startsWith(href)
  || (href === "/art/screen/" && ["/art/movie/", "/art/series/", "/art/anime/"].some((path) => routePath.startsWith(path)));
---

<header class="site-header" data-site-header>
  <div class="site-header__inner app-container">
    <a class="site-signature" href={localizePath("/", locale)} data-primary-route data-astro-prefetch="viewport" aria-label="Lust4ev3r home">Lust4ev3r</a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      {primary.map((item) => (
        <a href={localizePath(item.href, locale)} data-primary-route data-astro-prefetch="viewport" aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
      <div class="life-menu">
        <button type="button" aria-haspopup="true" aria-expanded="false" data-life-trigger>Life</button>
        <div class="life-menu__items" data-life-menu>
          {life.map((item) => <a href={localizePath(item.href, locale)} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>)}
        </div>
      </div>
    </nav>

    <div class="site-header__tools">
      <LanguageSelector locale={locale} currentPath={currentPath} label={languageLabel} />
      <ThemeToggle />
      <button class="mobile-menu-button" type="button" aria-label="Open menu" aria-expanded="false" data-mobile-menu-trigger>
        <span class="menu-open-icon"><Icon svg={Menu} /></span>
        <span class="menu-close-icon"><Icon svg={X} /></span>
      </button>
    </div>
  </div>

  <nav class="mobile-menu" aria-label="Mobile navigation" data-mobile-menu hidden>
    <div class="app-container mobile-menu__inner">
      {primary.map((item) => (
        <a href={localizePath(item.href, locale)} data-primary-route data-astro-prefetch="viewport" aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>
      ))}
      <details>
        <summary>Life</summary>
        <div>
          {life.map((item) => <a href={localizePath(item.href, locale)} aria-current={isActive(item.href) ? "page" : undefined}>{item.label}</a>)}
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  function bindHeader() {
    const header = document.querySelector('[data-site-header]');
    if (!(header instanceof HTMLElement) || header.dataset.bound === "true") return;
    header.dataset.bound = "true";
    const mobileTrigger = header.querySelector('[data-mobile-menu-trigger]');
    const mobileMenu = header.querySelector('[data-mobile-menu]');
    const lifeTrigger = header.querySelector('[data-life-trigger]');
    const lifeMenu = header.querySelector('[data-life-menu]');

    const closeMobile = () => {
      if (!(mobileTrigger instanceof HTMLButtonElement) || !(mobileMenu instanceof HTMLElement)) return;
      mobileTrigger.setAttribute("aria-expanded", "false");
      mobileTrigger.setAttribute("aria-label", "Open menu");
      mobileMenu.hidden = true;
    };
    const closeLife = () => {
      lifeTrigger?.setAttribute("aria-expanded", "false");
      if (lifeMenu instanceof HTMLElement) lifeMenu.dataset.open = "false";
    };
    mobileTrigger?.addEventListener("click", () => {
      if (!(mobileTrigger instanceof HTMLButtonElement) || !(mobileMenu instanceof HTMLElement)) return;
      const open = mobileTrigger.getAttribute("aria-expanded") !== "true";
      mobileTrigger.setAttribute("aria-expanded", String(open));
      mobileTrigger.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      mobileMenu.hidden = !open;
    });
    mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMobile));
    lifeTrigger?.addEventListener("click", () => {
      if (!(lifeTrigger instanceof HTMLButtonElement) || !(lifeMenu instanceof HTMLElement)) return;
      const open = lifeTrigger.getAttribute("aria-expanded") !== "true";
      lifeTrigger.setAttribute("aria-expanded", String(open));
      lifeMenu.dataset.open = String(open);
    });
    document.addEventListener("pointerdown", (event) => {
      if (!lifeMenu?.parentElement?.contains(event.target as Node)) {
        closeLife();
      }
    });
    header.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        closeMobile();
        closeLife();
        if (lifeTrigger instanceof HTMLButtonElement) lifeTrigger.focus();
      }
    });
  }
  bindHeader();
  document.addEventListener("astro:page-load", bindHeader);
</script>

<style>
  .site-header { position: sticky; top: 0; z-index: 50; color: var(--foreground); background: var(--canvas); }
  .site-header__inner { display: grid; grid-template-columns: 1fr auto 1fr; min-height: 4.5rem; align-items: center; gap: 1rem; }
  @font-face { font-family: "Site Signature"; src: url("/fonts/Allura-Lust4ev3r.woff") format("woff"); font-weight: 400; font-display: swap; }
  .site-signature { display: flex; width: min(100%, clamp(10.5rem, 34vw, 23.75rem)); min-height: clamp(2.75rem, 7vh, 4rem); align-items: flex-end; justify-self: start; color: var(--foreground); font-family: "Site Signature", cursive; font-size: clamp(2.75rem, 2.46rem + 0.92vw, 3.55rem); font-weight: 400; line-height: 0.78; text-decoration: none; white-space: nowrap; }
  .desktop-nav { display: flex; align-items: center; gap: clamp(1rem, 2vw, 2rem); }
  .desktop-nav > a, .life-menu > button { color: var(--text-muted); font: inherit; font-size: var(--type-base); text-decoration: none; background: none; border: 0; cursor: pointer; }
  .life-menu__items a { color: var(--text-muted); font-size: var(--type-sm); text-decoration: none; }
  .desktop-nav :is(a, button):hover, .desktop-nav a[aria-current="page"] { color: var(--foreground); }
  .life-menu { position: relative; }
  .life-menu__items { position: absolute; top: 100%; left: 50%; display: grid; min-width: 7rem; gap: 0.45rem; padding-top: 0.75rem; visibility: hidden; opacity: 0; transform: translateX(-50%) translateY(-0.25rem); transition: opacity 160ms ease, transform 160ms ease; pointer-events: none; }
  .life-menu__items[data-open="true"], .life-menu:hover .life-menu__items, .life-menu:focus-within .life-menu__items { visibility: visible; opacity: 1; transform: translateX(-50%) translateY(0); pointer-events: auto; }
  .life-menu__items a { padding: 0.2rem 0; text-align: center; white-space: nowrap; }
  .site-header__tools { display: flex; justify-self: end; align-items: center; gap: 0.35rem; }
  :global(.site-header__tools [data-language-trigger]), :global(.site-header__tools [data-theme-toggle]) { border-color: transparent; background: transparent; }
  .mobile-menu-button { display: none; width: 2.75rem; height: 2.75rem; align-items: center; justify-content: center; color: var(--foreground); background: transparent; border: 0; }
  .mobile-menu-button :global(svg) { width: 1.3rem; height: 1.3rem; }
  .mobile-menu-button[aria-expanded="false"] .menu-close-icon, .mobile-menu-button[aria-expanded="true"] .menu-open-icon { display: none; }
  .mobile-menu { background: var(--canvas); }
  .mobile-menu__inner { display: grid; padding-block: 1rem 1.5rem; }
  .mobile-menu a, .mobile-menu summary { padding: 0.75rem 0; color: var(--foreground); font-size: var(--type-lg); text-decoration: none; list-style: none; }
  .mobile-menu details div { display: grid; padding-left: 1.25rem; }
  .mobile-menu details div a { color: var(--text-muted); font-size: var(--type-base); }
  @media (max-width: 48rem) {
    .site-header__inner { grid-template-columns: 1fr auto; min-height: 4rem; }
    .desktop-nav { display: none; }
    .mobile-menu-button { display: inline-flex; }
    .site-signature { width: min(100%, clamp(10.5rem, 34vw, 23.75rem)); font-size: clamp(2.4rem, 2rem + 1.7vw, 2.85rem); }
  }
  @media (prefers-reduced-motion: reduce) { .life-menu__items { transition: none; } }
</style>
