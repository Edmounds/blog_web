---
import { Menu, X } from "lucide-static";

import { localizePath, stripLocaleFromPath, type Locale } from "../../lib/i18n";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSelector from "./LanguageSelector.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  currentPath?: string;
  locale?: Locale;
  languageLabel?: string;
}

const {
  currentPath = "/",
  locale = "zh-CN",
  languageLabel = "Select language",
} = Astro.props;
const routePath = stripLocaleFromPath(currentPath).pathname;
const primary = [
  { label: "Blog", href: "/blog/", primaryRoute: true },
  { label: "Note", href: "/note/", primaryRoute: true },
  { label: "Links", href: "/links/", primaryRoute: false },
  { label: "About", href: "/about/", primaryRoute: true },
];
const life = [
  { label: "Books", href: "/art/book/" },
  { label: "Music", href: "/art/music/" },
  { label: "Screen", href: "/art/screen/" },
  { label: "Game", href: "/art/game/" },
];
const isActive = (href: string) =>
  routePath === href ||
  routePath.startsWith(href) ||
  (href === "/art/screen/" &&
    ["/art/movie/", "/art/series/", "/art/anime/"].some((path) =>
      routePath.startsWith(path),
    ));
---

<header class="site-header" data-site-header>
  <div class="site-header__inner app-container">
    <a
      class="site-signature"
      href={localizePath("/", locale)}
      data-content-frame-start
      data-primary-route
      aria-label="Last4ev3r home"
    >
      <img
        class="site-signature__mark"
        data-site-signature-mark
        src="/images/site-signature.svg?v=1"
        width="3409"
        height="775"
        alt=""
        decoding="sync"
        fetchpriority="high"
      />
    </a>

    <div class="desktop-nav-region" data-desktop-nav-region>
      <nav
        class="desktop-nav"
        data-desktop-nav
        data-hidden="false"
        aria-label="Primary navigation"
      >
        {
          primary.map((item) => (
            <a
              href={localizePath(item.href, locale)}
              data-primary-route={item.primaryRoute ? true : undefined}
              aria-current={isActive(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
        <div class="life-menu">
          <button
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            data-life-trigger>Life</button
          >
          <div class="life-menu__items" data-life-menu>
            {
              life.map((item) => (
                <a
                  href={localizePath(item.href, locale)}
                  aria-current={isActive(item.href) ? "page" : undefined}
                >
                  {item.label}
                </a>
              ))
            }
          </div>
        </div>
      </nav>
    </div>

    <div class="site-header__tools" data-content-frame-end>
      <LanguageSelector
        locale={locale}
        currentPath={currentPath}
        label={languageLabel}
      />
      <ThemeToggle />
      <button
        class="mobile-menu-button"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        data-mobile-menu-trigger
      >
        <span class="menu-open-icon"><Icon svg={Menu} /></span>
        <span class="menu-close-icon"><Icon svg={X} /></span>
      </button>
    </div>
  </div>

  <nav
    class="mobile-menu"
    aria-label="Mobile navigation"
    data-mobile-menu
    hidden
  >
    <div class="app-container mobile-menu__inner">
      {
        primary.map((item) => (
          <a
            href={localizePath(item.href, locale)}
            data-primary-route={item.primaryRoute ? true : undefined}
            aria-current={isActive(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <details>
        <summary>Life</summary>
        <div>
          {
            life.map((item) => (
              <a
                href={localizePath(item.href, locale)}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  type HeaderWindow = Window & { __siteHeaderCleanup?: () => void };

  function bindHeader() {
    const headerWindow = window as HeaderWindow;
    headerWindow.__siteHeaderCleanup?.();

    const header = document.querySelector("[data-site-header]");
    if (!(header instanceof HTMLElement)) return;

    const controller = new AbortController();
    const { signal } = controller;
    const mobileTrigger = header.querySelector("[data-mobile-menu-trigger]");
    const mobileMenu = header.querySelector("[data-mobile-menu]");
    const desktopNavRegion = header.querySelector("[data-desktop-nav-region]");
    const desktopNav = header.querySelector("[data-desktop-nav]");
    const frameStart = header.querySelector("[data-content-frame-start]");
    const signatureMark = header.querySelector("[data-site-signature-mark]");
    const frameEnd = header.querySelector("[data-content-frame-end]");
    const lifeTrigger = header.querySelector("[data-life-trigger]");
    const lifeMenu = header.querySelector("[data-life-menu]");
    const desktopLayout = matchMedia("(min-width: 64.0625rem)");
    if (
      !(desktopNavRegion instanceof HTMLElement) ||
      !(desktopNav instanceof HTMLElement) ||
      !(frameStart instanceof HTMLElement) ||
      !(signatureMark instanceof HTMLImageElement) ||
      !(frameEnd instanceof HTMLElement)
    )
      return;

    let pointerInsideNavRegion = false;
    let frameId = 0;

    const clearContentFrame = () => {
      document.documentElement.style.removeProperty(
        "--content-frame-inline-start",
      );
      document.documentElement.style.removeProperty(
        "--content-frame-inline-end",
      );
    };
    const syncContentFrame = () => {
      frameId = 0;
      if (!desktopLayout.matches) {
        clearContentFrame();
        return;
      }

      const markRect = signatureMark.getBoundingClientRect();
      const endRect = frameEnd.getBoundingClientRect();
      const viewportWidth = document.documentElement.clientWidth;
      const inlineStart = markRect.right;
      const inlineEnd = viewportWidth - endRect.left;

      if (inlineStart >= endRect.left) {
        clearContentFrame();
        return;
      }
      document.documentElement.style.setProperty(
        "--content-frame-inline-start",
        `${inlineStart}px`,
      );
      document.documentElement.style.setProperty(
        "--content-frame-inline-end",
        `${inlineEnd}px`,
      );
    };
    const scheduleContentFrame = () => {
      if (signal.aborted) return;
      if (frameId) cancelAnimationFrame(frameId);
      frameId = requestAnimationFrame(syncContentFrame);
    };
    const frameObserver = new ResizeObserver(scheduleContentFrame);
    frameObserver.observe(frameStart);
    frameObserver.observe(signatureMark);
    frameObserver.observe(frameEnd);
    frameObserver.observe(header);
    const lifeIsOpen = () =>
      lifeTrigger?.getAttribute("aria-expanded") === "true";
    const navHasFocus = () => desktopNav.contains(document.activeElement);
    const setHidden = (hidden: boolean) => {
      const nextHidden =
        hidden &&
        desktopLayout.matches &&
        window.scrollY > 0 &&
        !lifeIsOpen() &&
        !pointerInsideNavRegion &&
        !navHasFocus();
      desktopNav.dataset.hidden = String(nextHidden);
    };
    const syncAfterMenuChange = () =>
      requestAnimationFrame(() => {
        setHidden(window.scrollY > 0);
      });

    const closeMobile = () => {
      if (
        !(mobileTrigger instanceof HTMLButtonElement) ||
        !(mobileMenu instanceof HTMLElement)
      )
        return;
      mobileTrigger.setAttribute("aria-expanded", "false");
      mobileTrigger.setAttribute("aria-label", "Open menu");
      mobileMenu.hidden = true;
      syncAfterMenuChange();
    };
    const closeLife = () => {
      lifeTrigger?.setAttribute("aria-expanded", "false");
      if (lifeMenu instanceof HTMLElement) lifeMenu.dataset.open = "false";
      syncAfterMenuChange();
    };
    mobileTrigger?.addEventListener(
      "click",
      () => {
        if (
          !(mobileTrigger instanceof HTMLButtonElement) ||
          !(mobileMenu instanceof HTMLElement)
        )
          return;
        const open = mobileTrigger.getAttribute("aria-expanded") !== "true";
        mobileTrigger.setAttribute("aria-expanded", String(open));
        mobileTrigger.setAttribute(
          "aria-label",
          open ? "Close menu" : "Open menu",
        );
        mobileMenu.hidden = !open;
      },
      { signal },
    );
    mobileMenu
      ?.querySelectorAll("a")
      .forEach((link) =>
        link.addEventListener("click", closeMobile, { signal }),
      );
    lifeTrigger?.addEventListener(
      "click",
      () => {
        if (
          !(lifeTrigger instanceof HTMLButtonElement) ||
          !(lifeMenu instanceof HTMLElement)
        )
          return;
        const open = lifeTrigger.getAttribute("aria-expanded") !== "true";
        lifeTrigger.setAttribute("aria-expanded", String(open));
        lifeMenu.dataset.open = String(open);
        setHidden(false);
      },
      { signal },
    );
    document.addEventListener(
      "pointerdown",
      (event) => {
        if (!lifeMenu?.parentElement?.contains(event.target as Node)) {
          closeLife();
        }
      },
      { signal },
    );
    header.addEventListener(
      "keydown",
      (event) => {
        if (event.key === "Escape") {
          closeMobile();
          closeLife();
          if (lifeTrigger instanceof HTMLButtonElement) lifeTrigger.focus();
        }
      },
      { signal },
    );
    desktopNav.addEventListener("focusin", () => setHidden(false), { signal });
    desktopNav.addEventListener("focusout", syncAfterMenuChange, { signal });
    desktopNavRegion.addEventListener(
      "pointerenter",
      () => {
        pointerInsideNavRegion = true;
        setHidden(false);
      },
      { signal },
    );
    desktopNavRegion.addEventListener(
      "pointerleave",
      () => {
        pointerInsideNavRegion = false;
        setHidden(window.scrollY > 0);
      },
      { signal },
    );
    window.addEventListener(
      "scroll",
      () => {
        const currentScrollY = window.scrollY;
        if (
          currentScrollY <= 0 ||
          lifeIsOpen() ||
          pointerInsideNavRegion ||
          navHasFocus()
        )
          setHidden(false);
        else setHidden(true);
      },
      { passive: true, signal },
    );
    window.addEventListener("resize", scheduleContentFrame, {
      passive: true,
      signal,
    });
    window.visualViewport?.addEventListener("resize", scheduleContentFrame, {
      passive: true,
      signal,
    });
    desktopLayout.addEventListener(
      "change",
      () => {
        setHidden(window.scrollY > 0);
        scheduleContentFrame();
      },
      { signal },
    );

    setHidden(window.scrollY > 0);
    scheduleContentFrame();
    const cleanup = () => {
      controller.abort();
      frameObserver.disconnect();
      if (frameId) cancelAnimationFrame(frameId);
    };
    document.addEventListener("astro:before-swap", cleanup, {
      once: true,
      signal,
    });
    headerWindow.__siteHeaderCleanup = cleanup;
  }
  bindHeader();
  document.addEventListener("astro:page-load", bindHeader);
</script>

<style>
  .site-header {
    --life-submenu-gap: clamp(0.75rem, 1.5vw, 1.5rem);
    --life-submenu-color: var(--text-faint);
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--foreground);
    background: transparent;
  }
  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    min-height: 4.5rem;
    align-items: center;
    gap: 1rem;
    padding-top: 1rem;
  }
  .site-signature {
    display: flex;
    width: min(100%, clamp(10.5rem, 34vw, 23.75rem));
    min-height: clamp(2.75rem, 7vh, 4rem);
    align-items: flex-end;
    justify-self: start;
    color: var(--foreground);
    text-decoration: none;
  }
  .site-signature__mark {
    display: block;
    width: min(100%, calc(3.5rem * 3.411));
    height: auto;
  }
  :global(html.dark) .site-signature__mark {
    filter: invert(1);
  }
  .desktop-nav {
    --desktop-nav-gap: clamp(0.75rem, 1.5vw, 1.5rem);
    display: flex;
    align-items: center;
    gap: var(--desktop-nav-gap);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 180ms ease;
  }
  .desktop-nav-region {
    display: flex;
    align-self: stretch;
    align-items: center;
  }
  .desktop-nav[data-hidden="true"] {
    visibility: hidden;
    opacity: 0;
    transform: translateY(-100%);
    pointer-events: none;
  }
  .desktop-nav > a,
  .life-menu > button,
  .life-menu__items a {
    color: var(--text-muted);
    font-family: var(--font-ui);
    font-size: var(--type-lg);
    font-weight: 400;
    line-height: 1.25;
    text-decoration: none;
  }
  .life-menu > button {
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .desktop-nav :is(a, button):hover,
  .desktop-nav a[aria-current="page"] {
    color: var(--foreground);
  }
  .life-menu {
    position: relative;
  }
  .life-menu__items {
    position: absolute;
    top: 50%;
    left: 100%;
    display: flex;
    align-items: center;
    gap: var(--life-submenu-gap);
    width: max-content;
    padding-left: var(--life-submenu-gap);
    visibility: hidden;
    opacity: 0;
    transform: translate(-0.25rem, -50%);
    transition:
      opacity 160ms ease,
      transform 160ms ease;
    pointer-events: none;
    white-space: nowrap;
  }
  .life-menu__items[data-open="true"],
  .life-menu:hover .life-menu__items,
  .life-menu:focus-within .life-menu__items {
    visibility: visible;
    opacity: 1;
    transform: translate(0, -50%);
    pointer-events: auto;
  }
  .life-menu__items a {
    padding: 0.2rem 0;
    color: var(--life-submenu-color);
    font-size: var(--type-base);
    text-align: left;
  }
  .site-header__tools {
    display: flex;
    justify-self: end;
    align-items: center;
    gap: 0.35rem;
  }
  :global(.site-header__tools [data-language-trigger]),
  :global(.site-header__tools [data-theme-toggle]) {
    border-color: transparent;
    background: transparent;
  }
  .mobile-menu-button {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    color: var(--foreground);
    background: transparent;
    border: 0;
  }
  .mobile-menu-button :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }
  .mobile-menu-button[aria-expanded="false"] .menu-close-icon,
  .mobile-menu-button[aria-expanded="true"] .menu-open-icon {
    display: none;
  }
  .mobile-menu {
    background: var(--canvas);
  }
  .mobile-menu__inner {
    display: grid;
    padding-block: 1rem 1.5rem;
  }
  .mobile-menu a,
  .mobile-menu summary {
    padding: 0.75rem 0;
    color: var(--foreground);
    font-size: var(--type-lg);
    text-decoration: none;
    list-style: none;
  }
  .mobile-menu details div {
    display: grid;
    padding-left: 1.25rem;
  }
  .mobile-menu details div a {
    color: var(--text-muted);
    font-size: var(--type-base);
  }
  @media (min-width: 64.0625rem) and (max-width: 78rem) {
    .life-menu__items {
      top: 100%;
      left: 0;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--life-submenu-gap);
      padding-top: var(--life-submenu-gap);
      padding-left: 0;
      transform: translateY(-0.25rem);
    }
    .life-menu__items[data-open="true"],
    .life-menu:hover .life-menu__items,
    .life-menu:focus-within .life-menu__items {
      transform: translateY(0);
    }
  }
  @media (max-width: 64rem) {
    .site-header {
      background: var(--canvas);
      border-bottom: 1px solid var(--border-soft);
    }
    .site-header__inner {
      grid-template-columns: minmax(0, 1fr) auto;
      min-height: 4rem;
      padding-top: 0;
    }
    .desktop-nav-region {
      display: none;
    }
    .mobile-menu-button {
      display: inline-flex;
    }
    .site-signature {
      width: min(100%, 10.5rem);
      transform: translateY(-0.625rem);
    }
    .site-signature__mark {
      width: min(100%, calc(2.6rem * 3.411));
    }
  }
  @media (max-width: 30rem) {
    .site-header__inner {
      gap: 0.35rem;
    }
    .site-header__tools {
      gap: 0;
    }
    :global(.site-header__tools [data-language-trigger]),
    :global(.site-header__tools [data-theme-toggle]),
    .mobile-menu-button {
      width: 2.5rem;
      height: 2.5rem;
    }
    .site-signature {
      width: min(100%, 8.75rem);
    }
    .site-signature__mark {
      width: min(100%, calc(2.15rem * 3.411));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .desktop-nav,
    .life-menu__items {
      transition: none;
    }
  }
</style>
