---
import { routes } from "../../lib/routes";
import type { NavItem } from "../../types/ui";
import NavMotionController from "./NavMotionController";
import NavSwitcher from "./NavSwitcher.astro";
import ThemeToggle from "./ThemeToggle.astro";
import LanguageSelector from "./LanguageSelector.astro";
import type { Locale } from "../../lib/i18n";

interface Props {
  currentPath?: string;
  brand?: string;
  navItems?: NavItem[];
  locale?: Locale;
  languageLabel?: string;
}

const { currentPath = "/", navItems = [], locale = "zh-CN", languageLabel = "选择语言" } = Astro.props;

const isHomeServer = currentPath === "/" || currentPath === "";
---

<header id="site-header" class={`sticky top-0 z-50 bg-[var(--nav-bg)] text-[var(--text-main)] backdrop-blur-md border-b border-[var(--border-soft)] dark:border-transparent transition-all duration-300 ${isHomeServer ? 'is-homepage' : ''}`}>
  <div class="app-container flex h-16 items-center justify-between gap-4 md:gap-8">
    <div class="flex flex-1 items-center justify-start min-w-0">
      <a
        href={routes.home}
        data-page-transition-link
        class="shrink-0 inline-flex min-w-0 items-center rounded-sm text-base font-normal leading-none text-[var(--text-main)] transition hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-action)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-base)]"
      >
      </a>
    </div>

    <div class="hidden flex-1 items-center justify-end gap-3 md:flex">
      <NavSwitcher currentPath={currentPath} navItems={navItems} />
      <div class="hidden md:block">
        <LanguageSelector locale={locale} currentPath={currentPath} label={languageLabel} />
      </div>
      <ThemeToggle />
    </div>
  </div>

  <div class="app-container flex min-h-16 items-center gap-3 border-t border-[var(--border-soft)] py-2 md:hidden">
    <div
      class="mobile-nav-scroll min-w-0 flex-1 overflow-x-auto overscroll-x-contain"
      data-mobile-nav-scroll
      tabindex="0"
      aria-label={locale === "zh-CN" ? "主导航" : "Primary navigation"}
    >
      <NavSwitcher currentPath={currentPath} navItems={navItems} variant="mobile" />
    </div>
    <div class="flex shrink-0 items-center gap-2">
      <LanguageSelector locale={locale} currentPath={currentPath} label={languageLabel} />
      <ThemeToggle />
    </div>
  </div>
  <NavMotionController client:load />
</header>

<script>
  function updateHeaderStyle() {
    const header = document.getElementById('site-header');
    if (!header) return;

    const isHome = window.location.pathname === '/' || window.location.pathname === '';
    header.classList.toggle('is-homepage', isHome);
  }

  updateHeaderStyle();

  document.addEventListener('astro:page-load', updateHeaderStyle);
  window.addEventListener('spa:nav-sync', updateHeaderStyle);
  window.addEventListener('popstate', updateHeaderStyle);
</script>

<style is:global>
  @keyframes headerSlideDown {
    from {
      opacity: 0;
      transform: translateY(-8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  .animate-slide-down {
    animation: headerSlideDown 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .mobile-nav-scroll {
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }
  .mobile-nav-scroll::-webkit-scrollbar {
    display: none;
  }
  @media (min-width: 768px) {
    #site-header.is-homepage {
      position: absolute !important;
      width: 100% !important;
      left: 0 !important;
      right: 0 !important;
      background-color: transparent !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      border-color: transparent !important;
    }
    #site-header.is-homepage * {
      border-color: transparent !important;
    }
  }
</style>
