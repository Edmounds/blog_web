---
import { Search, X } from "lucide-static";

import { type Locale } from "../../lib/i18n";
import Icon from "../ui/Icon.astro";

interface Props {
  locale?: Locale;
}

const { locale = "zh-CN" } = Astro.props;

const i18nConfig = {
  "zh-CN": {
    title: "搜索",
    placeholder: "搜索文章、项目、笔记...",
    empty: "未找到相关内容",
    loading: "正在检索...",
    badges: { blog: "Blog", project: "Project", note: "Note" },
  },
  "zh-TW": {
    title: "搜尋",
    placeholder: "搜尋文章、專案、筆記...",
    empty: "未找到相符內容",
    loading: "正在檢索...",
    badges: { blog: "Blog", project: "Project", note: "Note" },
  },
  en: {
    title: "Search",
    placeholder: "Search blogs, projects, notes...",
    empty: "No matching results",
    loading: "Searching...",
    badges: { blog: "Blog", project: "Project", note: "Note" },
  },
  ja: {
    title: "検索",
    placeholder: "記事、プロジェクト、ノートを検索...",
    empty: "該当する結果がありません",
    loading: "検索中...",
    badges: { blog: "Blog", project: "Project", note: "Note" },
  },
}[locale] ?? {
  title: "搜索",
  placeholder: "搜索文章、项目、笔记...",
  empty: "未找到相关内容",
  loading: "正在检索...",
  badges: { blog: "Blog", project: "Project", note: "Note" },
};
---

<div
  class="global-search"
  data-global-search
  data-locale={locale}
  data-empty-label={i18nConfig.empty}
  data-loading-label={i18nConfig.loading}
  data-badge-blog={i18nConfig.badges.blog}
  data-badge-project={i18nConfig.badges.project}
  data-badge-note={i18nConfig.badges.note}
>
  <!-- Desktop Search Box -->
  <div class="global-search__desktop-wrap">
    <div
      class="global-search__box"
      data-search-box
      data-expanded="false"
    >
      <button
        type="button"
        class="global-search__trigger-btn"
        data-search-trigger
        aria-label={i18nConfig.title}
        title={i18nConfig.title}
        aria-expanded="false"
      >
        <span class="inline-flex size-5 [&>svg]:size-full">
          <Icon svg={Search} />
        </span>
      </button>

      <input
        type="search"
        class="global-search__input"
        data-search-input
        placeholder={i18nConfig.placeholder}
        autocomplete="off"
        spellcheck="false"
        aria-label={i18nConfig.placeholder}
        tabindex="-1"
      />

      <button
        type="button"
        class="global-search__clear-btn"
        data-search-clear
        aria-label="Clear search"
        title="Clear"
        tabindex="-1"
      >
        <span class="inline-flex size-4 [&>svg]:size-full">
          <Icon svg={X} />
        </span>
      </button>
    </div>

    <!-- Desktop Dropdown Results -->
    <div
      class="global-search__dropdown"
      data-search-dropdown
      hidden
      role="listbox"
      aria-label={i18nConfig.title}
    >
      <div class="global-search__results" data-search-results></div>
    </div>
  </div>

  <!-- Mobile Search Overlay -->
  <div class="global-search__mobile-overlay" data-mobile-overlay hidden>
    <div class="global-search__mobile-bar">
      <span class="global-search__mobile-search-icon">
        <Icon svg={Search} />
      </span>
      <input
        type="search"
        class="global-search__mobile-input"
        data-mobile-input
        placeholder={i18nConfig.placeholder}
        autocomplete="off"
        spellcheck="false"
        aria-label={i18nConfig.placeholder}
      />
      <button
        type="button"
        class="global-search__mobile-close-btn"
        data-mobile-close
        aria-label="Close search"
        title="Close"
      >
        <span class="inline-flex size-5 [&>svg]:size-full">
          <Icon svg={X} />
        </span>
      </button>
    </div>
    <div class="global-search__mobile-dropdown">
      <div
        class="global-search__mobile-results"
        data-mobile-results
        role="listbox"
      ></div>
    </div>
  </div>
</div>

<script>
  import { searchContent, type SearchIndexItem } from "../../lib/search";

  type GlobalSearchWindow = Window & {
    __searchIndexCache?: Map<string, SearchIndexItem[]>;
    __searchIndexPromises?: Map<string, Promise<SearchIndexItem[]>>;
  };

  const gWindow = window as GlobalSearchWindow;
  if (!gWindow.__searchIndexCache) gWindow.__searchIndexCache = new Map();
  if (!gWindow.__searchIndexPromises) gWindow.__searchIndexPromises = new Map();

  async function loadIndex(locale: string): Promise<SearchIndexItem[]> {
    const cached = gWindow.__searchIndexCache?.get(locale);
    if (cached) return cached;

    const inflight = gWindow.__searchIndexPromises?.get(locale);
    if (inflight) return inflight;

    const promise = (async () => {
      try {
        const res = await fetch(`/api/search.json?locale=${encodeURIComponent(locale)}`);
        if (!res.ok) throw new Error(`HTTP ${res.status}`);
        const data = (await res.json()) as { items?: unknown };
        const items = Array.isArray(data?.items)
          ? (data.items as SearchIndexItem[])
          : [];
        gWindow.__searchIndexCache?.set(locale, items);
        return items;
      } catch (err) {
        gWindow.__searchIndexPromises?.delete(locale);
        return [];
      }
    })();

    gWindow.__searchIndexPromises?.set(locale, promise);
    return promise;
  }

  function renderResultItem(
    item: SearchIndexItem,
    index: number,
    badges: Record<string, string>,
  ): string {
    const badge = badges[item.type] || item.type;
    return `
      <a
        href="${item.url}"
        class="global-search__result-item"
        data-result-item
        data-result-index="${index}"
        role="option"
        aria-selected="false"
      >
        <span class="global-search__result-badge global-search__result-badge--${item.type}">
          ${badge}
        </span>
        <span class="global-search__result-title" title="${item.title.replace(/"/g, "&quot;")}">
          ${item.title}
        </span>
      </a>
    `;
  }

  function bindGlobalSearch() {
    const rootElements = document.querySelectorAll<HTMLElement>("[data-global-search]");
    if (!rootElements.length) return;

    rootElements.forEach((root) => {
      if (root.dataset.bound === "true") return;
      root.dataset.bound = "true";

      const locale = root.dataset.locale || "zh-CN";
      const emptyLabel = root.dataset.emptyLabel || "未找到相关内容";
      const loadingLabel = root.dataset.loadingLabel || "正在检索...";
      const badges: Record<string, string> = {
        blog: root.dataset.badgeBlog || "Blog",
        project: root.dataset.badgeProject || "Project",
        note: root.dataset.badgeNote || "Note",
      };

      const controller = new AbortController();
      const { signal } = controller;

      const box = root.querySelector<HTMLElement>("[data-search-box]");
      const triggerBtn = root.querySelector<HTMLButtonElement>("[data-search-trigger]");
      const input = root.querySelector<HTMLInputElement>("[data-search-input]");
      const clearBtn = root.querySelector<HTMLButtonElement>("[data-search-clear]");
      const dropdown = root.querySelector<HTMLElement>("[data-search-dropdown]");
      const resultsContainer = root.querySelector<HTMLElement>("[data-search-results]");

      const mobileOverlay = root.querySelector<HTMLElement>("[data-mobile-overlay]");
      const mobileInput = root.querySelector<HTMLInputElement>("[data-mobile-input]");
      const mobileClose = root.querySelector<HTMLButtonElement>("[data-mobile-close]");
      const mobileResults = root.querySelector<HTMLElement>("[data-mobile-results]");

      const isMobile = () => window.matchMedia("(max-width: 64rem)").matches;

      let currentMatches: SearchIndexItem[] = [];
      let activeIndex = -1;

      const preload = () => {
        loadIndex(locale);
      };

      const setExpanded = (expanded: boolean) => {
        if (!box || !triggerBtn || !input) return;
        box.dataset.expanded = String(expanded);
        triggerBtn.setAttribute("aria-expanded", String(expanded));
        if (expanded) {
          input.tabIndex = 0;
          input.focus();
        } else {
          input.tabIndex = -1;
          input.value = "";
          currentMatches = [];
          activeIndex = -1;
          closeDropdown();
        }
      };

      const openDropdown = () => {
        if (dropdown) dropdown.hidden = false;
        if (box) box.dataset.hasDropdown = "true";
      };

      const closeDropdown = () => {
        if (dropdown) dropdown.hidden = true;
        if (box) box.dataset.hasDropdown = "false";
        activeIndex = -1;
      };

      const openMobile = () => {
        if (!mobileOverlay || !mobileInput) return;
        mobileOverlay.hidden = false;
        document.body.style.overflow = "hidden";
        setTimeout(() => mobileInput.focus(), 50);
        preload();
      };

      const closeMobile = () => {
        if (!mobileOverlay || !mobileInput) return;
        mobileOverlay.hidden = true;
        mobileInput.value = "";
        document.body.style.overflow = "";
        if (mobileResults) mobileResults.innerHTML = "";
      };

      const updateActiveItem = (targetResultsContainer: HTMLElement | null) => {
        if (!targetResultsContainer) return;
        const items = targetResultsContainer.querySelectorAll<HTMLElement>("[data-result-item]");
        items.forEach((item, idx) => {
          const isSelected = idx === activeIndex;
          item.setAttribute("aria-selected", String(isSelected));
          if (isSelected) {
            item.scrollIntoView({ block: "nearest" });
          }
        });
      };

      const executeSearch = async (
        query: string,
        targetContainer: HTMLElement | null,
        targetDropdown?: HTMLElement | null,
      ) => {
        if (!targetContainer) return;
        const trimmed = query.trim();
        if (!trimmed) {
          currentMatches = [];
          activeIndex = -1;
          targetContainer.innerHTML = "";
          if (targetDropdown) targetDropdown.hidden = true;
          return;
        }

        if (targetDropdown) openDropdown();
        targetContainer.innerHTML = `
          <div class="global-search__status-message">${loadingLabel}</div>
        `;

        const items = await loadIndex(locale);
        // User may have cleared query while fetching
        if (query.trim() !== trimmed) return;

        const matches = searchContent(items, trimmed, 8);
        currentMatches = matches;
        activeIndex = -1;

        if (matches.length === 0) {
          targetContainer.innerHTML = `
            <div class="global-search__status-message">${emptyLabel}</div>
          `;
          return;
        }

        targetContainer.innerHTML = matches
          .map((item, idx) => renderResultItem(item, idx, badges))
          .join("");
      };

      // Desktop trigger click
      triggerBtn?.addEventListener(
        "click",
        (e) => {
          e.stopPropagation();
          if (isMobile()) {
            openMobile();
            return;
          }
          const isExpanded = box?.dataset.expanded === "true";
          if (!isExpanded) {
            setExpanded(true);
            preload();
          } else {
            // Already expanded: if input has text, don't close, refocus
            input?.focus();
          }
        },
        { signal },
      );

      // Preload on mouse hover or focus of trigger
      triggerBtn?.addEventListener("pointerenter", preload, { signal });
      triggerBtn?.addEventListener("focus", preload, { signal });

      // Desktop input change & keyboard
      input?.addEventListener(
        "input",
        () => {
          const val = input.value;
          if (clearBtn) clearBtn.hidden = val.length === 0;
          executeSearch(val, resultsContainer, dropdown);
        },
        { signal },
      );

      input?.addEventListener(
        "keydown",
        (e) => {
          if (e.key === "Escape") {
            e.preventDefault();
            setExpanded(false);
            triggerBtn?.focus();
            return;
          }

          if (currentMatches.length === 0) return;

          if (e.key === "ArrowDown") {
            e.preventDefault();
            activeIndex = (activeIndex + 1) % currentMatches.length;
            updateActiveItem(resultsContainer);
          } else if (e.key === "ArrowUp") {
            e.preventDefault();
            activeIndex =
              activeIndex <= 0 ? currentMatches.length - 1 : activeIndex - 1;
            updateActiveItem(resultsContainer);
          } else if (e.key === "Enter") {
            e.preventDefault();
            const target =
              activeIndex >= 0 ? currentMatches[activeIndex] : currentMatches[0];
            if (target) {
              window.location.href = target.url;
            }
          }
        },
        { signal },
      );

      // Desktop clear button
      clearBtn?.addEventListener(
        "click",
        (e) => {
          e.stopPropagation();
          if (input) {
            input.value = "";
            input.focus();
          }
          if (clearBtn) clearBtn.hidden = true;
          executeSearch("", resultsContainer, dropdown);
        },
        { signal },
      );

      // Click outside to collapse desktop search
      document.addEventListener(
        "pointerdown",
        (e) => {
          if (!root.contains(e.target as Node)) {
            setExpanded(false);
          }
        },
        { signal },
      );

      // Mobile events
      mobileInput?.addEventListener(
        "input",
        () => {
          executeSearch(mobileInput.value, mobileResults, null);
        },
        { signal },
      );

      mobileInput?.addEventListener(
        "keydown",
        (e) => {
          if (e.key === "Escape") {
            e.preventDefault();
            closeMobile();
            triggerBtn?.focus();
          } else if (e.key === "Enter") {
            if (currentMatches.length > 0) {
              e.preventDefault();
              window.location.href = currentMatches[0].url;
            }
          }
        },
        { signal },
      );

      mobileClose?.addEventListener("click", closeMobile, { signal });

      document.addEventListener(
        "astro:before-swap",
        () => {
          controller.abort();
          document.body.style.overflow = "";
        },
        { once: true },
      );
    });
  }

  bindGlobalSearch();
  document.addEventListener("astro:page-load", bindGlobalSearch);
</script>

<style>
  .global-search {
    position: relative;
    display: inline-flex;
    align-items: center;
  }

  .global-search__desktop-wrap {
    position: relative;
    display: flex;
    align-items: center;
  }

  .global-search__box {
    display: flex;
    align-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-control);
    border: 1px solid transparent;
    background: transparent;
    transition:
      width 240ms cubic-bezier(0.16, 1, 0.3, 1),
      background-color 150ms ease,
      border-color 150ms ease,
      box-shadow 150ms ease;
    overflow: hidden;
  }

  .global-search__box:hover {
    background: var(--surface-soft);
  }

  .global-search__box[data-expanded="true"] {
    width: 16rem;
    border-color: var(--border-strong);
    background: var(--surface-panel);
    backdrop-filter: blur(12px);
    box-shadow: var(--shadow-soft);
  }

  .global-search__box[data-expanded="true"][data-has-dropdown="true"] {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-color: var(--border-soft);
  }

  .global-search__trigger-btn {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: var(--foreground-soft);
    cursor: pointer;
    transition: color 150ms ease;
  }

  .global-search__trigger-btn:hover {
    color: var(--foreground);
  }

  .global-search__input {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 0 0.25rem 0 0;
    border: none;
    background: transparent;
    color: var(--foreground);
    font-family: var(--font-ui);
    font-size: var(--type-sm);
    outline: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 150ms ease;
  }

  .global-search__box[data-expanded="true"] .global-search__input {
    opacity: 1;
    pointer-events: auto;
  }

  .global-search__input::placeholder {
    color: var(--text-muted);
  }

  /* Remove native search cancel icon in webkit */
  .global-search__input::-webkit-search-cancel-button {
    display: none;
  }

  .global-search__clear-btn {
    display: inline-flex;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    border-radius: var(--radius-control);
    margin-right: 0.25rem;
    transition: color 150ms ease;
  }

  .global-search__clear-btn:hover {
    color: var(--foreground);
  }

  .global-search__clear-btn[hidden] {
    display: none;
  }

  /* Dropdown styling */
  .global-search__dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    z-index: 60;
    width: 100%;
    box-sizing: border-box;
    max-height: 22rem;
    overflow-y: auto;
    border-top: none;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: var(--radius-control);
    border-bottom-right-radius: var(--radius-control);
    border-left: 1px solid var(--border-strong);
    border-right: 1px solid var(--border-strong);
    border-bottom: 1px solid var(--border-strong);
    background: var(--surface-panel);
    box-shadow: var(--shadow-soft);
    backdrop-filter: blur(12px);
    padding: 0.35rem;
  }

  .global-search__dropdown[hidden] {
    display: none;
  }

  :global(.global-search__results) {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }

  :global(.global-search__status-message) {
    padding: 1.25rem 0.75rem;
    text-align: center;
    font-size: var(--type-sm);
    color: var(--text-muted);
  }

  :global(.global-search__result-item) {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.5rem;
    padding: 0.4rem 0.65rem;
    border-radius: var(--radius-control);
    text-decoration: none;
    color: var(--foreground);
    transition: background-color 100ms ease;
  }

  :global(.global-search__result-item:hover),
  :global(.global-search__result-item[aria-selected="true"]) {
    background: var(--surface-soft);
  }

  :global(.global-search__result-badge) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.6875rem;
    font-weight: 500;
    font-family: var(--font-mono);
    text-transform: uppercase;
    padding: 0.15rem 0.45rem;
    border-radius: var(--radius-control);
    border: 1px solid var(--border-strong);
    background: var(--surface-soft);
    color: var(--foreground-soft);
    letter-spacing: 0.02em;
    flex-shrink: 0;
  }

  :global(.global-search__result-badge--blog) {
    color: var(--foreground);
    border-color: var(--border-strong);
  }

  :global(.global-search__result-badge--project) {
    color: var(--foreground-soft);
  }

  :global(.global-search__result-badge--note) {
    color: var(--text-muted);
  }

  :global(.global-search__result-title) {
    flex: 1;
    min-width: 0;
    font-size: var(--type-sm);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Mobile search overlay */
  .global-search__mobile-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 100;
    display: flex;
    flex-direction: column;
    background: var(--canvas);
  }

  .global-search__mobile-overlay[hidden] {
    display: none;
  }

  .global-search__mobile-bar {
    display: flex;
    align-items: center;
    height: 4rem;
    padding: 0 1rem;
    gap: 0.75rem;
    border-bottom: 1px solid var(--border-soft);
    background: var(--canvas);
  }

  .global-search__mobile-search-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
  }

  .global-search__mobile-search-icon :global(svg) {
    width: 100%;
    height: 100%;
  }

  .global-search__mobile-input {
    flex: 1;
    min-width: 0;
    height: 100%;
    border: none;
    background: transparent;
    color: var(--foreground);
    font-size: var(--type-base);
    outline: none;
  }

  .global-search__mobile-close-btn {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    border: none;
    background: transparent;
    color: var(--foreground);
    cursor: pointer;
    border-radius: var(--radius-control);
    flex-shrink: 0;
  }

  .global-search__mobile-dropdown {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
  }

  :global(.global-search__mobile-results) {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  @media (max-width: 64rem) {
    .global-search__box[data-expanded="true"] {
      width: 2.75rem;
    }
    .global-search__dropdown {
      display: none !important;
    }
  }

  @media (max-width: 30rem) {
    .global-search__box,
    .global-search__trigger-btn {
      width: 2.5rem;
      height: 2.5rem;
    }
  }
</style>
