<div
  class="loading-progress"
  data-loading-overlay
  data-state="idle"
  role="status"
  aria-live="polite"
  aria-hidden="true"
>
  <span class="sr-only">正在加载页面</span>
</div>

<script>
  const LIFE_ROUTE = /^\/(?:en\/|zh-TW\/)?life\/(?:book|music|screen|game)\/?$/;
  const loaderWindow = window as typeof window & {
    __siteLoadingNavigationCleanup?: () => void;
  };

  function bindLoadingNavigation() {
    loaderWindow.__siteLoadingNavigationCleanup?.();
    const overlay = document.querySelector<HTMLElement>("[data-loading-overlay]");
    if (!overlay) return;
    const controller = new AbortController();
    let showTimer: number | undefined;
    const hide = () => {
      window.clearTimeout(showTimer);
      overlay.dataset.state = "idle";
      overlay.setAttribute("aria-hidden", "true");
      window.dispatchEvent(new CustomEvent("loading-overlay:hidden"));
    };

    document.addEventListener("astro:before-preparation", (event) => {
      if (!LIFE_ROUTE.test(event.to.pathname)) return;
      showTimer = window.setTimeout(() => {
        overlay.dataset.state = "active";
        overlay.setAttribute("aria-hidden", "false");
      }, 150);
      const originalLoader = event.loader;
      event.loader = async () => {
        try {
          await originalLoader();
        } finally {
          hide();
        }
      };
    }, { signal: controller.signal });

    loaderWindow.__siteLoadingNavigationCleanup = () => {
      controller.abort();
      hide();
    };
  }

  bindLoadingNavigation();
  document.addEventListener("astro:page-load", bindLoadingNavigation);
</script>

<style>
  .loading-progress {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    height: 3px;
    overflow: hidden;
    visibility: hidden;
    pointer-events: none;
  }
  .loading-progress[data-state="active"] {
    visibility: visible;
  }
  .loading-progress::before {
    display: block;
    width: 35%;
    height: 100%;
    background: var(--foreground);
    content: "";
    animation: loading-progress 1s ease-in-out infinite;
  }
  @keyframes loading-progress {
    from { transform: translateX(-100%); }
    to { transform: translateX(300%); }
  }
  @media (prefers-reduced-motion: reduce) {
    .loading-progress::before {
      width: 100%;
      animation: none;
    }
  }
</style>
