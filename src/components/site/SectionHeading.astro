---
import type { SectionCta } from "../../types/ui";

interface Props {
  title: string;
  cta?: SectionCta;
}

const { title, cta } = Astro.props;
---

<div class="mb-7 flex items-end justify-between gap-4">
  <h2 class="ui-section-title text-[var(--text-main)]">{title}</h2>
  {cta && (
    <a href={cta.href} class="ui-link ui-link-accent shrink-0 text-sm">
      {cta.label} ->
    </a>
  )}
</div>
