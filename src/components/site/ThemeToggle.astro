<button
  type="button"
  data-theme-toggle
  class="inline-flex size-11 items-center justify-center rounded-[var(--radius-control)] border border-[var(--border-strong)] bg-transparent text-[var(--foreground-soft)] transition-colors hover:bg-[var(--surface-soft)] hover:text-[var(--foreground)]"
  title="切换主题"
  aria-label="切换主题"
  aria-pressed="false"
>
  <svg
    data-theme-icon
    class="size-5"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      data-theme-icon-path
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.5"
      d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
    ></path>
  </svg>
  <span class="sr-only" data-theme-label>浅色</span>
</button>

<script>
  import { applyTheme, readTheme, toggleTheme } from "../../lib/theme";

  const getButtons = () =>
    Array.from(document.querySelectorAll("[data-theme-toggle]"));

  const syncToggleUI = () => {
    const isDark = document.documentElement.classList.contains("dark");

    getButtons().forEach((button) => {
      const label = button.querySelector("[data-theme-label]");
      const iconPath = button.querySelector("[data-theme-icon-path]");

      button.setAttribute("aria-pressed", String(isDark));
      button.setAttribute("aria-label", isDark ? "切换到浅色主题" : "切换到深色主题");

      if (label) {
        label.textContent = isDark ? "已启用深色主题" : "已启用浅色主题";
      }

      if (iconPath) {
        iconPath.setAttribute("fill", isDark ? "currentColor" : "none");
        iconPath.setAttribute("stroke", "currentColor");
      }
    });
  };

  const themeDocument = document as Document & {
    themeToggleClickHandler?: (event: MouseEvent) => void;
    themeToggleRunning?: boolean;
  };

  const transitionProperties = [
    "--theme-transition-x",
    "--theme-transition-y",
  ];

  const getTransitionOrigin = (button: HTMLElement) => {
    const icon = button.querySelector<SVGElement>("[data-theme-icon]");
    const rect = (icon ?? button).getBoundingClientRect();

    return {
      x: rect.left + rect.width / 2,
      y: rect.top + rect.height / 2,
    };
  };

  const setTransitionGeometry = (button: HTMLElement) => {
    const root = document.documentElement;
    const { x, y } = getTransitionOrigin(button);
    const xPercent = (x / window.innerWidth) * 100;
    const yPercent = (y / window.innerHeight) * 100;

    root.style.setProperty("--theme-transition-x", `${xPercent}%`);
    root.style.setProperty("--theme-transition-y", `${yPercent}%`);
  };

  const clearTransitionState = () => {
    const root = document.documentElement;
    themeDocument.themeToggleRunning = false;
    root.removeAttribute("data-theme-transitioning");
    transitionProperties.forEach((property) =>
      root.style.removeProperty(property),
    );
  };

  const handleThemeToggle = async (button: HTMLElement) => {
    if (themeDocument.themeToggleRunning) return;

    const isAppearanceTransition =
      // @ts-ignore
      document.startViewTransition &&
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!isAppearanceTransition) {
      toggleTheme();
      syncToggleUI();
      return;
    }

    themeDocument.themeToggleRunning = true;
    setTransitionGeometry(button);
    document.documentElement.setAttribute("data-theme-transitioning", "true");

    let transition: ViewTransition;

    try {
      // @ts-ignore
      transition = document.startViewTransition(() => {
        toggleTheme();
        syncToggleUI();
      });
    } catch {
      toggleTheme();
      syncToggleUI();
      clearTransitionState();
      return;
    }

    try {
      await transition.finished;
    } catch {
      // An aborted transition still needs the shared state cleaned up.
    } finally {
      clearTransitionState();
    }
  };

  const bindButtons = () => {
    syncToggleUI();
  };

  const handleThemeClick = (event: MouseEvent) => {
    const button = (event.target as Element | null)?.closest<HTMLElement>(
      "[data-theme-toggle]",
    );
    if (!button) return;
    event.preventDefault();
    handleThemeToggle(button);
  };

  if (themeDocument.themeToggleClickHandler) {
    document.removeEventListener("click", themeDocument.themeToggleClickHandler);
  }
  themeDocument.themeToggleClickHandler = handleThemeClick;
  document.addEventListener("click", handleThemeClick);

  applyTheme(readTheme());
  bindButtons();

  document.addEventListener("astro:page-load", () => {
    applyTheme(readTheme());
    bindButtons();
  });

  window.addEventListener("storage", () => {
    applyTheme(readTheme());
    syncToggleUI();
  });
</script>
