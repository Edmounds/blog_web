<button
  type="button"
  data-theme-toggle
  class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-border bg-card text-foreground shadow-sm transition hover:bg-muted hover:text-primary focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
  aria-label="Toggle theme"
  aria-pressed="false"
>
  <svg
    data-theme-icon
    class="h-5 w-5"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      data-theme-icon-path
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.5"
      d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
    ></path>
  </svg>
  <span class="sr-only" data-theme-label>Light</span>
</button>

<script>
  import { applyTheme, readTheme, toggleTheme } from "../../lib/theme";

  const buttons = Array.from(document.querySelectorAll("[data-theme-toggle]"));

  const syncToggleUI = () => {
    const isDark = document.documentElement.classList.contains("dark");

    buttons.forEach((button) => {
      const label = button.querySelector("[data-theme-label]");
      const iconPath = button.querySelector("[data-theme-icon-path]");

      button.setAttribute("aria-pressed", String(isDark));
      button.setAttribute("aria-label", isDark ? "Switch to light theme" : "Switch to dark theme");

      if (label) {
        label.textContent = isDark ? "Dark mode enabled" : "Light mode enabled";
      }

      if (iconPath) {
        iconPath.setAttribute("fill", isDark ? "var(--accent)" : "none");
        iconPath.setAttribute("stroke", isDark ? "var(--accent)" : "currentColor");
      }
    });
  };

  applyTheme(readTheme());
  syncToggleUI();

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      toggleTheme();
      syncToggleUI();
    });
  });

  window.addEventListener("storage", () => {
    applyTheme(readTheme());
    syncToggleUI();
  });
</script>