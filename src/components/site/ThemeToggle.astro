<button
  type="button"
  data-theme-toggle
  class="inline-flex size-10 items-center justify-center rounded-full border border-[var(--border-strong)] bg-[var(--surface-parchment)] text-[var(--text-main)] transition hover:opacity-80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-action)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--bg-base)]"
  aria-label="Toggle theme"
  aria-pressed="false"
>
  <svg
    data-theme-icon
    class="size-5"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <path
      data-theme-icon-path
      stroke="currentColor"
      stroke-linecap="round"
      stroke-linejoin="round"
      stroke-width="1.5"
      d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
    ></path>
  </svg>
  <span class="sr-only" data-theme-label>Light</span>
</button>

<script>
  import { applyTheme, readTheme, toggleTheme } from "../../lib/theme";

  const getButtons = () =>
    Array.from(document.querySelectorAll("[data-theme-toggle]"));

  const syncToggleUI = () => {
    const isDark = document.documentElement.classList.contains("dark");

    getButtons().forEach((button) => {
      const label = button.querySelector("[data-theme-label]");
      const iconPath = button.querySelector("[data-theme-icon-path]");

      button.setAttribute("aria-pressed", String(isDark));
      button.setAttribute("aria-label", isDark ? "Switch to light theme" : "Switch to dark theme");

      if (label) {
        label.textContent = isDark ? "Dark mode enabled" : "Light mode enabled";
      }

      if (iconPath) {
        iconPath.setAttribute("fill", isDark ? "var(--color-action)" : "none");
        iconPath.setAttribute("stroke", isDark ? "var(--color-action)" : "currentColor");
      }
    });
  };

  const handleThemeToggle = async (event: MouseEvent) => {
    const isAppearanceTransition =
      // @ts-ignore
      document.startViewTransition &&
      !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    if (!isAppearanceTransition) {
      toggleTheme();
      syncToggleUI();
      return;
    }

    const target = event.currentTarget as HTMLElement;
    const rect = target.getBoundingClientRect();
    const x = event.clientX ?? (rect.left + rect.width / 2);
    const y = event.clientY ?? (rect.top + rect.height / 2);

    const endRadius = Math.hypot(
      Math.max(x, window.innerWidth - x),
      Math.max(y, window.innerHeight - y)
    );

    // Set attribute to disable other element transitions and avoid duplicate name errors
    document.documentElement.setAttribute("data-theme-transitioning", "true");

    // @ts-ignore
    const transition = document.startViewTransition(() => {
      toggleTheme();
      syncToggleUI();
    });

    try {
      await transition.ready;

      const clipPath = [
        `circle(0px at ${x}px ${y}px)`,
        `circle(${endRadius}px at ${x}px ${y}px)`,
      ];

      document.documentElement.animate(
        {
          clipPath: clipPath,
        },
        {
          duration: 400,
          easing: "cubic-bezier(0.4, 0, 0.2, 1)",
          pseudoElement: "::view-transition-new(root)",
        }
      );
    } catch (e) {
      console.warn("View transition ready failed:", e);
    }

    // Always clean up after transition is finished or aborted
    transition.finished.finally(() => {
      document.documentElement.removeAttribute("data-theme-transitioning");
    });
  };

  const bindButtons = () => {
    getButtons().forEach((button) => {
      if (button.hasAttribute("data-theme-bound")) return;
      button.setAttribute("data-theme-bound", "");
      button.addEventListener("click", (e) => {
        handleThemeToggle(e as MouseEvent);
      });
    });
    syncToggleUI();
  };

  applyTheme(readTheme());
  bindButtons();

  document.addEventListener("astro:page-load", () => {
    applyTheme(readTheme());
    bindButtons();
  });

  window.addEventListener("storage", () => {
    applyTheme(readTheme());
    syncToggleUI();
  });
</script>
