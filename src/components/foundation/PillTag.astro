---
import { Badge } from "../ui/badge";

interface Props {
  text: string;
  class?: string;
}

const { text, class: className = "" } = Astro.props;
---

<Badge variant="outline" className={`ui-tag !h-auto !justify-start !border-[var(--border-strong)] !px-[0.55rem] !py-[0.28rem] !text-xs !font-normal !text-[var(--text-muted)] ${className}`.trim()}>{text}</Badge>
