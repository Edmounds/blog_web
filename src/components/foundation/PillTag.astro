---
import { Badge } from "../ui/badge";

interface Props {
  text: string;
  class?: string;
}

const { text, class: className = "" } = Astro.props;
---

<Badge variant="outline" className={`ui-tag !h-auto !justify-start !border-[var(--border-strong)] !bg-transparent !px-[0.65rem] !py-[0.2rem] !text-[0.7rem] !font-normal !text-[var(--text-muted)] ${className}`.trim()}>{text}</Badge>
