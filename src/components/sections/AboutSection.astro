---
import { render } from "astro:content";
import { getAboutProfile } from "../../lib/content";
import type { Locale } from "../../lib/i18n";
import { getLocalizedAbout, getLocalizedSite } from "../../lib/localized-content";
import CommentsSection from "../domain/CommentsSection.astro";

interface Props { locale?: Locale }

const { locale = "zh-CN" } = Astro.props;
const site = await getLocalizedSite(locale);
const profile = locale === "zh-CN" ? await getAboutProfile() : await getLocalizedAbout(locale);
const { Content } = await render(profile);
---

<div class="about-shell content-container">
  <article class="about-article" aria-label={site.labels.about}>
    <header class="about-article__title">
      <h1>About</h1>
    </header>

    <div class="about-article__body ui-prose">
      <Content />
    </div>

    <div class="about-article__comments">
      <CommentsSection contentId="about/profile" locale={locale} labels={site.copy} />
    </div>
  </article>
</div>

<style>
  .about-article { width: 100%; max-width: 52rem; min-height: calc(100vh - 4.5rem); min-height: calc(100dvh - 4.5rem); margin-inline: auto; padding-block: clamp(4rem, 8vh, 7rem) 6rem; }
  .about-article__title { margin-bottom: clamp(2.5rem, 5vw, 4rem); padding-bottom: clamp(0.75rem, 1.5vw, 1.25rem); border-bottom: 1px solid var(--border-soft); }
  .about-article__title h1 { margin: 0; color: transparent; font-family: var(--font-ui); font-size: clamp(2.3rem, 2rem + 1.5vw, 4.3rem); font-weight: 400; line-height: 1.05; letter-spacing: 0; overflow-wrap: anywhere; -webkit-text-stroke: 1px var(--foreground); paint-order: stroke fill; }
  .about-article__body :global(img) { width: auto; border: 0; border-radius: 0; }
  .about-article__body :global(.acknowledgement-logos) { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1.5rem; align-items: center; }
  .about-article__body :global(.acknowledgement-logo) { display: flex; min-width: 0; height: 4rem; align-items: center; justify-content: center; border-radius: var(--radius-control); }
  .about-article__body :global(.acknowledgement-logo img) { width: 100%; max-width: 11rem; height: 3rem; max-height: 3rem; margin: 0; object-fit: contain; background: transparent; }
  .about-article__body :global(.acknowledgement-logo:focus-visible) { outline: 2px solid var(--foreground); outline-offset: 0.3rem; }
  .about-article__comments { --article-title-size: clamp(1.82rem, 1.52rem + 0.9vw, 2.95rem); margin-top: 4rem; }
  :global(html:lang(zh-CN)) .about-article__comments, :global(html:lang(zh-TW)) .about-article__comments, :global(html:lang(ja)) .about-article__comments { --article-title-size: clamp(1.56rem, 1.36rem + 0.6vw, 2.28rem); }
</style>
