---
import Reveal from "../animation/Reveal";
import PageContainer from "../foundation/PageContainer.astro";
import AboutFocusGrid from "./AboutFocusGrid.astro";
import AboutHero from "./AboutHero.astro";
import ExperienceList from "./ExperienceList.astro";
import { getAboutProfile } from "../../lib/content";
import { getLocalizedAbout, getLocalizedSite } from "../../lib/localized-content";
import type { Locale } from "../../lib/i18n";

interface Props { locale?: Locale }
const { locale = "zh-CN" } = Astro.props;
const site = await getLocalizedSite(locale);
const aboutProfile = locale === "zh-CN" ? await getAboutProfile() : await getLocalizedAbout(locale);
const aboutMeta = aboutProfile.meta;
const aboutStory = aboutProfile.story as string[];
const aboutFocusCards = aboutProfile.focusCards;
const aboutExperience = aboutProfile.experience;
---
<PageContainer class="flex flex-col gap-16 py-12 md:py-16">
  <AboutHero
    titleLeading={aboutProfile.titleLeading}
    titleName={aboutProfile.titleName}
    subtitle={aboutProfile.subtitle}
    portrait={aboutProfile.portrait}
    meta={aboutMeta}
    availability={aboutProfile.availability}
  />

  <Reveal client:visible>
    <section class="grid gap-6 md:grid-cols-[minmax(0,0.38fr)_minmax(0,1fr)] md:gap-10">
      <h2 class="ui-section-title text-[var(--text-main)]">{locale === "zh-CN" ? "我的故事" : site.labels.about}</h2>
      <div class="ui-prose max-w-3xl">
        {aboutStory.map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    </section>
  </Reveal>

  <AboutFocusGrid cards={aboutFocusCards} />

  <ExperienceList jobs={aboutExperience} />
</PageContainer>
