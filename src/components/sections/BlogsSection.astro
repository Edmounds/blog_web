---
import Reveal from "../animation/Reveal";
import PageContainer from "../foundation/PageContainer.astro";
import ArchiveSidebar from "../domain/ArchiveSidebar.astro";
import ArchivePostsView from "../domain/ArchivePostsView.astro";
import { getArchiveBlogSections, getArchiveCategorySummaries, getSiteSettings } from "../../lib/content";
import { toArchiveFilters, toArchivePostSections } from "../../lib/view-models";

const site = await getSiteSettings();
const archiveBlogSections = await getArchiveBlogSections();
const archiveCategorySummaries = await getArchiveCategorySummaries();
const filters = toArchiveFilters(archiveCategorySummaries, site.copy.archiveAllCategories);
const cardCopy = {
  publishedLabel: site.copy.blogMetaPublished,
  readLabel: site.copy.blogMetaRead,
  readArticleLabel: site.copy.blogReadArticle,
};
const sections = toArchivePostSections(archiveBlogSections, cardCopy);
---
<PageContainer class="pb-12 pt-8 md:pb-16 md:pt-10">
  <Reveal client:visible>
    <section class="mb-8 flex flex-col gap-3">
      <h1 class="ui-page-title text-[var(--text-main)]">BLOG</h1>
    </section>
  </Reveal>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
    <aside class="flex flex-col gap-8 lg:col-span-4 xl:col-span-3">
      <ArchiveSidebar filters={filters} title={site.copy.archiveSidebarTitle} />
    </aside>

    <section class="lg:col-span-8 xl:col-span-9">
      <ArchivePostsView sections={sections} hideYearHeader={true} />
    </section>
  </div>
</PageContainer>
