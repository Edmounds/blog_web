---
import type { ExperienceItem } from "../../types/ui";
import Divider from "../foundation/Divider.astro";

interface Props {
  jobs: ExperienceItem[];
}

const { jobs } = Astro.props;
---

<section class="space-y-6">
  <h2 class="font-serif text-4xl text-[var(--text-main)]">Selected Experience</h2>
  <div class="space-y-0 border-t border-[var(--border-strong)]">
    {jobs.map((job, index) => (
      <>
        <article class="grid gap-4 py-6 md:grid-cols-[140px_1fr] md:gap-8">
          <p class="text-sm text-[var(--text-faint)]">{job.years}</p>
          <div class="space-y-2">
            <h3 class="font-serif text-2xl text-[var(--text-main)]">{job.role}</h3>
            <p class="text-xs uppercase tracking-wider text-[var(--text-faint)]">{job.company}</p>
            <p class="max-w-2xl text-sm leading-relaxed text-[var(--text-muted)]">{job.text}</p>
          </div>
        </article>
        {index < jobs.length - 1 && <Divider class="!bg-[var(--border-strong)]" />}
      </>
    ))}
  </div>
</section>
