---
import Reveal from "../animation/Reveal";
import Stagger from "../animation/Stagger";
import type { ExperienceItem } from "../../types/ui";
import Divider from "../foundation/Divider.astro";

interface Props {
  jobs: ExperienceItem[];
}

const { jobs } = Astro.props;
---

<section class="flex flex-col gap-6">
  <Reveal client:visible>
    <h2 class="ui-section-title text-[var(--text-main)]">Selected Experience</h2>
  </Reveal>
  <Stagger className="border-t border-[var(--border-soft)]" delay={0.08} stagger={0.06} client:visible>
    {jobs.map((job, index) => (
      <>
        <article class="grid gap-4 py-6 md:grid-cols-[140px_1fr] md:gap-8">
          <p class="text-sm text-[var(--text-faint)]">{job.years}</p>
          <div class="flex flex-col gap-2">
            <h3 class="text-2xl font-semibold text-[var(--text-main)]">{job.role}</h3>
            <p class="text-xs text-[var(--text-faint)]">{job.company}</p>
            <p class="max-w-2xl text-sm leading-relaxed text-[var(--text-muted)]">{job.text}</p>
          </div>
        </article>
        {index < jobs.length - 1 && <Divider class="!bg-[var(--border-soft)]" />}
      </>
    ))}
  </Stagger>
</section>
