---
import lifeCovers from "../../data/life-covers.json";
import { localizePath, type Locale } from "../../lib/i18n";
import { LIFE_TYPES, type LifeType } from "../../lib/spa-routes";
import { getLocalizedSite } from "../../lib/localized-content";

interface Props {
  locale?: Locale;
}

interface Cover {
  id: string;
  width: number;
  height: number;
  thumbnail: string;
}

const { locale = "zh-CN" } = Astro.props;
const site = await getLocalizedSite(locale);
const sections = lifeCovers.sections as Record<LifeType, Cover[]>;

const entries = LIFE_TYPES.map((type, index) => ({
  type,
  href: localizePath(`/life/${type}/`, locale),
  label: site.labels[type],
  ordinal: String(index + 1).padStart(2, "0"),
  covers: sections[type] ?? [],
}));
---

<section class="life-home detail-layout-outer" aria-label="Life">
  <div class="life-home__inner detail-layout-inner">
    <nav class="life-entries" aria-label={site.labels.art} data-reveal-group>
      {
        entries.map((entry) => (
          <a
            class="life-entry"
            href={entry.href}
            data-life-route
            data-life-type={entry.type}
            data-reveal
          >
            <span class="life-entry__ordinal">{entry.ordinal}</span>
            <span class="life-entry__label">{entry.label}</span>
            <span
              class="life-entry__deck"
              data-life-deck={entry.type}
              aria-hidden="true"
              style={`--n:${Math.max(entry.covers.length, 2)}`}
            >
              {entry.covers.map((cover, index) => (
                <span
                  class="life-deck__card"
                  data-life-card={index}
                  style={`--i:${index}`}
                >
                  <img
                    src={cover.thumbnail}
                    alt=""
                    width={cover.width}
                    height={cover.height}
                    decoding="async"
                  />
                </span>
              ))}
            </span>
            <span class="life-entry__arrow" aria-hidden="true">-&gt;</span>
          </a>
        ))
      }
    </nav>
  </div>
</section>

<style>
  .life-home {
    min-height: calc(100vh - 4.5rem);
    min-height: calc(100dvh - 4.5rem);
    padding-block: clamp(3.5rem, 7vh, 6rem) 5rem;
  }
  .life-entries {
    display: grid;
    margin-top: clamp(1.5rem, 4vh, 3rem);
    border-top: 1px solid var(--border-soft);
  }
  .life-entry {
    --deck-height: clamp(4rem, 7vw, 7rem);
    position: relative;
    display: grid;
    grid-template-columns: 3rem clamp(5rem, 8vw, 7rem) minmax(0, 1fr) 2rem;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.25rem);
    padding-block: clamp(0.9rem, 2vh, 1.5rem);
    border-bottom: 1px solid var(--border-soft);
    color: var(--foreground);
    text-decoration: none;
  }
  .life-entry::before {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--foreground) 5%, transparent),
      transparent 62%
    );
    content: "";
    opacity: 0;
    transition: opacity var(--dur-fade) ease;
  }
  .life-entry:focus-visible {
    outline: none;
  }
  .life-entry:hover::before,
  .life-entry:focus-visible::before {
    opacity: 1;
  }
  .life-entry > * {
    position: relative;
  }
  .life-entry__ordinal {
    color: var(--text-faint);
    font-family: var(--font-mono);
    font-size: var(--type-xs);
    font-variant-numeric: tabular-nums;
  }
  .life-entry__label {
    color: var(--outline-title-fill);
    font-family: var(--font-ui);
    font-size: var(--type-xl);
    font-weight: 500;
    line-height: 1.05;
    white-space: nowrap;
    -webkit-text-stroke: 1px var(--foreground);
    paint-order: stroke fill;
    transition: color var(--dur-fade) var(--ease-out-soft);
  }
  .life-entry:hover .life-entry__label,
  .life-entry:focus-visible .life-entry__label {
    color: var(--foreground);
  }
  .life-entry__deck {
    --card-width: calc(var(--deck-height) * var(--deck-ratio, 0.667));
    position: relative;
    display: block;
    width: 100%;
    height: var(--deck-height);
    justify-self: start;
  }
  .life-deck__card {
    /* All rows use the square music cover as their shared horizontal step. */
    --open-left: calc(var(--i) * (100% - var(--deck-height)) / (var(--n) - 1));
    position: absolute;
    top: 0;
    left: var(--open-left);
    display: block;
    width: var(--card-width);
    height: var(--deck-height);
    overflow: hidden;
    border: 1px solid var(--border-soft);
    border-radius: calc(var(--radius-control) * 0.6);
    background: var(--surface-soft);
    box-shadow: 0 0.35rem 1.1rem
      color-mix(in srgb, var(--foreground) 12%, transparent);
    transition: box-shadow 380ms ease;
  }
  .life-entry:hover .life-deck__card,
  .life-entry:focus-visible .life-deck__card {
    box-shadow: 0 0.65rem 1.6rem
      color-mix(in srgb, var(--foreground) 20%, transparent);
  }
  .life-deck__card img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .life-entry__arrow {
    justify-self: end;
    color: var(--text-faint);
    font-family: var(--font-mono);
    transition:
      transform var(--dur-hover) var(--ease-out-soft),
      color var(--dur-hover) ease;
  }
  .life-entry:hover .life-entry__arrow,
  .life-entry:focus-visible .life-entry__arrow {
    color: var(--foreground);
    transform: translateX(0.35rem);
  }
  /* Music covers remain square while the other collections stay portrait. */
  .life-entry[data-life-type="music"] {
    --deck-ratio: 1;
  }
  @media (max-width: 64rem) {
    .life-entry {
      grid-template-columns: 2.5rem clamp(5rem, 10vw, 7rem) minmax(0, 1fr);
    }
    .life-entry__arrow {
      display: none;
    }
  }
  @media (max-width: 40rem) {
    .life-home {
      padding-block-start: 2.5rem;
    }
    .life-entry {
      --deck-height: 3.25rem;
      grid-template-columns: 5rem minmax(0, 1fr);
      gap: 1rem;
    }
    .life-entry__ordinal {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .life-entry__arrow,
    .life-entry__label,
    .life-entry::before {
      transition: none;
    }
  }
</style>
