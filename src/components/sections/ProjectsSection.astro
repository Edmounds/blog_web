---
import Reveal from "../animation/Reveal";
import PageContainer from "../foundation/PageContainer.astro";
import ArchiveSidebar from "../domain/ArchiveSidebar.astro";
import ArchivePostsView from "../domain/ArchivePostsView.astro";
import { getArchiveProjectSections, getProjectCategorySummaries, getSiteSettings } from "../../lib/content";
import { routes } from "../../lib/routes";
import { toArchiveFilters, toArchiveProjectSections } from "../../lib/view-models";

interface Props {
  activeCategorySlug?: string;
}

const { activeCategorySlug } = Astro.props;
const site = await getSiteSettings();
const archiveProjectSections = await getArchiveProjectSections(activeCategorySlug);
const projectCategorySummaries = await getProjectCategorySummaries();
const filters = toArchiveFilters(projectCategorySummaries, site.copy.archiveAllCategories, activeCategorySlug, {
  allHref: routes.projects,
  categoryHref: routes.projectCategory,
});
const sections = toArchiveProjectSections(archiveProjectSections);
const archiveCopy = {
  emptyLabel: "No projects found.",
  searchPlaceholder: "Search projects",
  countLabel: "projects",
  listTitleLabel: "Project",
  listCategoryLabel: "Category",
  listReadingLabel: "Type",
  listDateLabel: "Year",
};
---
<PageContainer class="py-12 md:py-16">
  <Reveal client:visible>
    <section class="mb-10 flex max-w-3xl flex-col gap-3">
      <p class="ui-kicker">Selected Work</p>
      <h1 class="ui-page-title text-[var(--text-main)]">Projects</h1>
      <p class="ui-lead">
        Product design and engineering projects in the same archive format as writing.
      </p>
    </section>
  </Reveal>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
    <aside class="lg:col-span-4 xl:col-span-3">
      <ArchiveSidebar filters={filters} title={site.copy.archiveSidebarTitle} />
    </aside>

    <section class="lg:col-span-8 xl:col-span-9">
      <ArchivePostsView sections={sections} copy={archiveCopy} />
    </section>
  </div>
</PageContainer>
