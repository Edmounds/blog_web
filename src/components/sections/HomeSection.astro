---
import GradientBackground from "../home/GradientBackground";
import HomeAbout from "../home/HomeAbout";
import { getAboutProfile } from "../../lib/content";

const { homeFeatured } = await getAboutProfile();
---
<section class="home-gradient-section">
  <GradientBackground client:load />
  <HomeAbout
    title={homeFeatured.title}
    name={homeFeatured.name}
    description={homeFeatured.description}
    location={homeFeatured.location}
    client:load
  />
</section>

<style>
  .home-gradient-section {
    position: relative;
    width: 100%;
    padding-top: 128px;
    min-height: 100vh;
    overflow: hidden;
  }
  @media (min-width: 768px) {
    .home-gradient-section {
      padding-top: 64px;
    }
  }

  /* About Me overlay text styles */
  :global(.home-about-title) {
    font-family: var(--font-ui);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 0.25em;
  }

  :global(.home-about-name) {
    font-family: var(--font-ui);
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 0.75em;
    opacity: 0.85;
  }

  :global(.home-about-desc) {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.6;
    max-width: 36rem;
    margin: 0 0 0.75em;
    opacity: 0.7;
  }

  :global(.home-about-location) {
    font-size: 0.875rem;
    opacity: 0.5;
    margin: 0 0 2rem;
  }

  :global(.home-about-socials) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  :global(.home-about-social-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s ease;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  /* Light mode text colors over gradient */
  :root .home-gradient-section :global(.home-about-title),
  :root .home-gradient-section :global(.home-about-name),
  html.light .home-gradient-section :global(.home-about-title),
  html.light .home-gradient-section :global(.home-about-name) {
    color: #1a1a2e;
  }

  :root .home-gradient-section :global(.home-about-desc),
  :root .home-gradient-section :global(.home-about-location),
  html.light .home-gradient-section :global(.home-about-desc),
  html.light .home-gradient-section :global(.home-about-location) {
    color: #2d2d44;
  }

  :root :global(.home-about-social-link),
  html.light :global(.home-about-social-link) {
    color: #1a1a2e;
    background: rgba(255, 255, 255, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.5);
  }

  :root :global(.home-about-social-link:hover),
  html.light :global(.home-about-social-link:hover) {
    background: rgba(255, 255, 255, 0.6);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
  }

  /* Dark mode text colors over gradient */
  html.dark .home-gradient-section :global(.home-about-title),
  html.dark .home-gradient-section :global(.home-about-name) {
    color: #ffffff;
  }

  html.dark .home-gradient-section :global(.home-about-desc),
  html.dark .home-gradient-section :global(.home-about-location) {
    color: rgba(255, 255, 255, 0.8);
  }

  html.dark :global(.home-about-social-link) {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  html.dark :global(.home-about-social-link:hover) {
    background: rgba(255, 255, 255, 0.18);
    transform: translateY(-2px);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }
</style>
