---
import { getAboutProfile, getPublishedContent } from "../../lib/content";
import { getLocalizedAbout } from "../../lib/localized-content";
import { localizePath, type Locale } from "../../lib/i18n";

interface Props { locale?: Locale }
const { locale = "zh-CN" } = Astro.props;
const about = locale === "zh-CN" ? await getAboutProfile() : await getLocalizedAbout(locale);
const profile = about.data;
const [blogs, notes] = await Promise.all([getPublishedContent("blog", locale), getPublishedContent("note", locale)]);
const groups = (items: typeof blogs) => {
  const byYear = new Map<number, typeof items>();
  items.slice(0, 6).forEach((item) => byYear.set(item.createdAt.getFullYear(), [...(byYear.get(item.createdAt.getFullYear()) ?? []), item]));
  return [...byYear.entries()].sort((a, b) => b[0] - a[0]);
};
---

<section class="home-shell app-container">
  <div class="profile-card">
    <div class="profile-avatar-wrap">
      <img class="profile-avatar" src={profile.portrait} alt={profile.name} />
    </div>
    <h1>{profile.name}</h1>
    <nav aria-label="Social links">
      <a href="https://github.com/Edmounds" target="_blank" rel="noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
          <path d="M9 18c-4.51 2-5-2-7-2" />
        </svg>
      </a>
      <a href="https://space.bilibili.com/397591871" target="_blank" rel="noreferrer" aria-label="Bilibili">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M17.813 4.653a.85.85 0 0 1 .15.15l1.637 1.865c.1.116.195.234.287.355l.129.176.082.133V17.5a2.5 2.5 0 0 1-2.5 2.5H6.5A2.5 2.5 0 0 1 4 17.5V7.332l.081-.133.129-.176a3.01 3.01 0 0 1 .287-.355l1.637-1.865a.91.91 0 0 1 .15-.15l.215-.164.21-.133.228-.105.235-.078.24-.047.245-.02.25-.003.245.02.24.047.235.078.228.105.21.133.215.164.673.473.674-.473.215-.164.21-.133.228-.105.235-.078.24-.047.245-.02.25-.003.245.02.24.047.235.078.228.105.21.133.215.164.673.473.674-.473zM7.5 9.332a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1h-1zm9 0a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1h-1z" />
        </svg>
      </a>
      <a href="mailto:i@muelsyse.us" aria-label="Email">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <rect width="20" height="16" x="2" y="4" rx="2" />
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
        </svg>
      </a>
    </nav>
    <img class="codetime-badge" src="/api/wakatime-badge.svg" alt="Total coding time" width="160" height="24" data-wakatime-image hidden />
    <p class="profile-card__intro">{profile.motto}</p>
    <p class="profile-card__location">{profile.major} · {profile.city}</p>
    <div class="profile-metrics">
      <a
        class="github-snake"
        href="https://github.com/Edmounds"
        target="_blank"
        rel="noreferrer"
        data-github-snake-root
        data-light-src="https://raw.githubusercontent.com/Edmounds/Edmounds/refs/heads/output/github-contribution-grid-snake.svg"
        data-dark-src="https://raw.githubusercontent.com/Edmounds/Edmounds/refs/heads/output/github-contribution-grid-snake-dark.svg"
      >
        <picture>
          <source media="(prefers-color-scheme: dark)" srcset="https://raw.githubusercontent.com/Edmounds/Edmounds/refs/heads/output/github-contribution-grid-snake-dark.svg" data-github-snake-source="dark" />
          <source media="(prefers-color-scheme: light)" srcset="https://raw.githubusercontent.com/Edmounds/Edmounds/refs/heads/output/github-contribution-grid-snake.svg" data-github-snake-source="light" />
          <img src="https://raw.githubusercontent.com/Edmounds/Edmounds/refs/heads/output/github-contribution-grid-snake.svg" alt="GitHub contribution activity for Edmounds" width="880" height="192" data-github-snake />
        </picture>
        <span class="github-snake__fallback" data-github-snake-fallback hidden>View Edmounds on GitHub</span>
      </a>
    </div>
  </div>

  <div class="latest-content">
    {[
      { title: "Latest Blogs", section: "blog", items: groups(blogs) },
      { title: "Latest Notes", section: "note", items: groups(notes) },
    ].map((block) => (
      <section>
        <h2><a href={`/${block.section}/`} data-primary-route>{block.title}</a></h2>
        {block.items.length === 0 ? <p class="latest-empty">No {block.section}s published yet.</p> : block.items.map(([year, items]) => (
          <div class="latest-year">
            <h3>{year}</h3>
            <ol>
              {items.map((item) => (
                <li>
                  <time>{new Intl.DateTimeFormat(locale, { month: "short", day: "numeric" }).format(item.createdAt)}</time>
                  <a href={localizePath(`/${block.section}/${item.slug}/`, locale)}><span>{item.title}</span><span aria-hidden="true">-&gt;</span></a>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </section>
    ))}
  </div>
</section>

<script>
  function revealWakatime() {
    document.querySelectorAll('[data-wakatime-image]').forEach((image) => {
      if (!(image instanceof HTMLImageElement) || image.dataset.bound === "true") return;
      image.dataset.bound = "true";
      image.addEventListener("load", () => {
        if (image.naturalWidth > 1) image.hidden = false;
      });
      image.addEventListener("error", () => { image.hidden = true; });
      if (image.complete && image.naturalWidth > 1) image.hidden = false;
    });
  }
  revealWakatime();
  document.addEventListener("astro:page-load", revealWakatime);

  function initGithubSnake() {
    document.querySelectorAll('[data-github-snake]').forEach((image) => {
      if (!(image instanceof HTMLImageElement)) return;
      const root = image.closest('[data-github-snake-root]');
      const fallback = root?.querySelector('[data-github-snake-fallback]');
      const showFallback = () => {
        image.hidden = true;
        if (fallback instanceof HTMLElement) fallback.hidden = false;
      };
      const syncTheme = () => {
        const isDark = document.documentElement.classList.contains("dark");
        const src = root instanceof HTMLElement ? root.dataset[isDark ? "darkSrc" : "lightSrc"] : undefined;
        if (!src) return;
        if (image.dataset.themeSrc !== src) {
          image.dataset.themeSrc = src;
          image.parentElement?.querySelectorAll("source").forEach((item) => {
            if (item instanceof HTMLSourceElement) item.srcset = src;
          });
          image.src = src;
        }
        image.hidden = false;
        if (fallback instanceof HTMLElement) fallback.hidden = true;
      };

      if (image.dataset.bound !== "true") {
        image.dataset.bound = "true";
        image.dataset.themeSrc = image.currentSrc || image.src;
        image.addEventListener("error", showFallback);
        window.addEventListener("blog:theme-change", syncTheme);
      }
      syncTheme();
      if (image.complete && image.naturalWidth === 0) showFallback();
    });
  }
  initGithubSnake();
  document.addEventListener("astro:page-load", initGithubSnake);
</script>

<style>
  .home-shell { display: grid; grid-template-columns: minmax(18rem, 0.8fr) minmax(28rem, 1.2fr); gap: clamp(3rem, 8vw, 9rem); align-items: center; min-height: calc(100vh - 4.5rem); padding-block: clamp(3rem, 7vh, 6rem); }
  .profile-card { display: flex; max-width: 32rem; flex-direction: column; align-items: center; justify-self: center; text-align: center; }
  .profile-avatar-wrap { position: relative; width: clamp(6.5rem, 10vw, 9rem); aspect-ratio: 1; }
  .profile-avatar { display: block; width: 100%; height: 100%; object-fit: cover; border: 1px solid var(--border-soft); border-radius: 50%; }
  .profile-card h1 { margin: 1.25rem 0 0.7rem; font-size: clamp(1.8rem, 4vw, 4rem); line-height: 1; }
  .profile-card nav { display: flex; gap: 0.45rem; }
  .profile-card nav a { display: inline-flex; width: 2.5rem; height: 2.5rem; align-items: center; justify-content: center; color: var(--text-muted); text-decoration: none; }
  .profile-card nav svg { width: 1.3rem; height: 1.3rem; }
  .codetime-badge { display: block; width: auto; height: 1.5rem; max-width: 100%; margin-top: 0.2rem; }
  :global(html.dark) .codetime-badge { filter: invert(1); }
  .profile-card__intro { margin: 0.8rem 0 0; color: var(--text-muted); line-height: 1.7; }
  .profile-card__location { margin: 0.5rem 0 0; color: var(--text-faint); font-size: var(--type-sm); }
  .profile-metrics { display: grid; width: 100%; gap: 0.75rem; margin-top: 1.5rem; }
  .github-snake { display: block; width: 100%; aspect-ratio: 880 / 192; color: var(--text-faint); font-size: var(--type-xs); }
  .github-snake picture, .github-snake img { display: block; width: 100%; height: 100%; }
  .github-snake img { object-fit: contain; }
  .github-snake__fallback { padding: 1rem 0; text-decoration: underline; text-underline-offset: 0.2em; }
  .latest-content { display: grid; gap: 1rem; }
  .latest-content > section { padding: 0.75rem; }
  .latest-content h2 { margin: 0 0 0.6rem; font-size: clamp(2rem, 4vw, 4rem); line-height: 1; }
  .latest-content h2 a { color: transparent; text-decoration: none; -webkit-text-stroke: 1px var(--foreground); }
  .latest-year { display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: 1.4rem; }
  .latest-year h3 { margin: 0.75rem 0 0; color: transparent; font-size: var(--type-lg); -webkit-text-stroke: 1px var(--foreground); }
  .latest-year ol { margin: 0; padding: 0; list-style: none; }
  .latest-year li { position: relative; display: grid; grid-template-columns: 5rem minmax(0, 1fr); gap: 0.8rem; padding: 0.75rem 0 0.75rem 1.2rem; border-left: 1px solid var(--border-strong); }
  .latest-year li::before { position: absolute; top: 1.15rem; left: -0.25rem; width: 0.45rem; height: 0.45rem; background: var(--canvas); border: 1px solid var(--foreground); border-radius: 50%; content: ""; }
  .latest-year time { color: var(--text-faint); font-size: var(--type-xs); }
  .latest-year a { display: flex; min-width: 0; justify-content: space-between; gap: 1rem; color: var(--foreground); text-decoration: none; }
  .latest-year a span:first-child { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .latest-empty { color: var(--text-faint); }
  @media (max-width: 56rem) { .home-shell { grid-template-columns: 1fr; min-height: auto; } .latest-content { width: min(100%, 44rem); margin-inline: auto; } }
  @media (max-width: 32rem) { .latest-year { grid-template-columns: 1fr; gap: 0; } .latest-year li { grid-template-columns: 1fr; } }
</style>
