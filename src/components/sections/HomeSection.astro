---
import HomeAbout from "../home/HomeAbout";
import { getAboutProfile } from "../../lib/content";
import { getLocalizedAbout } from "../../lib/localized-content";
import type { Locale } from "../../lib/i18n";

interface Props { locale?: Locale }
const { locale = "zh-CN" } = Astro.props;
const { homeFeatured } = locale === "zh-CN" ? await getAboutProfile() : await getLocalizedAbout(locale);
---
<section class="home-gradient-section">
  <HomeAbout
    title={homeFeatured.title}
    name={homeFeatured.name}
    description={homeFeatured.description}
    location={homeFeatured.location}
    client:load
  />
</section>

<style>
  .home-gradient-section {
    position: relative;
    width: 100%;
    padding-top: 128px;
    min-height: 100vh;
    overflow: hidden;
    background: var(--bg-base);
  }
  @media (min-width: 768px) {
    .home-gradient-section {
      padding-top: 64px;
    }
  }

  /* About Me overlay text styles */
  :global(.home-about-title) {
    font-family: var(--font-ui);
    font-size: clamp(3rem, 8vw, 6rem);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 0.25em;
  }

  :global(.home-about-name) {
    font-family: var(--font-ui);
    font-size: clamp(1.5rem, 3.5vw, 2.5rem);
    font-weight: 500;
    line-height: 1.2;
    margin: 0 0 0.75em;
    opacity: 0.85;
  }

  :global(.home-about-desc) {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.6;
    max-width: 36rem;
    margin: 0 0 0.75em;
    opacity: 0.7;
  }

  :global(.home-about-location) {
    font-size: 0.875rem;
    opacity: 0.5;
    margin: 0 0 2rem;
  }

  :global(.home-about-socials) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-top: 0.5rem;
  }

  :global(.home-about-social-link) {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.2rem;
    border-radius: 9999px;
    font-size: 0.8125rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.25s ease;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .home-gradient-section :global(.home-about-title),
  .home-gradient-section :global(.home-about-name) {
    color: var(--text-main);
  }

  .home-gradient-section :global(.home-about-desc),
  .home-gradient-section :global(.home-about-location) {
    color: var(--text-muted);
  }

  :global(.home-about-social-link) {
    color: var(--text-main);
    background: var(--bg-elevated);
    border: 1px solid var(--border-strong);
  }

  :global(.home-about-social-link:hover) {
    background: var(--bg-subtle);
    transform: translateY(-2px);
    box-shadow: var(--shadow-soft);
  }
</style>
