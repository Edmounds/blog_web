---
import { getAboutProfile, getPublishedContent } from "../../lib/content";
import { getLocalizedAbout } from "../../lib/localized-content";
import { localizePath, type Locale } from "../../lib/i18n";
import GitHubHeatmap from "../domain/GitHubHeatmap.astro";

interface Props {
  locale?: Locale;
}
const { locale = "zh-CN" } = Astro.props;
const about =
  locale === "zh-CN"
    ? await getAboutProfile()
    : await getLocalizedAbout(locale);
const profile = about.data;
const [blogs, notes] = await Promise.all([
  getPublishedContent("blog", locale),
  getPublishedContent("note", locale),
]);
const groupLatestByYear = (items: typeof blogs) => {
  const byYear = new Map<number, typeof items>();
  for (const item of items.slice(0, 6)) {
    const year = item.createdAt.getFullYear();
    byYear.set(year, [...(byYear.get(year) ?? []), item]);
  }
  return [...byYear.entries()].sort((a, b) => b[0] - a[0]);
};
const latestBlocks = [
  { title: "Latest Blogs", section: "blog", items: groupLatestByYear(blogs) },
  { title: "Latest Notes", section: "note", items: groupLatestByYear(notes) },
];
---

<section class="home-shell content-container">
  <div class="profile-card">
    <div class="profile-avatar-wrap">
      <picture>
        <source
          type="image/avif"
          srcset="/images/content/about/profile-f5f8abc7eda1-w160.avif 160w, /images/content/about/profile-f5f8abc7eda1-w320.avif 320w"
          sizes="(max-width: 32rem) 104px, 144px"
        />
        <source
          type="image/webp"
          srcset="/images/content/about/profile-f5f8abc7eda1-w160.webp 160w, /images/content/about/profile-f5f8abc7eda1-w320.webp 320w"
          sizes="(max-width: 32rem) 104px, 144px"
        />
        <img
          class="profile-avatar"
          src={profile.portrait}
          alt={profile.name}
          width="320"
          height="320"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
    <h1>{profile.name}</h1>
    <nav aria-label="Social links">
      <a
        href="https://github.com/Edmounds"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub"
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path
            d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"
          ></path>
          <path d="M9 18c-4.51 2-5-2-7-2"></path>
        </svg>
      </a>
      <a
        href="https://space.bilibili.com/397591871"
        target="_blank"
        rel="noreferrer"
        aria-label="Bilibili"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M17.813 4.653a.85.85 0 0 1 .15.15l1.637 1.865c.1.116.195.234.287.355l.129.176.082.133V17.5a2.5 2.5 0 0 1-2.5 2.5H6.5A2.5 2.5 0 0 1 4 17.5V7.332l.081-.133.129-.176a3.01 3.01 0 0 1 .287-.355l1.637-1.865a.91.91 0 0 1 .15-.15l.215-.164.21-.133.228-.105.235-.078.24-.047.245-.02.25-.003.245.02.24.047.235.078.228.105.21.133.215.164.673.473.674-.473.215-.164.21-.133.228-.105.235-.078.24-.047.245-.02.25-.003.245.02.24.047.235.078.228.105.21.133.215.164.673.473.674-.473zM7.5 9.332a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1h-1zm9 0a1 1 0 0 0-1 1v2a1 1 0 0 0 1 1h1a1 1 0 0 0 1-1v-2a1 1 0 0 0-1-1h-1z"
          ></path>
        </svg>
      </a>
      <a href="mailto:i@muelsyse.us" aria-label="Email">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
      </a>
    </nav>
    <p class="profile-card__intro">{profile.motto}</p>
    <div class="profile-metrics">
      <img
        class="codetime-badge"
        data-src="/api/wakatime-badge.svg"
        alt="Total coding time"
        width="240"
        height="28"
        data-wakatime-image
        hidden
      />
      <GitHubHeatmap />
    </div>
  </div>

  <div class="latest-content">
    {
      latestBlocks.map((block) => (
        <section data-reveal-group>
          <h2>
            <a
              href={localizePath(`/${block.section}/`, locale)}
              data-primary-route
            >
              {block.title}
            </a>
          </h2>
          {block.items.length === 0 ? (
            <p class="latest-empty">No {block.section}s published yet.</p>
          ) : (
            block.items.map(([year, items]) => (
              <div class="latest-year">
                <h3>{year}</h3>
                <ol>
                  {items.map((item) => (
                    <li data-reveal>
                      <time>
                        {new Intl.DateTimeFormat(locale, {
                          month: "short",
                          day: "numeric",
                        }).format(item.createdAt)}
                      </time>
                      <a
                        href={localizePath(
                          `/${block.section}/${item.slug}/`,
                          locale,
                        )}
                      >
                        <span>{item.title}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </div>
            ))
          )}
        </section>
      ))
    }
  </div>
</section>

<script>
  function revealWakatime() {
    document.querySelectorAll("[data-wakatime-image]").forEach((image) => {
      if (
        !(image instanceof HTMLImageElement) ||
        image.dataset.bound === "true"
      )
        return;
      image.dataset.bound = "true";
      const loadImage = () => {
        if (!image.src && image.dataset.src) image.src = image.dataset.src;
      };
      image.addEventListener("load", () => {
        if (image.naturalWidth > 1) image.hidden = false;
      });
      image.addEventListener("error", () => {
        image.hidden = true;
      });
      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            observer.disconnect();
            loadImage();
          },
          { rootMargin: "240px" },
        );
        observer.observe(image.parentElement ?? image);
      } else {
        globalThis.setTimeout(loadImage, 3000);
      }
    });
  }
  revealWakatime();
  document.addEventListener("astro:page-load", revealWakatime);
</script>

<style>
  .home-shell {
    display: grid;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(28rem, 1.2fr);
    gap: clamp(3rem, 8vw, 9rem);
    align-items: start;
    min-height: calc(100vh - 4.5rem);
    min-height: calc(100dvh - 4.5rem);
    padding-block: clamp(3rem, 7vh, 6rem);
  }
  .profile-card {
    display: flex;
    width: min(100%, 38rem);
    flex-direction: column;
    align-items: center;
    justify-self: center;
    text-align: center;
  }
  .profile-avatar-wrap {
    position: relative;
    width: clamp(6.5rem, 10vw, 9rem);
    aspect-ratio: 1;
  }
  .profile-avatar-wrap picture {
    display: contents;
  }
  .profile-avatar {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--border-soft);
    border-radius: 50%;
  }
  .profile-card h1 {
    margin: 1.25rem 0 0.7rem;
    font-size: var(--type-2xl);
    line-height: 1;
  }
  .profile-card nav {
    display: flex;
    gap: 0.45rem;
  }
  .profile-card nav a {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    text-decoration: none;
  }
  .profile-card nav svg {
    width: 1.3rem;
    height: 1.3rem;
  }
  .codetime-badge {
    display: block;
    width: min(100%, 15rem);
    height: auto;
    margin-inline: auto;
  }
  :global(html.dark) .codetime-badge {
    filter: invert(1) grayscale(1);
  }
  .profile-card__intro {
    margin: 1rem 0 0;
    color: var(--text-muted);
    line-height: 1.7;
  }
  .profile-metrics {
    display: grid;
    width: min(100%, 38rem);
    gap: 2.25rem;
    margin-top: 1rem;
  }
  .latest-content {
    display: grid;
    gap: 1rem;
  }
  .latest-content > section {
    padding: 0.75rem;
  }
  .latest-content > section:first-child {
    padding-top: 0;
  }
  .latest-content h2 {
    margin: 0 0 0.6rem;
    font-size: var(--type-page-title);
    line-height: 1;
  }
  .latest-content h2 a {
    color: var(--outline-title-fill);
    text-decoration: none;
    -webkit-text-stroke: 1px var(--foreground);
  }
  .latest-year {
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 1.4rem;
  }
  .latest-year h3 {
    margin: 0.75rem 0 0;
    color: var(--outline-title-fill);
    font-size: var(--type-lg);
    -webkit-text-stroke: 1px var(--foreground);
  }
  .latest-year ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .latest-year li {
    position: relative;
    display: grid;
    grid-template-columns: 5rem minmax(0, 1fr);
    gap: 0.8rem;
    padding: 0.75rem 0 0.75rem 1.2rem;
    border-left: 1px solid var(--border-strong);
  }
  .latest-year li::before {
    position: absolute;
    top: 1.15rem;
    left: -0.25rem;
    width: 0.45rem;
    height: 0.45rem;
    background: var(--canvas);
    border: 1px solid var(--foreground);
    border-radius: 50%;
    content: "";
  }
  .latest-year time {
    color: var(--text-faint);
    font-size: var(--type-xs);
  }
  .latest-year a {
    display: flex;
    min-width: 0;
    color: var(--foreground);
    text-decoration: none;
  }
  .latest-year a span:first-child {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .latest-empty {
    color: var(--text-faint);
  }
  @media (min-width: 78.0625rem) {
    .latest-content {
      margin-top: 1.5rem;
    }
  }
  @media (max-width: 78rem) {
    .home-shell {
      grid-template-columns: 1fr;
      min-height: auto;
    }
    .latest-content {
      width: min(100%, 44rem);
      margin-inline: auto;
    }
  }
  @media (max-width: 32rem) {
    .latest-year {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .latest-year li {
      grid-template-columns: 1fr;
    }
  }
</style>
