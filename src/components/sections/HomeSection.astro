---
import { getAboutProfile, getPublishedContent } from "../../lib/content";
import { getLocalizedAbout } from "../../lib/localized-content";
import { localizePath, type Locale } from "../../lib/i18n";
import GitHubHeatmap from "../domain/GitHubHeatmap.astro";

interface Props {
  locale?: Locale;
}
const { locale = "zh-CN" } = Astro.props;
const about =
  locale === "zh-CN"
    ? await getAboutProfile()
    : await getLocalizedAbout(locale);
const profile = about.data;
const [blogs, notes, projects] = await Promise.all([
  getPublishedContent("blog", locale),
  getPublishedContent("note", locale),
  getPublishedContent("project", locale),
]);
const groupLatestByYear = (items: typeof blogs) => {
  const byYear = new Map<number, typeof items>();
  for (const item of items.slice(0, 6)) {
    const year = item.createdAt.getFullYear();
    byYear.set(year, [...(byYear.get(year) ?? []), item]);
  }
  return [...byYear.entries()].sort((a, b) => b[0] - a[0]);
};
const latestBlocks = [
  { title: "Latest Blogs", section: "blog", items: groupLatestByYear(blogs) },
  { title: "Latest Notes", section: "note", items: groupLatestByYear(notes) },
  {
    title: "Latest Projects",
    section: "project",
    items: groupLatestByYear(projects),
  },
];
---

<section class="home-shell content-container">
  <div class="profile-card">
    <div class="profile-avatar-wrap">
      <picture>
        <source
          type="image/avif"
          srcset="/images/content/about/profile-8646bdb863b8-w160.avif 160w, /images/content/about/profile-8646bdb863b8-w320.avif 320w"
          sizes="(max-width: 32rem) 104px, 144px"
        />
        <source
          type="image/webp"
          srcset="/images/content/about/profile-8646bdb863b8-w160.webp 160w, /images/content/about/profile-8646bdb863b8-w320.webp 320w"
          sizes="(max-width: 32rem) 104px, 144px"
        />
        <img
          class="profile-avatar"
          src={profile.portrait}
          alt={profile.name}
          width="320"
          height="320"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
    <h1>{profile.name}</h1>
    <nav aria-label="Social links">
      <a
        href="https://github.com/Edmounds"
        target="_blank"
        rel="noreferrer"
        aria-label="GitHub"
      >
