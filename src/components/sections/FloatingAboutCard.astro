---
import PillTag from "../foundation/PillTag.astro";
import SurfacePanel from "../foundation/SurfacePanel.astro";

interface Props {
  badge: string;
  title: string;
  name: string;
  description: string;
  location: string;
  portrait: string;
  href: string;
}

const { badge, title, name, description, location, portrait, href } = Astro.props;
---

<SurfacePanel class="relative overflow-hidden p-6">
  <div class="relative flex flex-col gap-5">
    <PillTag text={badge} />
    <h2 class="text-4xl font-semibold leading-tight text-[var(--text-main)]">
      <a href={href} class="transition hover:text-[var(--color-action)]">{title}</a>
    </h2>
    <h3 class="text-2xl font-semibold text-[var(--text-main)]">{name}</h3>
    <p class="text-base leading-relaxed text-[var(--text-muted)]">{description}</p>
    <p class="text-sm text-[var(--text-faint)]">{location}</p>
    <a href={href} class="block aspect-square overflow-hidden rounded-lg bg-[var(--surface-parchment)]">
      <img
        src={portrait}
        alt={name}
        class="h-full w-full object-cover transition duration-500 hover:scale-[1.025]"
        loading="lazy"
      />
    </a>
  </div>
</SurfacePanel>
