---
import PillTag from "../foundation/PillTag.astro";
import SurfacePanel from "../foundation/SurfacePanel.astro";

interface Props {
  badge: string;
  title: string;
  name: string;
  description: string;
  location: string;
  portrait: string;
  href: string;
}

const { badge, title, name, description, location, portrait, href } = Astro.props;
---

<SurfacePanel class="relative overflow-hidden p-8 md:p-12">
  <div class="absolute -right-20 -top-20 h-56 w-56 rounded-full bg-[var(--accent-soft)] blur-3xl"></div>
  <div class="relative grid grid-cols-1 items-center gap-10 lg:grid-cols-12">
    <div class="order-2 space-y-6 lg:order-1 lg:col-span-7">
      <PillTag text={badge} />
      <h1 class="font-serif text-4xl leading-tight text-[var(--text-main)] transition md:text-6xl">
        <a href={href} class="hover:text-[var(--accent)]">{title}</a>
      </h1>
      <h2 class="text-2xl text-[var(--text-main)]">{name}</h2>
      <p class="max-w-2xl text-lg leading-relaxed text-[var(--text-muted)]">{description}</p>
      <p class="text-sm text-[var(--text-faint)]">{location}</p>
    </div>

    <a href={href} class="order-1 block overflow-hidden rounded-xl border border-[var(--border-strong)] lg:order-2 lg:col-span-5">
      <img src={portrait} alt={name} class="h-full w-full object-cover grayscale transition duration-700 hover:scale-105 hover:grayscale-0" loading="lazy" />
    </a>
  </div>
</SurfacePanel>
