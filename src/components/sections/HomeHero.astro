---
import Stagger from "../animation/Stagger";
import PillTag from "../foundation/PillTag.astro";
import SurfacePanel from "../foundation/SurfacePanel.astro";

interface Props {
  badge: string;
  title: string;
  name: string;
  description: string;
  location: string;
  href: string;
}

const { badge, title, name, description, location, href } = Astro.props;
---

<SurfacePanel class="relative !border-0 !bg-transparent !shadow-none p-0">
  <div class="relative flex items-center justify-start py-8 lg:min-h-[56vh]">
    <Stagger className="flex w-full max-w-xl flex-col items-start gap-6 lg:max-w-[14.5rem]" delay={0.1} duration={0.45} stagger={0.06} client:load>
      <PillTag text={badge} />
      <h1 class="font-serif text-4xl leading-tight text-[var(--text-main)] transition md:text-5xl xl:text-6xl">
        <a href={href} class="hover:text-[var(--accent)]">{title}</a>
      </h1>
      <h2 class="text-2xl text-[var(--text-main)]">{name}</h2>
      <p class="w-full text-lg leading-relaxed text-[var(--text-muted)]">{description}</p>
      <p class="text-sm text-[var(--text-faint)]">{location}</p>
      <a href={href} class="ui-link ui-link-accent text-xs tracking-[0.14em] uppercase">Open full profile -></a>
    </Stagger>
  </div>
</SurfacePanel>
