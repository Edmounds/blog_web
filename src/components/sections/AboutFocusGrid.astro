---
import Reveal from "../animation/Reveal";
import Stagger from "../animation/Stagger";
import type { AboutFocusCard } from "../../types/ui";

interface Props {
  cards: AboutFocusCard[];
}

const { cards } = Astro.props;
---

<section class="flex flex-col gap-6">
  <Reveal client:visible>
    <h2 class="ui-section-title text-[var(--text-main)]">Current Focus</h2>
  </Reveal>
  <Stagger className="grid gap-0 border-t border-[var(--border-soft)]" delay={0.08} stagger={0.06} client:visible>
    {cards.map((card) => (
      <section class="grid gap-3 border-b border-[var(--border-soft)] py-6 md:grid-cols-[minmax(0,0.6fr)_minmax(0,1fr)] md:gap-8">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
          <h3 class="text-2xl font-semibold text-[var(--text-main)]">{card.title}</h3>
          <span class="ui-kicker text-[var(--color-action)]">{card.icon}</span>
        </div>
        <p class="text-sm leading-relaxed text-[var(--text-muted)]">{card.text}</p>
      </section>
    ))}
  </Stagger>
</section>
