---
import Reveal from "../animation/Reveal";
import type { AboutMetaItem } from "../../types/ui";

interface Props {
  titleLeading: string;
  titleName: string;
  subtitle: string;
  portrait: string;
  meta: AboutMetaItem[];
  availability: string;
}

const { titleLeading, titleName, subtitle, meta, availability } = Astro.props;
---

<Reveal client:visible>
  <section class="border-b border-[var(--border-soft)] pb-16">
    <div class="flex flex-col gap-8 max-w-4xl">
      <h1 class="text-5xl font-semibold leading-[1.04] text-[var(--text-main)] md:text-7xl lg:text-8xl">
        {titleLeading}
        <span class="block text-[var(--text-muted)]">{titleName}</span>
      </h1>
      <p class="max-w-3xl text-xl leading-relaxed text-[var(--text-muted)]">{subtitle}</p>

      <div class="max-w-3xl text-sm">
        <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
          {meta.map((item) => (
            <p class="flex flex-wrap items-baseline gap-x-2 gap-y-1 text-[var(--text-main)]">
              <span class="ui-kicker">{item.label}</span>
              <span>{item.value}</span>
            </p>
          ))}
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[var(--text-main)]">
            <span class="size-2 rounded-full bg-[#30d158]"></span>
            <span>{availability}</span>
          </div>
        </div>
      </div>
    </div>
  </section>
</Reveal>
