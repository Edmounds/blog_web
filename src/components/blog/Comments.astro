---
interface Props {
  postSlug: string;
}
const { postSlug } = Astro.props;
---

<section class="mt-16 border-t border-[var(--border)] pt-10">
  <h2 class="font-serif text-3xl text-[var(--text)]">评论区</h2>
  <p class="mt-2 text-sm text-[var(--muted)]">欢迎分享你的看法。</p>

  <div id="comments-list" class="mt-8 space-y-5 text-sm text-[var(--text)]">
    <p class="text-[var(--muted)]">正在加载评论...</p>
  </div>

  <form id="comment-form" class="panel mt-8 space-y-4 rounded-2xl p-6">
    <div>
      <label for="authorName" class="mb-2 block text-xs tracking-wide text-[var(--muted)]">昵称</label>
      <input
        id="authorName"
        name="authorName"
        class="w-full rounded-xl border border-[var(--border)] bg-transparent px-4 py-3 text-sm outline-none focus:border-[var(--accent)]"
        placeholder="请输入你的昵称"
        maxlength="40"
        required
      />
    </div>
    <div>
      <label for="content" class="mb-2 block text-xs tracking-wide text-[var(--muted)]">评论内容</label>
      <textarea
        id="content"
        name="content"
        rows="5"
        class="w-full rounded-xl border border-[var(--border)] bg-transparent px-4 py-3 text-sm outline-none focus:border-[var(--accent)]"
        placeholder="说点什么..."
        maxlength="1000"
        required
      ></textarea>
    </div>
    <div class="flex items-center justify-between">
      <p id="comment-status" class="text-xs text-[var(--muted)]"></p>
      <button class="rounded-full bg-[var(--accent)] px-5 py-2 text-sm text-white transition hover:opacity-90" type="submit">
        发布评论
      </button>
    </div>
  </form>
</section>

<script define:vars={{ postSlug }}>
  const list = document.getElementById("comments-list");
  const form = document.getElementById("comment-form");
  const statusText = document.getElementById("comment-status");

  const escape = (raw) =>
    raw
      .replaceAll("&", "&amp;")
      .replaceAll("<", "&lt;")
      .replaceAll(">", "&gt;")
      .replaceAll('"', "&quot;")
      .replaceAll("'", "&#039;");

  async function loadComments() {
    try {
      const res = await fetch(`/api/comments?postSlug=${encodeURIComponent(postSlug)}`);
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || "加载失败");

      if (!data.length) {
        list.innerHTML = `<p style="color:var(--muted)">还没有评论，来发布第一条吧。</p>`;
        return;
      }

      list.innerHTML = data
        .map(
          (item) => `
            <article class="panel rounded-2xl p-4">
              <div style="display:flex;justify-content:space-between;gap:12px;align-items:center">
                <strong>${escape(item.author_name)}</strong>
                <time style="color:var(--muted);font-size:12px">${new Date(item.created_at).toLocaleString("zh-CN")}</time>
              </div>
              <p style="margin-top:10px;line-height:1.7;color:var(--text)">${escape(item.content)}</p>
            </article>
          `
        )
        .join("");
    } catch (error) {
      list.innerHTML = `<p style="color:#d9534f">评论加载失败：${error.message}</p>`;
    }
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const formData = new FormData(form);
    const authorName = String(formData.get("authorName") || "").trim();
    const content = String(formData.get("content") || "").trim();

    if (!authorName || !content) {
      statusText.textContent = "请完整填写昵称和评论内容。";
      return;
    }

    statusText.textContent = "正在提交...";

    try {
      const res = await fetch("/api/comments", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ postSlug, authorName, content }),
      });
      const data = await res.json();
      if (!res.ok || !data.ok) throw new Error(data?.error || "提交失败");

      form.reset();
      statusText.textContent = "发布成功。";
      await loadComments();
    } catch (error) {
      statusText.textContent = `提交失败：${error.message}`;
    }
  });

  loadComments();
</script>
