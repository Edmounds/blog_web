---
import type { TimelineItemModel } from "../../types/ui";

interface Props {
  item: TimelineItemModel;
}

const { item } = Astro.props;
const isLeft = item.side === "left";
---

<article class:list={[
  "timeline-item relative mb-8 md:mb-9 md:w-1/2",
  isLeft ? "md:pr-7" : "md:ml-auto md:pl-7",
]}>
  <div class:list={[
    "hidden md:block absolute top-8 h-px w-7 bg-[var(--border-strong)]",
    isLeft ? "right-0" : "left-0",
  ]}></div>
  <div class:list={[
    "hidden md:block absolute top-[1.88rem] h-2.5 w-2.5 rounded-full border border-[var(--border-strong)] bg-[var(--bg-base)]",
    isLeft ? "-right-[5px]" : "-left-[5px]",
  ]}></div>

  <div class="group overflow-hidden rounded-xl border border-[var(--border-strong)] bg-[color:color-mix(in_srgb,var(--bg-elevated)_78%,transparent)] shadow-[var(--shadow-soft)]">
    <a href={item.href} class="block overflow-hidden border-b border-[var(--border-soft)]">
      <img src={item.image} alt={item.title} class="h-44 w-full object-cover grayscale transition duration-700 group-hover:scale-105 group-hover:grayscale-0 md:h-48" loading="lazy" />
    </a>

    <div class="space-y-3 p-4">
      <div class="flex items-center justify-between gap-3 text-xs text-[var(--text-faint)]">
        <span class="ui-kicker text-[var(--accent)]">{item.category}</span>
        <span class="font-mono">{item.year}</span>
      </div>
      <h3 class="font-serif text-2xl leading-tight text-[var(--text-main)] transition group-hover:text-[var(--accent)] md:text-[1.9rem]">
        <a href={item.href}>{item.title}</a>
      </h3>
      <p class="text-sm leading-relaxed text-[var(--text-muted)]">{item.summary}</p>
      <p class="pt-1 text-sm text-[var(--text-muted)] transition group-hover:text-[var(--text-main)]">{item.ctaLabel} -></p>
    </div>
  </div>
</article>
