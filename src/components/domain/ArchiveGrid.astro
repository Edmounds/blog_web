---
import type { ArchivePostSectionModel } from "../../types/ui";
import ContentCard from "./ContentCard.astro";

interface Props {
  sections: ArchivePostSectionModel[];
  countLabel?: string;
  hideYearHeader?: boolean;
}

const { sections, countLabel = "posts", hideYearHeader = false } = Astro.props;
---

<div data-archive-grid class={hideYearHeader ? "flex flex-col gap-10" : "flex flex-col gap-12"}>
  {hideYearHeader ? (
    <div class="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-2 xl:grid-cols-3">
      {sections.flatMap(section => section.cards.map((card, index) => {
        const post = section.posts[index];
        const keywords = [post.title, post.category, post.readingTime].join(" ").toLowerCase();

        return (
          <div data-archive-item data-archive-scope="grid" data-archive-keywords={keywords}>
            <ContentCard {...card} />
          </div>
        );
      }))}
    </div>
  ) : (
    sections.map((section) => (
      <section class="flex flex-col gap-5" data-archive-group>
        <header class="flex items-end justify-between border-b border-[var(--border-soft)] pb-3">
          <h2 class="ui-outline-title !text-[var(--type-lg)] !font-semibold">{section.year}</h2>
          <p class="text-xs text-[var(--text-faint)]">{section.cards.length} {countLabel}</p>
        </header>

        <div class="grid grid-cols-1 gap-x-8 gap-y-10 md:grid-cols-2 xl:grid-cols-3">
          {section.cards.map((card, index) => {
            const post = section.posts[index];
            const keywords = [post.title, post.category, post.readingTime].join(" ").toLowerCase();

            return (
              <div data-archive-item data-archive-scope="grid" data-archive-keywords={keywords}>
                <ContentCard {...card} />
              </div>
            );
          })}
        </div>
      </section>
    ))
  )}
</div>
