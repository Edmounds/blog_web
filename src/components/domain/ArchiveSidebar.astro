---
import type { ArchiveFilterModel } from "../../types/ui";
import SurfacePanel from "../foundation/SurfacePanel.astro";

interface Props {
  filters: ArchiveFilterModel[];
  title?: string;
}

const { filters, title = "Filter" } = Astro.props;
---

<SurfacePanel class="sticky top-28 space-y-5 p-5">
  <h2 class="font-serif text-2xl text-[var(--text-main)]">{title}</h2>
  <nav class="space-y-2 text-sm">
    {filters.map((filter) => (
      <a
        href={filter.href}
        class:list={[
          "flex items-center justify-between rounded-md px-2 py-1.5 transition",
          filter.active
            ? "bg-[var(--bg-subtle)] text-[var(--text-main)]"
            : "text-[var(--text-muted)] hover:bg-[var(--bg-subtle)] hover:text-[var(--text-main)]",
        ]}
        aria-current={filter.active ? "page" : undefined}
      >
        <span>{filter.label}</span>
        <span class="font-mono text-xs text-[var(--text-faint)]">{filter.count}</span>
      </a>
    ))}
  </nav>
</SurfacePanel>
