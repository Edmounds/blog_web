---
import type { ArchiveFilterModel } from "../../types/ui";

interface Props {
  filters: ArchiveFilterModel[];
  title?: string;
}

const { filters, title = "Filter" } = Astro.props;
---

<section class="sticky top-28">
  <h2 class="mb-5 font-serif text-2xl text-[var(--text-main)]">{title}</h2>
  <nav class="border-t border-[var(--border-soft)] text-sm">
    {filters.map((filter) => (
      <a
        href={filter.href}
        class:list={[
          "group flex items-center justify-between gap-3 border-b border-[var(--border-soft)] py-4 transition",
          filter.active
            ? "text-[var(--text-main)]"
            : "text-[var(--text-muted)] hover:text-[var(--text-main)]",
        ]}
        aria-current={filter.active ? "page" : undefined}
      >
        <span>{filter.label}</span>
        <span class="flex items-center gap-2">
          <span
            class:list={[
              "font-mono text-xs transition-colors",
              filter.active ? "text-[var(--text-main)]" : "text-[var(--text-faint)] group-hover:text-[var(--text-main)]",
            ]}
          >
            {filter.count}
          </span>
          <svg
            class:list={[
              "h-3.5 w-3.5 transition-colors",
              filter.active ? "text-[var(--text-main)]" : "text-[var(--text-faint)] group-hover:text-[var(--text-main)]",
            ]}
            viewBox="0 0 20 20"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M6 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>
    ))}
  </nav>
</section>
