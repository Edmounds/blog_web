---
import Reveal from "../animation/Reveal";
import type { ArchiveFilterModel } from "../../types/ui";
import { Badge } from "../ui/badge";

interface Props {
  filters: ArchiveFilterModel[];
  title?: string;
}

const { filters, title = "Filter" } = Astro.props;
---

<Reveal client:visible>
  <section class="sticky top-28">
    <h2 class="mb-5 text-2xl font-semibold text-[var(--text-main)]">{title}</h2>
    <nav class="border-t border-[var(--border-soft)] text-sm">
      {filters.map((filter) => (
        <a
          href={filter.href}
          class:list={[
            "group flex items-center justify-between gap-3 border-b border-[var(--border-soft)] py-4 transition",
            filter.active
              ? "text-[var(--color-action)]"
              : "text-[var(--text-muted)] hover:text-[var(--text-main)]",
          ]}
          aria-current={filter.active ? "page" : undefined}
        >
          <span>{filter.label}</span>
          <span class="flex items-center gap-2">
            <Badge
              variant="outline"
              className={[
                "!h-auto !border-[var(--border-strong)] !bg-transparent !px-2 !py-0.5 !font-mono !text-xs !font-normal transition-colors",
                filter.active ? "!border-[var(--color-action)] !text-[var(--color-action)]" : "!text-[var(--text-faint)] group-hover:!text-[var(--text-main)]",
              ].join(" ")}
            >
              {filter.count}
            </Badge>
            <svg
              class:list={[
                "h-3.5 w-3.5 transition-colors",
                filter.active ? "text-[var(--color-action)]" : "text-[var(--text-faint)] group-hover:text-[var(--text-main)]",
              ]}
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M6 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
        </a>
      ))}
    </nav>
  </section>
</Reveal>
