---
import { ArrowLeft } from "lucide-static";
import { localizePath, type Locale } from "../../lib/i18n";
import Icon from "../ui/Icon.astro";

interface Props {
  locale?: Locale;
}

const { locale = "zh-CN" } = Astro.props;
---

<a class="life-back" href={localizePath("/life/", locale)} data-primary-route>
  <Icon svg={ArrowLeft} />
  <span>Life</span>
</a>

<style>
  .life-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.48rem 0.7rem;
    color: var(--foreground-soft);
    font-size: var(--type-sm);
    text-decoration: none;
    background: color-mix(in srgb, var(--foreground) 3.5%, transparent);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-control);
    transition:
      color 180ms ease,
      transform 180ms ease,
      border-color 180ms ease;
  }
  .life-back:hover,
  .life-back:focus-visible {
    color: var(--foreground);
    border-color: var(--border-strong);
    transform: translateX(-0.12rem);
  }
  .life-back :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .life-back {
      transition: none;
    }
  }
</style>
