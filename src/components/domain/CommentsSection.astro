---
import { Image, Search, Smile } from "lucide-static";

import type { Locale } from "../../lib/i18n";
import Icon from "../ui/Icon.astro";

interface Props { contentId: string; locale?: Locale; labels?: Record<string, string>; }
const { contentId, locale = "zh-CN", labels = {} } = Astro.props;
const copy = { comments: "评论", commentName: "昵称", commentEmail: "邮箱", commentWebsite: "网址", commentContent: "欢迎评论", commentSubmit: "提交", commentSubmitting: "提交中", commentLoading: "正在加载评论", commentReload: "重新加载", commentEmpty: "还没有评论，来留下第一条吧。", commentLoadMore: "加载更多", commentLoadingMore: "加载中", commentNameInvalid: "昵称需为 1 至 20 个字符。", commentContentInvalid: "评论需为 1 至 500 个字符。", commentPublished: "评论已发布。", commentLoadFailed: "暂时无法加载评论，请稍后重试。", commentSubmitFailed: "评论发布失败，请稍后重试。", ...labels };
const descriptions: Record<Locale, string> = {
  "zh-CN": "欢迎在这里留下笔记、问题与后续讨论。",
  "zh-TW": "歡迎在這裡留下筆記、問題與後續討論。",
  en: "Notes, questions, and follow-ups are welcome here.",
  ja: "メモ、質問、続きの議論を歓迎します。",
};
const fieldLabels: Record<Locale, { name: string; email: string; website: string; content: string; submit: string; count: (value: number) => string }> = {
  "zh-CN": { name: "昵称", email: "邮箱", website: "网址", content: "欢迎评论", submit: "提交", count: (value) => `${value} 字` },
  "zh-TW": { name: "暱稱", email: "信箱", website: "網址", content: "歡迎評論", submit: "提交", count: (value) => `${value} 字` },
  en: { name: "Name", email: "Email", website: "Website", content: "Write a comment", submit: "Submit", count: (value) => `${value} chars` },
  ja: { name: "名前", email: "メール", website: "サイト", content: "コメントを書く", submit: "送信", count: (value) => `${value} 文字` },
};
const fields = fieldLabels[locale];
---

<section id="comments" class="comments-section" aria-labelledby="comments-title" data-comments data-content-id={contentId} data-copy={JSON.stringify(copy)}>
  <header class="comments-section__header">
    <h2 id="comments-title">{copy.comments}</h2>
    <p>{descriptions[locale]}</p>
  </header>
  <form class="comments-form" data-comment-form>
    <div class="comments-form__identity">
      <div class="comments-field comments-field--identity comments-field--name">
        <label for="comment-name">{fields.name}</label>
        <input id="comment-name" name="name" required maxlength="20" autocomplete="name" aria-label={fields.name} />
      </div>
      <div class="comments-field comments-field--identity">
        <label for="comment-email">{fields.email}</label>
        <input id="comment-email" name="email" type="email" autocomplete="email" aria-label={fields.email} />
      </div>
      <div class="comments-field comments-field--identity">
        <label for="comment-url">{fields.website}</label>
        <input id="comment-url" name="url" type="url" autocomplete="url" aria-label={fields.website} />
      </div>
    </div>
    <div class="comments-field comments-field--content">
      <label class="comments-sr-only" for="comment-content">{fields.content}</label>
      <textarea id="comment-content" name="content" required maxlength="500" rows="7" placeholder={fields.content}></textarea>
    </div>
    <div class="comments-honeypot" aria-hidden="true"><label for="comment-website">网站</label><input id="comment-website" name="website" tabindex="-1" autocomplete="off" /></div>
    <div class="comments-form__footer">
      <div class="comments-form__tools" aria-hidden="true">
        <span class="comments-form__markdown">M<span aria-hidden="true">↧</span></span>
        <span><Icon svg={Smile} /></span>
        <span><Icon svg={Image} /></span>
        <span><Icon svg={Search} /></span>
      </div>
      <div class="comments-form__actions">
        <span data-content-count>{fields.count(0)}</span>
        <button type="submit" data-submit data-label={fields.submit}><span>{fields.submit}</span></button>
      </div>
    </div>
    <p class="comments-status" role="status" aria-live="polite" data-submit-status></p>
  </form>
  <div class="comments-list" data-comment-list>
    <div class="comments-list__header"><strong data-comment-count>0 {copy.comments}</strong></div>
    <p class="comments-list__message" role="status" data-list-message>{copy.commentLoading}</p>
    <ol data-comment-items></ol>
    <button type="button" class="comments-secondary" data-retry hidden>{copy.commentReload}</button>
    <button type="button" class="comments-secondary comments-more" data-more hidden>{copy.commentLoadMore}</button>
  </div>
</section>

<script>
  interface CommentItem { id: string; name: string; content: string; createdAtLabel: string; device: string; region: string; }
  interface CommentPage { items: CommentItem[]; nextCursor: string | null; }
  const initComments = () => {
    document.querySelectorAll<HTMLElement>("[data-comments]:not([data-initialized])").forEach((root) => {
      root.dataset.initialized = "true";
      const copy = JSON.parse(root.dataset.copy ?? "{}") as Record<string, string>;
      const contentId = root.dataset.contentId ?? "";
      const form = root.querySelector<HTMLFormElement>("[data-comment-form]")!;
      const name = form.elements.namedItem("name") as HTMLInputElement;
      const content = form.elements.namedItem("content") as HTMLTextAreaElement;
      const website = form.elements.namedItem("website") as HTMLInputElement;
      const submit = root.querySelector<HTMLButtonElement>("[data-submit]")!;
      const submitLabel = submit.querySelector("span")!;
      const submitStatus = root.querySelector<HTMLElement>("[data-submit-status]")!;
      const listMessage = root.querySelector<HTMLElement>("[data-list-message]")!;
      const commentItems = root.querySelector<HTMLOListElement>("[data-comment-items]")!;
      const commentCount = root.querySelector<HTMLElement>("[data-comment-count]")!;
      const retry = root.querySelector<HTMLButtonElement>("[data-retry]")!;
      const more = root.querySelector<HTMLButtonElement>("[data-more]")!;
      const controller = new AbortController();
      let nextCursor: string | null = null;
      let loaded = false;
      let loading = false;
      const count = () => {
        const countOutput = root.querySelector<HTMLElement>("[data-content-count]")!;
        const current = countOutput.textContent ?? "";
        const suffix = current.replace(/^\d+/, "");
        countOutput.textContent = `${Array.from(content.value).length}${suffix}`;
      };
      name.addEventListener("input", count); content.addEventListener("input", count);
      const updateCount = () => { commentCount.textContent = `${commentItems.children.length}${nextCursor ? "+" : ""} ${copy.comments}`; };
      const makeItem = (item: CommentItem) => {
        const li = document.createElement("li");
        const avatar = document.createElement("span"); avatar.className = "comments-list__avatar"; avatar.textContent = Array.from(item.name.trim())[0] ?? "?"; avatar.setAttribute("aria-hidden", "true");
        const card = document.createElement("div"); card.className = "comments-list__card";
        const heading = document.createElement("h3"); heading.textContent = item.name;
        const body = document.createElement("p"); body.className = "comments-list__body"; body.textContent = item.content;
        const meta = document.createElement("p"); meta.className = "comments-list__meta"; meta.textContent = `${item.createdAtLabel} · ${item.device} · ${item.region}`;
        card.appendChild(heading); card.appendChild(body); card.appendChild(meta); li.appendChild(avatar); li.appendChild(card); return li;
      };
      const fetchPage = async (reset: boolean) => {
        if (loading) return; loading = true; retry.hidden = true; more.disabled = true; listMessage.textContent = reset ? copy.commentLoading : copy.commentLoadingMore;
        const query = new URLSearchParams({ contentId }); if (!reset && nextCursor) query.set("cursor", nextCursor);
        try {
          const response = await fetch(`/api/comments?${query}`, { signal: controller.signal });
          const data = await response.json() as CommentPage & { error?: { message?: string } }; if (!response.ok) throw new Error(data.error?.message ?? copy.commentLoadFailed);
          if (reset) commentItems.replaceChildren(); data.items.forEach((item) => commentItems.appendChild(makeItem(item))); nextCursor = data.nextCursor; loaded = true;
          listMessage.textContent = commentItems.children.length ? "" : copy.commentEmpty; more.hidden = !nextCursor; more.textContent = copy.commentLoadMore; updateCount();
        } catch (error) { if ((error as Error).name !== "AbortError") { listMessage.textContent = (error as Error).message || copy.commentLoadFailed; retry.hidden = false; } }
        finally { loading = false; more.disabled = false; }
      };
      retry.addEventListener("click", () => void fetchPage(!loaded)); more.addEventListener("click", () => void fetchPage(false));
      form.addEventListener("submit", async (event) => {
        event.preventDefault(); const cleanName = name.value.trim();
        if (!cleanName || Array.from(cleanName).length > 20) { submitStatus.textContent = copy.commentNameInvalid; return; }
        if (!content.value.trim() || Array.from(content.value).length > 500) { submitStatus.textContent = copy.commentContentInvalid; return; }
        submit.disabled = true; submitLabel.textContent = copy.commentSubmitting; submitStatus.textContent = "";
        try {
          const response = await fetch("/api/comments", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ contentId, name: name.value, content: content.value, website: website.value }), signal: controller.signal });
          const data = await response.json() as { item?: CommentItem; error?: { message?: string } }; if (!response.ok || !data.item) throw new Error(data.error?.message ?? copy.commentSubmitFailed);
          commentItems.insertBefore(makeItem(data.item), commentItems.firstChild); content.value = ""; count(); loaded = true; listMessage.textContent = ""; submitStatus.textContent = copy.commentPublished; updateCount();
        } catch (error) { if ((error as Error).name !== "AbortError") submitStatus.textContent = (error as Error).message || copy.commentSubmitFailed; }
        finally { submit.disabled = false; submitLabel.textContent = submit.dataset.label ?? copy.commentSubmit; }
      });
      const observer = new IntersectionObserver((entries) => { if (entries.some((entry) => entry.isIntersecting)) { observer.disconnect(); void fetchPage(true); } }, { rootMargin: "500px 0px" });
      observer.observe(root);
      document.addEventListener("astro:before-swap", () => { controller.abort(); observer.disconnect(); }, { once: true });
    });
  };
  document.addEventListener("astro:page-load", initComments);
  initComments();
</script>
