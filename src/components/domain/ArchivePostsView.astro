---
import Reveal from "../animation/Reveal";
import type { ArchivePostSectionModel, ArchiveViewCopy } from "../../types/ui";
import ArchiveGrid from "./ArchiveGrid.astro";
import ArchiveInteractionController from "./ArchiveInteractionController";
import ArchiveList from "./ArchiveList.astro";
import ArchiveToolbar from "./ArchiveToolbar.astro";
import ArchiveViewMotionController from "./ArchiveViewMotionController";

interface Props {
  sections: ArchivePostSectionModel[];
  copy?: Partial<ArchiveViewCopy>;
}

const defaultCopy: ArchiveViewCopy = {
  emptyLabel: "No posts found.",
  searchPlaceholder: "Search posts",
  countLabel: "posts",
  listTitleLabel: "Title",
  listCategoryLabel: "Category",
  listReadingLabel: "Reading",
  listDateLabel: "Date",
};

const { sections, copy: copyOverrides = {} } = Astro.props;
const copy = { ...defaultCopy, ...copyOverrides };
---

<Reveal client:visible>
  <section data-archive-root class="flex flex-col gap-8">
    <ArchiveToolbar searchPlaceholder={copy.searchPlaceholder} />

    <p data-archive-empty class="hidden border-t border-[var(--border-soft)] py-8 text-[var(--text-muted)]">
      {copy.emptyLabel}
    </p>

    <ArchiveGrid sections={sections} countLabel={copy.countLabel} />
    <ArchiveList sections={sections} copy={copy} />
    <ArchiveInteractionController client:load />
    <ArchiveViewMotionController client:load />
  </section>
</Reveal>
