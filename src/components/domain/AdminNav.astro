---
interface Props { current: "art" | "comments" | "games" }
const { current } = Astro.props;
const items = [
  { id: "art", label: "收藏管理", href: "/admin/art/" },
  { id: "games", label: "游戏管理", href: "/admin/games/" },
  { id: "comments", label: "评论管理", href: "/admin/comments/" },
] as const;
---

<nav class="mb-8 flex items-center gap-1 border-b border-[var(--border-soft)]" aria-label="后台导航">
  {items.map((item) => (
    <a
      href={item.href}
      aria-current={current === item.id ? "page" : undefined}
      class:list={[
        "border-b-2 px-3 py-3 text-sm font-medium transition",
        current === item.id
          ? "border-[var(--foreground)] text-[var(--foreground)]"
          : "border-transparent text-[var(--text-muted)] hover:text-[var(--foreground)]",
      ]}
    >
      {item.label}
    </a>
  ))}
</nav>
