---
import { Button } from "../ui/button";

interface Props {
  searchPlaceholder?: string;
}

const { searchPlaceholder = "Search posts" } = Astro.props;
const archiveViewButtonClass =
  "archive-view-button !h-auto !rounded-full !px-4 !py-2 !text-sm !text-[var(--text-muted)] hover:!bg-transparent hover:!text-[var(--text-main)]";
---

<div class="flex flex-col gap-4 rounded-lg bg-[var(--surface-parchment)] p-3 lg:flex-row lg:items-center lg:justify-between">
  <label class="relative block w-full max-w-xl">
    <svg
      class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-[var(--text-faint)]"
      viewBox="0 0 20 20"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <circle cx="8.5" cy="8.5" r="5.5" />
      <path d="M13 13l4 4" stroke-linecap="round" />
    </svg>
    <input
      data-archive-search
      class="archive-search h-11 w-full rounded-full border border-[var(--border-strong)] bg-[var(--surface-canvas)] pl-12 pr-4 text-base text-[var(--text-main)] outline-none transition focus:border-[var(--color-action)]"
      type="search"
      placeholder={searchPlaceholder}
      autocomplete="off"
    />
  </label>

  <div
    class="archive-view-switcher relative inline-flex self-start rounded-full bg-[var(--surface-canvas)] p-1"
    data-archive-view-switcher
  >
    <span class="archive-view-indicator" data-archive-view-indicator aria-hidden="true"></span>
    <Button
      type="button"
      variant="ghost"
      className={`${archiveViewButtonClass} is-active`}
      data-archive-view="grid"
      aria-pressed="true"
    >
      <svg class="h-4 w-4" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        <rect x="1.5" y="1.5" width="4.5" height="4.5" rx="1" />
        <rect x="10" y="1.5" width="4.5" height="4.5" rx="1" />
        <rect x="1.5" y="10" width="4.5" height="4.5" rx="1" />
        <rect x="10" y="10" width="4.5" height="4.5" rx="1" />
      </svg>
      <span>Grid</span>
    </Button>
    <Button type="button" variant="ghost" className={archiveViewButtonClass} data-archive-view="list" aria-pressed="false">
      <span>List</span>
    </Button>
  </div>
</div>

<style>
  .archive-search::-webkit-search-cancel-button {
    -webkit-appearance: none;
    appearance: none;
  }

  .archive-view-indicator {
    position: absolute;
    left: 0;
    top: 0.25rem;
    bottom: 0.25rem;
    width: 0;
    border-radius: 9999px;
    border: 1px solid color-mix(in srgb, var(--color-action) 20%, var(--border-strong));
    background: color-mix(in srgb, var(--color-action) 10%, var(--surface-canvas));
    opacity: 0;
  }

  .archive-view-button {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    border-radius: 9999px;
    border: 1px solid transparent;
    padding: 0.6rem 0.95rem;
    font-size: 1rem;
    color: var(--text-muted);
    transition: color 160ms ease, background-color 160ms ease, border-color 160ms ease;
  }

  .archive-view-button:hover {
    color: var(--text-main);
  }

  .archive-view-button.is-active {
    color: var(--color-action);
  }
</style>
