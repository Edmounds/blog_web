---
import type { ArticleMetaModel } from "../../types/ui";

interface Props {
  items: ArticleMetaModel[];
}

const { items } = Astro.props;
---

<div class="space-y-3 border-y border-[var(--border-strong)] py-5">
  {items.map((item) => (
    <div class="border-b border-[var(--border-subtle)] pb-3 last:border-none last:pb-0">
      <p class="ui-kicker">{item.label}</p>
      <p class="mt-1 text-sm text-[var(--text-main)]">{item.value}</p>
    </div>
  ))}
</div>
