---
import type { ArticleMetaModel } from "../../types/ui";
import Divider from "../foundation/Divider.astro";

interface Props {
  items: ArticleMetaModel[];
  variant?: "stacked" | "grid";
}

const { items, variant = "stacked" } = Astro.props;
---

{variant === "grid" ? (
  <div class="grid grid-cols-2 gap-x-4 gap-y-4 border-y border-[var(--border-soft)] py-4 sm:grid-cols-3">
    {items.map((item) => (
      <div class="min-w-0">
        <p class="ui-kicker">{item.label}</p>
        <p class="mt-1 break-words text-sm leading-snug text-[var(--text-main)]">{item.value}</p>
      </div>
    ))}
  </div>
) : (
  <div class="flex flex-col gap-3 border-y border-[var(--border-soft)] py-5">
    {items.map((item, index) => (
      <div class="pb-3 last:pb-0">
        <p class="ui-kicker">{item.label}</p>
        <p class="mt-1 text-sm text-[var(--text-main)]">{item.value}</p>
        {index < items.length - 1 && <Divider class="mt-3 !bg-[var(--border-soft)]" />}
      </div>
    ))}
  </div>
)}
