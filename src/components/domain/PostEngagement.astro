---
interface Props {
  contentId: string;
  locale?: string;
  labels?: Record<string, string>;
}
const { contentId, locale = "zh-CN", labels = {} } = Astro.props;
const copy = {
  engagementLabel: "内容互动",
  views: "浏览",
  likes: "喜欢",
  like: "点赞",
  liking: "点赞中",
  statsUnavailable: "内容统计暂时不可用。",
  ...labels,
};
---

<section
  class="post-engagement"
  aria-label={copy.engagementLabel}
  data-engagement
  data-content-id={contentId}
  data-locale={locale}
  data-like={copy.like}
  data-liking={copy.liking}
  data-unavailable={copy.statsUnavailable}
>
  <div class="post-engagement__stats" aria-live="polite">
    <span class="post-engagement__stat"
      ><svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
        ><path d="M2.1 12a10.6 10.6 0 0 1 19.8 0 10.6 10.6 0 0 1-19.8 0Z"
        ></path><circle cx="12" cy="12" r="3"></circle></svg
      ><strong data-views>0</strong><span>{copy.views}</span></span
    >
    <span class="post-engagement__stat"
      ><svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
        ><path
          d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"
        ></path></svg
      ><strong data-likes>0</strong><span>{copy.likes}</span></span
    >
  </div>
  <button
    type="button"
    class="post-engagement__like"
    data-like-button
    aria-label={copy.like}
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      aria-hidden="true"
      ><path
        d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"
      ></path></svg
    ><span data-like-label>{copy.like}</span>
  </button>
  <span class="sr-only" role="status" data-engagement-status></span>
</section>

<script>
  const initEngagement = () => {
    document
      .querySelectorAll<HTMLElement>(
        "[data-engagement]:not([data-initialized])",
      )
      .forEach((root) => {
        root.dataset.initialized = "true";
        const contentId = root.dataset.contentId ?? "";
        const formatter = new Intl.NumberFormat(root.dataset.locale ?? "zh-CN");
        const views = root.querySelector<HTMLElement>("[data-views]");
        const likes = root.querySelector<HTMLElement>("[data-likes]");
        const button =
          root.querySelector<HTMLButtonElement>("[data-like-button]");
        const label = root.querySelector<HTMLElement>("[data-like-label]");
        const status = root.querySelector<HTMLElement>(
          "[data-engagement-status]",
        );
        const controller = new AbortController();
        let current = { views: 0, likes: 0 };
        let liked = false;
        const render = () => {
          if (views) views.textContent = formatter.format(current.views);
          if (likes) likes.textContent = formatter.format(current.likes);
        };
        const request = async (url: string, init: RequestInit) => {
          const response = await fetch(url, {
            ...init,
            signal: controller.signal,
          });
          if (!response.ok) throw new Error(String(response.status));
          return response.json() as Promise<{ views: number; likes: number }>;
        };
        const recordView = async () => {
          try {
            current = await request("/api/view", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ contentId }),
            });
            render();
          } catch (error) {
            if ((error as Error).name !== "AbortError" && status)
              status.textContent = root.dataset.unavailable ?? "";
          }
        };
        const requestIdle = window.requestIdleCallback?.bind(window);
        const idleId = Number(
          requestIdle
            ? requestIdle(() => void recordView(), { timeout: 1000 })
            : setTimeout(() => void recordView(), 1000),
        );
        const bumpLikes = () => {
          if (!likes) return;
          likes.classList.remove("stat-bump");
          void likes.offsetWidth;
          likes.classList.add("stat-bump");
        };
        button?.addEventListener("click", async () => {
          if (liked || button.disabled) return;
          liked = true;
          button.disabled = true;
          current.likes += 1;
          render();
          button.classList.add("is-liked");
          bumpLikes();
          if (label) label.textContent = root.dataset.liking ?? "";
          try {
            current = await request("/api/like", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify({ contentId }),
            });
            render();
            if (label) label.textContent = root.dataset.like ?? "";
          } catch (error) {
            if ((error as Error).name !== "AbortError") {
              liked = false;
              current.likes = Math.max(0, current.likes - 1);
              render();
              button.disabled = false;
              button.classList.remove("is-liked");
              if (label) label.textContent = root.dataset.like ?? "";
              if (status) status.textContent = root.dataset.unavailable ?? "";
            }
          }
        });
        document.addEventListener(
          "astro:before-swap",
          () => {
            controller.abort();
            if (window.cancelIdleCallback) window.cancelIdleCallback(idleId);
            else clearTimeout(idleId);
          },
          { once: true },
        );
      });
  };
  document.addEventListener("astro:page-load", initEngagement);
  initEngagement();
</script>
