---
import type { ContentCardModel } from "../../types/ui";
import PillTag from "../foundation/PillTag.astro";
import { CardContent } from "../ui/card";

interface Props extends ContentCardModel {
  class?: string;
}

const {
  variant,
  title,
  href,
  image,
  imageAlt = title,
  eyebrow,
  meta = [],
  tags = [],
  class: className = "",
} = Astro.props;
---

<article class={`group flex h-full flex-col overflow-hidden rounded-lg bg-transparent transition duration-300 ${className}`.trim()}>
  <a href={href} class="relative block overflow-hidden rounded-lg bg-[var(--surface-parchment)]" tabindex="-1" aria-hidden="true">
    <img
      src={image}
      alt={imageAlt}
      class="aspect-[4/3] h-auto w-full object-cover transition duration-500 group-hover:scale-[1.025]"
      loading="lazy"
    />
  </a>

  <CardContent className="flex flex-1 flex-col gap-3 !px-0 !pb-0 !pt-4">
    {eyebrow && <p class="ui-kicker text-[var(--color-action)]">{eyebrow}</p>}

    {meta.length > 0 && (
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[var(--text-faint)]">
        {meta.map((item) => (
          <span>
            {item.label}: {item.value}
          </span>
        ))}
      </div>
    )}

    <h3 class:list={[
      "font-semibold text-[var(--text-main)] transition group-hover:text-[var(--color-action)]",
      variant === "blog" ? "text-[1.35rem] leading-tight" : "text-[1.55rem] leading-tight",
    ]}>
      <a href={href}>{title}</a>
    </h3>

    {tags.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-2 pt-2">
        {tags.map((tag) => (
          <PillTag text={tag} />
        ))}
      </div>
    )}
  </CardContent>
</article>
