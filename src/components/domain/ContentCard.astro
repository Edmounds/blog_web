---
import type { ContentCardModel } from "../../types/ui";

interface Props extends ContentCardModel {
  class?: string;
}

const {
  title,
  summary,
  href,
  image,
  imageAlt = title,
  eyebrow,
  meta = [],
  tags = [],
  class: className = "",
} = Astro.props;
---

<article class={`group flex h-full flex-col border-b border-[var(--border-soft)] pb-7 ${className}`.trim()}>
  <a href={href} class="block overflow-hidden rounded-[var(--radius-control)] border border-[var(--border-soft)] bg-[var(--surface-soft)]" tabindex="-1" aria-hidden="true">
    <img
      src={image}
      alt={imageAlt}
      width="512"
      height="512"
      class="aspect-[4/3] h-auto w-full object-cover transition-transform duration-300 group-hover:scale-[1.025]"
      loading="lazy"
      decoding="async"
    />
  </a>

  <div class="flex flex-1 flex-col gap-3 pt-4">
    <div class="flex flex-wrap items-center justify-between gap-2">
      {eyebrow && <p class="ui-kicker text-[var(--foreground-soft)]">{eyebrow}</p>}
      {meta.length > 0 && (
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs tabular-nums text-[var(--text-faint)]">
          {meta.map((item) => <span>{item.value}</span>)}
        </div>
      )}
    </div>

    <h3 class="text-[var(--type-lg)] font-semibold leading-tight text-[var(--text-main)]">
      <a class="text-inherit no-underline underline-offset-4 group-hover:underline" href={href}>{title}</a>
    </h3>

    <p class="line-clamp-3 text-sm leading-6 text-[var(--text-muted)]">{summary}</p>

    {tags.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-x-3 gap-y-1 pt-2 text-xs text-[var(--text-faint)]">
        {tags.map((tag) => <span>#{tag}</span>)}
      </div>
    )}
  </div>
</article>
