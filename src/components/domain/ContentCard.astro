---
import type { ContentCardModel } from "../../types/ui";
import PillTag from "../foundation/PillTag.astro";
import { CardContent } from "../ui/card";

interface Props extends ContentCardModel {
  class?: string;
}

const {
  variant,
  title,
  summary,
  href,
  image,
  imageAlt = title,
  eyebrow,
  meta = [],
  tags = [],
  footerText,
  class: className = "",
} = Astro.props;
---

<article class={`group flex h-full flex-col overflow-hidden rounded-xl border border-[var(--border-strong)] bg-[color:color-mix(in_srgb,var(--bg-elevated)_78%,transparent)] shadow-[var(--shadow-soft)] transition duration-300 hover:-translate-y-1 ${className}`.trim()}>
  <a href={href} class="relative block overflow-hidden border-b border-[var(--border-soft)]">
    <img
      src={image}
      alt={imageAlt}
      class="h-52 w-full object-cover grayscale transition duration-700 group-hover:scale-105 group-hover:grayscale-0"
      loading="lazy"
    />
  </a>

  <CardContent className="flex flex-1 flex-col gap-4 !p-5">
    {eyebrow && <p class="ui-kicker text-[var(--accent)]">{eyebrow}</p>}

    {meta.length > 0 && (
      <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-[var(--text-faint)]">
        {meta.map((item) => (
          <span>
            {item.label}: {item.value}
          </span>
        ))}
      </div>
    )}

    <h3 class:list={[
      "text-[var(--text-main)] transition group-hover:text-[var(--accent)]",
      variant === "blog" ? "font-serif text-2xl leading-tight" : "font-serif text-3xl leading-tight",
    ]}>
      <a href={href}>{title}</a>
    </h3>

    {summary && <p class="line-clamp-3 text-sm leading-relaxed text-[var(--text-muted)]">{summary}</p>}

    {tags.length > 0 && (
      <div class="mt-auto flex flex-wrap gap-2 pt-2">
        {tags.map((tag) => (
          <PillTag text={tag} />
        ))}
      </div>
    )}

    {footerText && (
      <div class="mt-auto border-t border-[var(--border-soft)] pt-4 text-sm text-[var(--text-muted)] transition group-hover:text-[var(--text-main)]">
        {footerText} ->
      </div>
    )}
  </CardContent>
</article>
