---
import { ArrowRight } from "lucide-static";

import Icon from "../ui/Icon.astro";

const friends = [
  {
    name: "Ethan",
    description: "Don't stay awake for too long.",
    href: "https://hanlife02.com",
    avatar: "https://hanlife02.com/avatar.svg",
  },
] as const;

const avatarUrl = (url: string) => `/api/friend-avatar?v=1&url=${encodeURIComponent(url)}`;
---

<div class="friend-links-grid" aria-label="Friend links">
  {
    friends.map((friend) => (
      <a
        class="friend-link"
        href={friend.href}
        target="_blank"
        rel="noreferrer"
      >
        <img
          class="friend-link__background"
          src={avatarUrl(friend.avatar)}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
        />
        <span class="friend-link__avatar" aria-hidden="true">
          <img
            src={avatarUrl(friend.avatar)}
            alt=""
            width="56"
            height="56"
            loading="lazy"
            decoding="async"
          />
          <span class="friend-link__arrow">
            <Icon svg={ArrowRight} />
          </span>
        </span>
        <span class="friend-link__copy">
          <strong>{friend.name}</strong>
          <span>{friend.description}</span>
        </span>
      </a>
    ))
  }
</div>

<style>
  .friend-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
    gap: 1rem;
    width: 100%;
    max-width: 59rem;
  }
  .friend-link {
    position: relative;
    isolation: isolate;
    display: flex;
    min-height: 4.45rem;
    min-width: 0;
    align-items: center;
    gap: 0.9rem;
    overflow: hidden;
    padding: 0.4rem 0.85rem;
    color: inherit;
    text-decoration: none;
    background: color-mix(in srgb, var(--canvas) 78%, transparent);
    border: 1px solid color-mix(in srgb, var(--foreground) 14%, transparent);
    border-radius: var(--radius-control);
    box-shadow: 0 1px 24px -1px
      color-mix(in srgb, var(--foreground) 10%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    backdrop-filter: blur(20px) saturate(1.2);
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }
  .friend-link:hover,
  .friend-link:focus-visible {
    background: color-mix(in srgb, var(--canvas) 68%, transparent);
    border-color: var(--border-strong);
    transform: translateY(-1px);
  }
  .friend-link__background {
    position: absolute;
    z-index: -1;
    top: 50%;
    left: -1.5rem;
    width: 10rem;
    aspect-ratio: 1;
    object-fit: cover;
    opacity: 0.22;
    filter: saturate(0.9);
    -webkit-mask-image: linear-gradient(90deg, #000 0%, #000 32%, transparent 82%);
    mask-image: linear-gradient(90deg, #000 0%, #000 32%, transparent 82%);
    transform: translateY(-50%);
  }
  .friend-link__avatar {
    position: relative;
    display: inline-flex;
    width: 3rem;
    height: 3rem;
    flex: 0 0 3rem;
    overflow: hidden;
    border-radius: 50%;
  }
  .friend-link__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .friend-link__arrow {
    position: absolute;
    inset: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    background: rgba(17, 17, 17, 0.66);
    opacity: 0;
    transition: opacity 180ms ease;
  }
  .friend-link__arrow :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
  .friend-link:hover .friend-link__arrow,
  .friend-link:focus-visible .friend-link__arrow {
    opacity: 1;
  }
  .friend-link__copy {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 0.15rem;
  }
  .friend-link__copy strong {
    overflow: hidden;
    color: var(--foreground);
    font-size: var(--type-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .friend-link__copy span {
    overflow: hidden;
    color: var(--text-muted);
    font-size: var(--type-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .friend-link,
    .friend-link__arrow {
      transition: none;
    }
  }
</style>
