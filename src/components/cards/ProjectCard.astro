---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
---

<article class="group panel fade-in overflow-hidden rounded-2xl">
  <img
    src={project.data.cover}
    alt={project.data.title}
    class="h-56 w-full object-cover grayscale transition duration-500 group-hover:scale-105 group-hover:grayscale-0"
    loading="lazy"
  />
  <div class="space-y-4 p-6">
    <div class="flex items-center gap-3 text-xs uppercase tracking-wide text-[var(--muted)]">
      <span>{project.data.category}</span>
      <span>·</span>
      <span>{project.data.year}</span>
    </div>
    <h3 class="font-serif text-3xl leading-tight text-[var(--text)] transition group-hover:text-[var(--accent)]">
      {project.data.title}
    </h3>
    <p class="text-sm leading-relaxed text-[var(--muted)]">{project.data.summary}</p>
  </div>
</article>
