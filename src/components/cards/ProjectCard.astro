---
import type { CollectionEntry } from "astro:content";
import ContentCard from "../domain/ContentCard.astro";

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
---

<ContentCard
  variant="project"
  title={project.data.title}
  summary={project.data.summary}
  href={project.data.href ?? "/projects/"}
  image={project.data.cover}
  imageAlt={project.data.title}
  eyebrow={project.data.category}
  meta={[{ label: "Year", value: String(project.data.year) }]}
  footerText="View project"
/>
