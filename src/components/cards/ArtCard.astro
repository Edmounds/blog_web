---
import type { ArtItem } from "../../lib/art";

export interface Props {
  item: ArtItem;
}

const { item } = Astro.props;
---

<article class="group flex flex-col gap-3 transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5">
  {item.type === "music" ? (
    <div class="relative aspect-square w-full overflow-hidden rounded-[var(--radius-control)] border border-[var(--border-soft)] bg-[var(--surface-soft)]">
      <img
        src={item.cover}
        alt=""
        aria-hidden="true"
        class="absolute inset-0 h-full w-full scale-110 object-cover blur-xl opacity-55"
        loading="lazy"
        data-art-cover-fallback={item.coverFallback ?? undefined}
        referrerpolicy={item.coverFallback ? "origin" : undefined}
      />
      <img
        src={item.cover}
        alt={item.title}
        class="relative h-full w-full object-contain"
        loading="lazy"
        data-art-cover-fallback={item.coverFallback ?? undefined}
        referrerpolicy={item.coverFallback ? "origin" : undefined}
      />
    </div>
  ) : (
    <div class="aspect-[2/3] w-full overflow-hidden rounded-[var(--radius-control)] border border-[var(--border-soft)] bg-[var(--surface-soft)]">
      <img
        src={item.cover}
        alt={item.title}
        class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.025]"
        loading="lazy"
        data-art-cover-fallback={item.coverFallback ?? undefined}
        referrerpolicy={item.coverFallback ? "origin" : undefined}
      />
    </div>
  )}
  <div class="flex flex-col gap-1">
    <h3 class="text-[var(--type-base)] font-semibold leading-tight text-[var(--foreground)]">{item.title}</h3>
    <p class="text-sm text-[var(--text-muted)]">{item.creator}</p>
    {item.extra && item.musicKind !== "single" && <p class="text-xs text-[var(--text-muted)]">{item.extra}</p>}
  </div>
</article>

<script>
  function bindArtCoverFallbacks() {
    document.querySelectorAll<HTMLImageElement>("[data-art-cover-fallback]").forEach((image) => {
      if (image.dataset.artCoverBound === "true") return;
      image.dataset.artCoverBound = "true";
      const useFallback = () => {
        const fallback = image.dataset.artCoverFallback;
        delete image.dataset.artCoverFallback;
        if (fallback) image.src = fallback;
      };
      image.addEventListener("error", useFallback, { once: true });
    });
  }

  bindArtCoverFallbacks();
  document.addEventListener("astro:page-load", bindArtCoverFallbacks);
</script>
