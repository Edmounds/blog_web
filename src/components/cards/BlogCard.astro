---
import type { CollectionEntry } from "astro:content";
import ContentCard from "../domain/ContentCard.astro";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const dateLabel = post.data.publishedAt.toLocaleDateString("en-US", {
  month: "short",
  day: "numeric",
  year: "numeric",
});
---

<ContentCard
  variant="blog"
  title={post.data.title}
  summary={post.data.summary}
  href={`/blog/${post.slug}/`}
  image={post.data.cover}
  imageAlt={post.data.title}
  eyebrow="Blog"
  meta={[{ label: "Published", value: dateLabel }, { label: "Read", value: post.data.readingTime }]}
  tags={post.data.tags}
  footerText="Read article"
/>
